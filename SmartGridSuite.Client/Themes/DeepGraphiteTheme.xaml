<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App + cards -->
    <SolidColorBrush x:Key="AppBackground" Color="#1A1E24"/>
    <SolidColorBrush x:Key="CardBackground" Color="#232831"/>
    <SolidColorBrush x:Key="CardBorder" Color="#3A424D"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBg" Color="#1E232B"/>
    <SolidColorBrush x:Key="DataGridHeaderBorder" Color="#3A424D"/>
    <SolidColorBrush x:Key="DataGridRowHoverBg" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBg" Color="#1E557798"/>

    <DropShadowEffect x:Key="CardShadow"
                  Color="#000000"
                  BlurRadius="16"
                  ShadowDepth="2"
                  Opacity="0.28"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBg" Color="#2A3038"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#47515D"/>

    <!-- Semantic control colors.
     These match the current Light theme values so Light does not visually change. -->

    <!-- Inputs: TextBox / ComboBox / DatePicker -->
    <SolidColorBrush x:Key="ControlInputBg" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="ControlInputText" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlInputCaret" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlInputBorder" Color="#D7DCE3"/>
    <SolidColorBrush x:Key="ControlInputHoverBg" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="ControlInputHoverBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ControlInputFocusBorder" Color="#2563EB"/>

    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="ControlSecondaryBg" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="ControlSecondaryText" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlSecondaryBorder" Color="#D7DCE3"/>
    <SolidColorBrush x:Key="ControlSecondaryHoverBg" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="ControlSecondaryHoverBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ControlSecondaryPressedBg" Color="#D8E1EE"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C8D0D9"/>
    <SolidColorBrush x:Key="WatermarkText" Color="#97A2AE"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBorderHover" Color="#6C7785"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#6288A8"/>

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBg" Color="#567A96"/>
    <SolidColorBrush x:Key="PrimaryBorder" Color="#425F77"/>
    <SolidColorBrush x:Key="PrimaryBgHover" Color="#6287A5"/>
    <SolidColorBrush x:Key="PrimaryBgPressed" Color="#486981"/>

    <!-- Tiles -->
    <SolidColorBrush x:Key="TileFill" Color="#2A3038"/>
    <SolidColorBrush x:Key="TileFillHover" Color="#333A44"/>
    <SolidColorBrush x:Key="TileFillPressed" Color="#252B33"/>

    <SolidColorBrush x:Key="TileHoverBg" Color="#333A44"/>
    <SolidColorBrush x:Key="TilePressedBg" Color="#252B33"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabBg" Color="#1E232B"/>
    <SolidColorBrush x:Key="TabBgSelected" Color="#2A3038"/>
    <SolidColorBrush x:Key="TabBgHover" Color="#333A44"/>

    <!-- Lists -->
    <SolidColorBrush x:Key="ListBg" Color="#232831"/>
    <SolidColorBrush x:Key="ListBorder" Color="#3A424D"/>
    <SolidColorBrush x:Key="ListHoverBg" Color="#2A3038"/>
    <SolidColorBrush x:Key="ListSelectedBg" Color="#333A44"/>
    <SolidColorBrush x:Key="ListItemSelectedBorder" Color="#67798A"/>
    <SolidColorBrush x:Key="ListItemHoverBg" Color="#2A3038"/>

    <SolidColorBrush x:Key="TabPillSelectedBg" Color="#2A3038"/>

    <!-- Inner tabs -->
    <SolidColorBrush x:Key="InnerTabBg" Color="#1E232B"/>
    <SolidColorBrush x:Key="InnerTabSelectedBg" Color="#2A3038"/>
    <SolidColorBrush x:Key="InnerTabHoverBg" Color="#333A44"/>

    <!-- Validation -->
    <SolidColorBrush x:Key="MissingRefBg" Color="#5A2D31"/>
    <SolidColorBrush x:Key="MissingRefBgHover" Color="#693539"/>
    <SolidColorBrush x:Key="MissingRefBorder" Color="#D97973"/>

    <SolidColorBrush x:Key="DangerText" Color="#F9D0CD"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#D97973"/>
    <SolidColorBrush x:Key="DangerBg" Color="#5A2D31"/>
    <SolidColorBrush x:Key="DangerBgHover" Color="#693539"/>

    <SolidColorBrush x:Key="ReturnText" Color="#F5F7FA"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#1EFFFFFF"/>
    <SolidColorBrush x:Key="BorderHover" Color="#6C7785"/>

    <!-- Fluent Ribbon -->
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonBackgroundBrush" Color="#1A1E24"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonBorderBrush" Color="#3A424D"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItemForegroundBrush" Color="#C8D0D9"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItemSelectedForegroundBrush" Color="#F5F7FA"/>

</ResourceDictionary>