<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App + cards -->
    <SolidColorBrush x:Key="AppBackground" Color="#2F343C"/>
    <SolidColorBrush x:Key="CardBackground" Color="#3A4048"/>
    <SolidColorBrush x:Key="CardBorder" Color="#515A66"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBg" Color="#353B43"/>
    <SolidColorBrush x:Key="DataGridHeaderBorder" Color="#515A66"/>
    <SolidColorBrush x:Key="DataGridRowHoverBg" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBg" Color="#224F7291"/>

    <DropShadowEffect x:Key="CardShadow"
                  Color="#000000"
                  BlurRadius="14"
                  ShadowDepth="2"
                  Opacity="0.16"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBg" Color="#434A53"/>
    <SolidColorBrush x:Key="SurfaceBorder" Color="#5F6975"/>

    <!-- Semantic control colors.
     These match the current Light theme values so Light does not visually change. -->

    <!-- Inputs: TextBox / ComboBox / DatePicker -->
    <SolidColorBrush x:Key="ControlInputBg" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="ControlInputText" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlInputCaret" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlInputBorder" Color="#D7DCE3"/>
    <SolidColorBrush x:Key="ControlInputHoverBg" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="ControlInputHoverBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ControlInputFocusBorder" Color="#2563EB"/>

    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="ControlSecondaryBg" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="ControlSecondaryText" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlSecondaryBorder" Color="#D7DCE3"/>
    <SolidColorBrush x:Key="ControlSecondaryHoverBg" Color="#E4EAF3"/>
    <SolidColorBrush x:Key="ControlSecondaryHoverBorder" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ControlSecondaryPressedBg" Color="#D8E1EE"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#D2D8DF"/>
    <SolidColorBrush x:Key="WatermarkText" Color="#A7B0BB"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBorderHover" Color="#7B8795"/>
    <SolidColorBrush x:Key="InputBorderFocus" Color="#6E93B3"/>

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBg" Color="#5F85A3"/>
    <SolidColorBrush x:Key="PrimaryBorder" Color="#476883"/>
    <SolidColorBrush x:Key="PrimaryBgHover" Color="#6B92B1"/>
    <SolidColorBrush x:Key="PrimaryBgPressed" Color="#4C6D89"/>

    <!-- Tiles -->
    <SolidColorBrush x:Key="TileFill" Color="#434A53"/>
    <SolidColorBrush x:Key="TileFillHover" Color="#4B535D"/>
    <SolidColorBrush x:Key="TileFillPressed" Color="#3D444C"/>

    <SolidColorBrush x:Key="TileHoverBg" Color="#4B535D"/>
    <SolidColorBrush x:Key="TilePressedBg" Color="#3D444C"/>

    <!-- Tabs -->
    <SolidColorBrush x:Key="TabBg" Color="#353B43"/>
    <SolidColorBrush x:Key="TabBgSelected" Color="#434A53"/>
    <SolidColorBrush x:Key="TabBgHover" Color="#4B535D"/>

    <!-- Lists -->
    <SolidColorBrush x:Key="ListBg" Color="#3A4048"/>
    <SolidColorBrush x:Key="ListBorder" Color="#515A66"/>
    <SolidColorBrush x:Key="ListHoverBg" Color="#434A53"/>
    <SolidColorBrush x:Key="ListSelectedBg" Color="#4B535D"/>
    <SolidColorBrush x:Key="ListItemSelectedBorder" Color="#708193"/>
    <SolidColorBrush x:Key="ListItemHoverBg" Color="#434A53"/>

    <SolidColorBrush x:Key="TabPillSelectedBg" Color="#434A53"/>

    <!-- Inner tabs -->
    <SolidColorBrush x:Key="InnerTabBg" Color="#353B43"/>
    <SolidColorBrush x:Key="InnerTabSelectedBg" Color="#434A53"/>
    <SolidColorBrush x:Key="InnerTabHoverBg" Color="#4B535D"/>

    <!-- Validation -->
    <SolidColorBrush x:Key="MissingRefBg" Color="#6A3638"/>
    <SolidColorBrush x:Key="MissingRefBgHover" Color="#7A4042"/>
    <SolidColorBrush x:Key="MissingRefBorder" Color="#E18884"/>

    <SolidColorBrush x:Key="DangerText" Color="#FFD3D0"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#E18884"/>
    <SolidColorBrush x:Key="DangerBg" Color="#6A3638"/>
    <SolidColorBrush x:Key="DangerBgHover" Color="#7A4042"/>

    <SolidColorBrush x:Key="ReturnText" Color="#F4F6F8"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="BorderHover" Color="#7B8795"/>

    <!-- Fluent Ribbon -->
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonBackgroundBrush" Color="#2F343C"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonBorderBrush" Color="#515A66"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItemForegroundBrush" Color="#D2D8DF"/>
    <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.RibbonTabItemSelectedForegroundBrush" Color="#F4F6F8"/>

</ResourceDictionary>