<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card border style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern TextBox -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value= "{x:Null}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBg}"/>


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                  Padding="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover: thicker + clearer -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>

                        <!-- Focus: thickest (wins over hover) -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern TextBox WITH watermark (uses Tag for watermark text) -->
    <Style x:Key="ModernWatermarkTextBox"
       TargetType="TextBox"
       BasedOn="{StaticResource ModernTextBox}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">

                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"/>

                        <!-- Watermark overlay -->
                        <TextBlock x:Name="Watermark"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{DynamicResource WatermarkText}"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"/>

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Padding="{TemplateBinding Padding}"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Show watermark when empty -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hide watermark when focused (even if empty) 
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                        </Trigger-->

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>

                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Margin="0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button (Save, etc.) -->
    <Style x:Key="PrimaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>

        <!-- IMPORTANT: We must override the template, because SecondaryButtonStyle's
         template uses Bd and hover triggers that change background/border.
         This keeps primary consistent and avoids the washed-out/opacity look. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Match PrimaryTile hover: background becomes PrimaryBorder -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"
                                Property="Background"
                                Value="{DynamicResource PrimaryBorder}"/>
                        </Trigger>

                        <!-- Match PrimaryTile pressed: darker blue -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd"
                                Property="Background"
                                Value="#1E40AF"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===========
     DATA GRID THEME (Fixes white rows in dark mode)
     =========== -->

    <Style x:Key="ThemedDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridHeaderBorder}"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ThemedDataGridCellStyle" TargetType="DataGridCell">
        <!-- IMPORTANT: let the row control the background -->
        <Setter Property="Background"
            Value="Transparent"/>

        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsTabStop" Value="False"/>

        <!-- Removes the default “cell focus rectangle / weird highlight” look -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      SnapsToDevicePixels="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control the DataGrid ROWS (border outline without triggering horizontal scroll) -->
    <Style x:Key="ThemedDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ClipToBounds" Value="True"/>

        <!-- IMPORTANT: remove BorderThickness setter entirely -->
        <!-- <Setter Property="BorderThickness" Value="1"/>  -->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                        <!-- Fill/background -->
                        <Border x:Name="RowFill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <DataGridCellsPresenter/>
                        </Border>

                        <!-- Outline overlay (does not affect row width measurement) -->
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TabBgHover}"/>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
            </Trigger>

            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThemedDataGridStyle" TargetType="DataGrid">
        <!-- This is the key: kill the default white row fill -->
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ThemedDataGridColumnHeaderStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ThemedDataGridCellStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ThemedDataGridRowStyle}"/>
    </Style>

    <!-- TAB LOOK: attached tabs with CONSISTENT spacing -->
    <Style x:Key="AttachedTabItemStyle" TargetType="TabItem">
        <!-- overlap amount (controls how tight they are) -->
        <Setter Property="Margin" Value="10,0,-10,0"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource TabBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Panel.ZIndex" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10,10,0,0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <ContentPresenter x:Name="HeaderPresenter"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- first tab: normal left margin -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Margin" Value="10,0,-10,0"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBgSelected}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5,1.5,1.5,0"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBg}"/>
                            <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition SourceName="Bd" Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Floating + (no tab chrome) -->
    <Style x:Key="PlusTabItemStyle" TargetType="TabItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="10,0,-10,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Panel.ZIndex" Value="2"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Btn"
                        Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Btn" Property="Background" Value="{DynamicResource TabBgHover}"/>
                            <Setter TargetName="Btn" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Btn" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                        </Trigger>

                        <!-- keep it from showing a "selected" state -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Btn" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Btn" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Btn" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern themed ListBox -->
    <Style x:Key="ThemedListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ListBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ListBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <!-- This is the part that fixes the "Windows default list" look -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                  Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox used INSIDE the Parts inner tabs:
     remove the TOP border to avoid the "double line" under the tab strip -->
    <Style x:Key="ThemedListBoxInTabsStyle"
       TargetType="ListBox"
       BasedOn="{StaticResource ThemedListBoxStyle}">
        <Setter Property="BorderThickness" Value="1,0,1,1"/>
    </Style>

    <!-- Form labels (left column) -->
    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Movement Radio Button Style -->
    <Style x:Key="MovementRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- Multiline TextBox watermark (uses Tag as watermark text) -->
    <Style x:Key="WatermarkTextBoxMultilineStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MaxLength" Value="600"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"/>

                        <!-- Watermark overlay -->
                        <TextBlock x:Name="Watermark"
                               Text="{TemplateBinding Tag}"
                               Foreground="{DynamicResource WatermarkText}"
                               Margin="{TemplateBinding Padding}"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="0"
                                  Padding="{TemplateBinding Padding}"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Show watermark when empty -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hide watermark when focused (even if empty) -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Hover: thicker, more noticeable border -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6B7280"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <!-- Focus: primary border -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBg}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Part list item -->
    <DataTemplate x:Key="PartItemTemplate">
        <Grid Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Row="1"
                   Text="{Binding Material}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,2,0,0"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>
        </Grid>
    </DataTemplate>

    <!-- Selected part display (DataGrid template column) -->
    <DataTemplate x:Key="SelectedPartDisplayTemplate">
        <Grid Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                   Text="{Binding Description}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Row="1"
                   Text="{Binding Material}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,2,0,0"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"/>
        </Grid>
    </DataTemplate>

    <!-- Surface Card container (embeded content) -->
    <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- ListBoxItem selection/hover that matches ListBg -->
    <Style x:Key="ThemedListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">

                        <!-- THIS LINE IS THE KEY -->
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"/>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBg}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListSelectedBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- All Parts/Favorites/Templates Tabs-->
    <Style x:Key="InnerTabStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Segmented pill bar -->
                        <Border Grid.Row="0"
                            Background="{DynamicResource PartsTabsBarBg}"
                            BorderBrush="{DynamicResource PartsTabsBarBorder}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="3"
                            Margin="0,0,0,10">
                            <TabPanel IsItemsHost="True"
                                  Background="Transparent"/>
                        </Border>

                        <ContentPresenter Grid.Row="1"
                                      ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Inner tabs items-->
    <Style x:Key="InnerTabItemStyle" TargetType="TabItem">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource InnerTabBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="999"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="HeaderPresenter"
                                      ContentSource="Header"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      TextElement.FontWeight="SemiBold"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabPillSelectedBg}"/>
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="Bold"/>
                        </Trigger>

                        <!-- Hover (only when NOT selected) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inner tabs: real "tab strip" look -->
    <Style x:Key="PartsInnerTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TAB STRIP -->
                        <Border Grid.Row="0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SurfaceBorder}" 
                            Margin="0,0,10,0"
                            Padding="6,0,10,0"
                            ClipToBounds="False"
                                SnapsToDevicePixels="True">
                            <TabPanel IsItemsHost="True"                                 
                                      HorizontalAlignment="Left"/>
                        </Border>

                        <!-- CONTENT AREA BORDER -->
                        <Border Grid.Row="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="10,0,0,10"                            
                            Padding="0">
                            <ContentPresenter ContentSource="SelectedContent"
                                          Margin="0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Inner TabItem: visible unselected + consistent spacing -->
    <Style x:Key="PartsInnerTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,-10,0"/>

        <!-- Make unselected tab actually visible -->
        <Setter Property="Background" Value="{DynamicResource InnerTabBg}"/>

        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10,10,0,0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="HeaderPresenter"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Hover (ONLY when not selected) -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </MultiTrigger>

                        <!-- Selected: attached to content, no bottom border -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5,1.5,1.5,0"/>

                            <!-- ONLY vertical overlap, keep horizontal spacing stable -->
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,0,-1"/>

                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>

                        <!-- Keyboard focus -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--Modern ComboBox (global)-->
    <!-- Items -->
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <!-- Make it narrower by default -->
        <Setter Property="Width" Value="160"/>
        <Setter Property="MinWidth" Value="140"/>

        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,0,44,0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!-- ✅ FIX #1: force default foreground inside template -->
                    <Grid SnapsToDevicePixels="True"
                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">

                        <!-- Outer -->
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"/>

                        <!-- Click-anywhere toggle -->
                        <ToggleButton x:Name="PART_DropDownToggle"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand">

                            <!-- Kill default ToggleButton visuals -->
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selected value (LEFT) -->
                                <Border Grid.Column="0"
                                        Background="Transparent"
                                        Padding="12,0,8,0">
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>


                                <!-- Arrow (RIGHT) -->
                                <Border x:Name="ArrowBd"
                                    Grid.Column="1"
                                    Margin="6,6,6,6"
                                    Background="{DynamicResource TileFill}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Path x:Name="Arrow"
                                      Data="M 0 0 L 6 6 L 12 0 Z"
                                      Fill="{DynamicResource TextSecondary}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ToggleButton>

                        <!-- Popup -->
                        <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       HorizontalOffset="0"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="6"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            TextElement.Foreground="{DynamicResource TextPrimary}">
                                <ScrollViewer VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Hover: thicker border + nicer arrow -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6B7280"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="ArrowBd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="ArrowBd" Property="BorderBrush" Value="#6B7280"/>
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>

                        <!-- Keyboard focus -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBg}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <!-- Open -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="6" CenterY="3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ArrowBd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="ArrowBd" Property="BorderBrush" Value="#6B7280"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.60"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Modern ComboBox End -->

    <!-- Issue/Return slider toggle (matches ThemeSliderToggleStyle structure) -->
    <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="108"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                        CornerRadius="16"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">

                        <!-- inner padding prevents clipping -->
                        <Grid Margin="3" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Labels -->
                            <TextBlock x:Name="ReturnLabel"
                                   Grid.Column="0"
                                   Text="Return"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ReturnText}"
                                   Opacity="1.5"/>

                            <TextBlock x:Name="IssueLabel"
                                   Grid.Column="1"
                                   Text="Issue"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Opacity="0.85"/>

                            <!-- Thumb spans both columns so it can snap left/right -->
                            <Border x:Name="Thumb"
                                Grid.ColumnSpan="2"
                                Panel.ZIndex="5"
                                Width="48"
                                CornerRadius="12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0"
                                SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Checked = Return -->
                        <Trigger Property="IsChecked" Value="True">
                            <!-- keep same “selected track” feel as your theme slider -->
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBg}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>

                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="ReturnLabel" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="IssueLabel" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource PrimaryBorder}"/>
                        </Trigger>

                        <!-- Unchecked = Issue -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource TileFill}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>

                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="IssueLabel" Property="Opacity" Value="0.85"/>
                            <Setter TargetName="ReturnLabel" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                        </Trigger>

                        <!-- Hover (don’t blow away checked border) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Make modern styles the defaults app-wide -->
    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

    <!--Backwards compatibility (FIX THIS LATER) -->
    <Style x:Key="WatermarkTextBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource ModernWatermarkTextBox}"/>

    <!-- Tile Button-->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Height" Value="78"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
