<Application x:Class="SmartGridSuite.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/ModuleLauncherWindow.xaml"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- REQUIRED for Fluent.Ribbon -->
                <ResourceDictionary Source="pack://application:,,,/Fluent;Component/Themes/Generic.xaml"/>

                <!-- Controls -->
                <ResourceDictionary Source="Controls/Controls.xaml"/>

                <!-- Initial theme; ThemeService replaces this -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>