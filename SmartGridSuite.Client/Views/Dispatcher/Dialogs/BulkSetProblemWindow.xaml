<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.BulkSetProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Problem"
        Width="480"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{StaticResource AppBackground}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="This will replace the Problem / Issue text on all selected tickets."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <TextBox Grid.Row="2"
                 x:Name="ProblemTextBox"
                 MinHeight="100"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="10"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="0,0,4,0"
                    IsCancel="True"/>

            <Button Content="Apply"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>