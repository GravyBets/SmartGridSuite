<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.SapQueueImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import SAP Queue"
        Width="1380"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / file selection -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Import SAP Queue"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Loads the raw SAP export, checks for duplicate notifications, and imports only ready rows."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBlock Text="Expected headers: Notification, Order, Notif.date, Description."
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">

                        <TextBlock Text="Last Import"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding LastImportDisplay}"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Right"/>

                        <Border Height="1"
                                Margin="0,10,0,10"
                                Background="{DynamicResource SurfaceBorder}"/>

                        <TextBlock Text="Importing As"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding CreatedByDisplay}"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedFilePath}"
                             IsReadOnly="True"
                             Tag="Select SAP export file..."
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="36"/>

                    <Button x:Name="BrowseBtn"
                            Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            MinWidth="110"
                            Content="Browse..."
                            Click="Browse_Click"/>

                    <Button x:Name="LoadPreviewBtn"
                            Grid.Column="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="36"
                            MinWidth="130"
                            Content="Load Preview"
                            Click="LoadPreview_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Preview Summary"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Only rows marked Ready will be imported. Rows with a parsed site import as Open. Rows missing a site import as Needs Review."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>

                <UniformGrid Grid.Row="2"
                             Columns="10"
                             Rows="1">

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Total"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalRows}"
                                        Margin="0,3,0,0"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Ready"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ReadyCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Exists"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding AlreadyExistsCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Invalid"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding InvalidCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="As Open"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding WillImportOpenCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Review"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding WillImportNeedsReviewCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Missing Site"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding MissingSiteCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="With WO"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding WithWorkOrderCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="No WO"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding WithoutWorkOrderCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="No Problem"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding MissingProblemCount}"
                                       Margin="0,3,0,0"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Preview grid -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Import Preview"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <DataGrid Grid.Row="2"
                          x:Name="PreviewGrid"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ItemsSource="{Binding PreviewRows}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Site"
                        Width="120"
                        Binding="{Binding ParsedSite}"/>

                        <DataGridTextColumn Header="Notification"
                        Width="140"
                        Binding="{Binding Notification}"/>

                        <DataGridTextColumn Header="Work Order"
                        Width="130"
                        Binding="{Binding WorkOrder}"/>

                        <DataGridTextColumn Header="Description"
                        Width="*"
                        Binding="{Binding Description}"/>

                        <DataGridTextColumn Header="Notif. Date"
                        Width="120"
                        Binding="{Binding NotificationDate, StringFormat={}{0:MM/dd/yyyy}}"/>

                        <DataGridTextColumn Header="Status"
                        Width="130"
                        Binding="{Binding ImportStatus}"/>

                        <DataGridTextColumn Header="Message"
                        Width="2*"
                        Binding="{Binding Message}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CloseBtn"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Close"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="Close_Click"/>

            <Button x:Name="ImportBtn"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Import Ready Rows"
                    MinWidth="170"
                    IsEnabled="False"
                    Click="ImportReady_Click"/>
        </StackPanel>
        <Border x:Name="BusyOverlay"
                Grid.RowSpan="7"
                Background="#66000000"
                CornerRadius="16"
                Visibility="Collapsed"
                Panel.ZIndex="100">

            <Border Width="260"
                    Padding="18"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="↻"
                       FontSize="34"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"
                       RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="BusyText"
                       Margin="0,10,0,0"
                       Text="Working..."
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,0"
                       Text="Please wait"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>