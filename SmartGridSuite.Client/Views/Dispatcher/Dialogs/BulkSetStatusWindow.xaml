<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.BulkSetStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Status"
        Width="460"
        Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{StaticResource AppBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="This will replace the Status on all selected tickets."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Status"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ComboBox Grid.Row="4"
                  x:Name="StatusComboBox"                 
                  Height="34"
                  Width="408"
                  IsTextSearchEnabled="True"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="0,0,4,0"
                    IsCancel="True"/>

            <Button Content="Apply"
                    Width="90"
                    Height="32"                    
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>