<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.NewTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Dialogs"
        Title="New Ticket"
        Width="1080" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- TOP: Site | Full Site Name | Problem -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Site -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Site * (If TOP, just XX-MWB, not sector too)" Margin="0,0,0,4"/>
                        <TextBox Height="34"
                                 Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Problem (wrap + auto-grow) -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Problem" Margin="0,0,0,4"/>
                        <TextBox MinHeight="34"
                                 MaxHeight="140"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 local:AutoGrowTextBox.IsEnabled="True"
                                 Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Assigned To + Status + Task Category + Action Override -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Assigned To:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <ComboBox x:Name="AssignedToBox"
                                  Grid.Column="2"
                                  HorizontalAlignment="Left"
                                  Width="260"
                                  Height="34"
                                  IsTextSearchEnabled="True"
                                  SelectedItem="{Binding AssignedTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="4"
                                   Text="Status:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <ComboBox x:Name="StatusBox"
                                  Grid.Column="6"
                                  Height="34"
                                  Width="260"
                                  SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Row 2 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Task Category:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <ComboBox x:Name="TaskCategoryComboBox"
                                  Grid.Column="2"
                                  Height="34"
                                  Width="260"/>

                        <TextBlock Grid.Column="4"
                                   Text="Action Required:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBox x:Name="ActionRequiredOverrideTextBox"
                                 Grid.Column="6"
                                 Height="34"
                                 MaxLength="200"/>
                    </Grid>
                </Grid>

                <Separator Margin="0,16,0,16"/>

                <!-- Work info row -->
                <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Notification #" Margin="0,0,0,4"/>
                            <TextBox Height="34"
                                     MinWidth="220"
                                     Text="{Binding NotificationNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Notification Name" Margin="0,0,0,4"/>
                            <TextBox Height="34"
                                     Text="{Binding NotificationName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Work Order" Margin="0,0,0,4"/>
                            <TextBox Height="34"
                                     MinWidth="220"
                                     Text="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Work Order Type" Margin="0,0,0,4"/>
                            <ComboBox x:Name="WorkOrderTypeBox"
                                      Height="34"
                                      SelectedItem="{Binding WorkOrderType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Work Order Code" Margin="0,0,0,4"/>
                            <ComboBox Height="34"
                                      ItemsSource="{Binding WorkOrderCodeOptions}"
                                      SelectedItem="{Binding WorkOrderCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Priority -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Priority" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    
                    <ComboBox x:Name="PriorityBox"
                              Grid.Column="1"
                              Height="34"
                              SelectedItem="{Binding PriorityDays, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Separator Margin="0,16,0,16"/>

                <!-- Dispatch Notes -->
                <TextBlock Text="Dispatch Notes"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Visible to the assigned field technician. Use this for remote troubleshooting notes, follow-up instructions, or things dispatch wants checked."
                           Margin="0,0,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <TextBox Height="110"
                         Padding="6,6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Left"
                         Text="{Binding DispatchNotes, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Notes / Write-Up -->
                <TextBlock Text="Notes / Write-Up"
                           Margin="0,14,0,6"/>

                <TextBox Height="180"
                         Padding="6,6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Left"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            
            <Button x:Name="CancelBtn" 
                    Content="Cancel" 
                    MinWidth="110" 
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            
            <Button x:Name="CreateBtn" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Content="Create Ticket" 
                    MinWidth="150"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>