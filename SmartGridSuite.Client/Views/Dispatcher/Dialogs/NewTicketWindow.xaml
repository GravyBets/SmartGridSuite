<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.NewTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Dialogs"
        Title="New Ticket"
        Width="1080"
        Height="772"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{StaticResource AppBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- TOP: Site | Problem -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Site -->
                    <StackPanel Grid.Column="0"
                                Margin="0,0,4,0">
                        <TextBlock Text="Site * (If TOP, just XX-MWB, not sector too)"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,4"/>

                        <TextBox x:Name="SiteTextBox"
                                 Height="34"
                                 MaxLength="100"
                                 Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Problem -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Problem"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="4,0,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ProblemTextBox"
                                 MinHeight="34"
                                 MaxHeight="140"
                                 MaxLength="5000"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Disabled"
                                 local:AutoGrowTextBox.IsEnabled="True"
                                 Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Assignment / Workflow -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Assigned To -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Assigned To"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="2,0,0,4"
                                   FontWeight="SemiBold"/>

                        <Grid>
                            <Button x:Name="AssignedTechDropDownButton"
                                    Height="34"
                                    HorizontalContentAlignment="Stretch"
                                    Click="AssignedTechDropDownButton_Click">

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="▾"
                                               Margin="10,0,0,0"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="AssignedTechDropDownTextBlock"
                                               Text="(Unassigned)"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>

                            <Popup x:Name="AssignedTechDropDownPopup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=AssignedTechDropDownButton}"
                                   VerticalOffset="4"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">

                                <Border Width="{Binding ActualWidth, ElementName=AssignedTechDropDownButton}"
                                        MinWidth="430"
                                        MaxHeight="520"
                                        Padding="10"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        Background="{DynamicResource CardBackground}"
                                        TextElement.Foreground="{DynamicResource TextPrimary}">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Unassigned -->
                                        <CheckBox x:Name="AssignedToUnassignedCheckBox"
                                                  Grid.Row="0"
                                                  Content="(Unassigned)"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextPrimary}"
                                                  Checked="AssignedToUnassignedCheckBox_Checked"
                                                  Unchecked="AssignedToUnassignedCheckBox_Unchecked"/>

                                        <!-- Header / bulk toggle -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="Technicians"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>

                                            <Button x:Name="SelectAllAssignedTechsButton"
                                                    Grid.Column="1"
                                                    Content="Select All"
                                                    Height="28"
                                                    MinWidth="86"
                                                    Padding="10,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ToggleAllAssignedTechs_Click"/>
                                        </Grid>

                                        <!-- Technician list -->
                                        <ScrollViewer Grid.Row="4"
                                                      MaxHeight="350"
                                                      VerticalScrollBarVisibility="Auto">

                                            <ItemsControl ItemsSource="{Binding AssignedTechOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}">

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected,
                                                                      Mode=TwoWay,
                                                                      UpdateSourceTrigger=PropertyChanged}"
                                                                  Foreground="{DynamicResource TextPrimary}"
                                                                  Margin="0,3"
                                                                  Checked="AssignedTechOption_Changed"
                                                                  Unchecked="AssignedTechOption_Changed"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Footer -->
                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="1"
                                                    Content="Cancel"
                                                    Width="86"
                                                    Height="30"
                                                    Padding="12,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="CancelAssignedTechSelection_Click"/>

                                            <Button Grid.Column="3"
                                                    Content="OK"
                                                    Width="86"
                                                    Height="30"
                                                    Padding="12,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="ConfirmAssignedTechSelection_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock x:Name="AssignedTechSummaryTextBlock"
                                   Margin="2,4,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status"
                                   Margin="2,0,0,4"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="StatusBox"
                                  Height="34"
                                  Width="Auto"
                                  HorizontalAlignment="Stretch"
                                  SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,6,0,4"
                           Background="{StaticResource PrimaryBg}"/>

                <!-- Work Information -->
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Notification -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                            <TextBlock Text="Notification #"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="NotificationNumberTextBox"
                                     Height="34"
                                     MinWidth="220"
                                     MaxLength="100"
                                     Text="{Binding NotificationNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Notification Name"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="NotificationNameTextBox"
                                     Height="34"
                                     MaxLength="100"
                                     Text="{Binding NotificationName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Work Order -->
                    <Grid Grid.Row="1"
                          Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,4,0">
                            <TextBlock Text="Work Order"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <StackPanel>
                                <TextBox x:Name="WorkOrderTextBox"
                                         Height="34"
                                         MinWidth="160"
                                         MaxLength="10"
                                         Text="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Work Order is limited to 10 characters."
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="2,3,0,0"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="0,0,4,0">
                            <TextBlock Text="Work Order Type"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <ComboBox x:Name="WorkOrderTypeBox"
                                      Width="Auto"
                                      Height="34"
                                      SelectedItem="{Binding WorkOrderType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="0,0,4,0">
                            <TextBlock Text="Work Order Code"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <ComboBox Height="34"
                                      ItemsSource="{Binding WorkOrderCodeOptions}"
                                      SelectedItem="{Binding WorkOrderCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Priority"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="4,0,0,4"
                                       FontWeight="SemiBold"/>

                            <ComboBox x:Name="PriorityBox"
                                      Height="34"
                                      SelectedItem="{Binding PriorityDays, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Separator Margin="0,4,0,8"
                           Background="{StaticResource PrimaryBg}"/>

                <!-- Dispatch Notes -->
                <TextBlock Text="Dispatch Notes"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="2,0,0,0"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Visible to the assigned field technician. Use this for remote troubleshooting notes, follow-up instructions, or things dispatch wants checked."
                           Margin="2,0,0,6"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="DispatchNotesTextBox"
                         MaxHeight="360"
                         MaxLength="10000"
                         Padding="6,6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Left"
                         Text="{Binding DispatchNotes, UpdateSourceTrigger=PropertyChanged}">

                    <TextBox.Style>
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource ModernTextBox}">
                            <!-- Edit Ticket with technician notes shown -->
                            <Setter Property="Height" Value="110"/>
                            <Setter Property="MinHeight" Value="110"/>

                            <Style.Triggers>
                                <!-- New Ticket, or Edit Ticket with no technician notes -->
                                <DataTrigger Binding="{Binding ElementName=TechnicianNotesPanel, Path=Visibility}"
                                             Value="Collapsed">
                                    <Setter Property="Height" Value="340"/>
                                    <Setter Property="MinHeight" Value="340"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Technician Notes / Submitted Write-Ups - Edit mode only -->
                <StackPanel x:Name="TechnicianNotesPanel"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">

                    <TextBlock Text="Technician Notes / Write-Ups"
                               Margin="2,0,0,2"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Submitted technician write-up. Dispatch may edit this text before closing the ticket. Editing this does NOT change Site History."
                               Margin="2,0,0,6"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>

                    <TextBox x:Name="TechnicianNotesTextBox"
                             Height="180"
                             MinHeight="180"
                             Padding="6,6"
                             MaxLength="10000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Left"
                             Text="{Binding Notes,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="1"
              Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Only appears when editing an existing ticket -->
            <Button x:Name="DeleteTicketButton"
                    Grid.Column="0"
                    Content="Delete Ticket"
                    MinWidth="120"
                    Height="34"
                    Visibility="Collapsed"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTip="Permanently delete this ticket"
                    Click="DeleteTicket_Click"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">

                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        MinWidth="110"
                        Margin="0,0,4,0"
                        Click="Cancel_Click"/>

                <Button x:Name="CreateBtn"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Create Ticket"
                        MinWidth="110"
                        IsEnabled="False"
                        Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

