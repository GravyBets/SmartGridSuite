<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.BulkSetWorkOrderTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set WO Type"
        Width="460"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="This will replace the Work Order Type on selected tickets that already have a Work Order."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Work Order Type"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ComboBox Grid.Row="4"
                  x:Name="WorkOrderTypeComboBox"
                  Height="34"
                  Width="Auto"
                  IsTextSearchEnabled="True"/>

        <TextBlock Grid.Row="6"
                   Text="Tickets without a Work Order will be skipped."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"/>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Apply"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>