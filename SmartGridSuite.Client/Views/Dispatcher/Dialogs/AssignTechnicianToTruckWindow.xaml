<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.AssignTechnicianToTruckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Technician"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTextBlock"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="Choose an available technician to assign to this truck."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="34"
                     Style="{StaticResource ModernWatermarkTextBox}"
                     Tag="Search name or employee ID..."
                     TextChanged="SearchBox_TextChanged"/>

            <CheckBox x:Name="OnDutyOnlyCheckBox"
                      Grid.Column="2"
                      Content="On duty only"
                      IsChecked="False"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextPrimary}"
                      Checked="Filter_Changed"
                      Unchecked="Filter_Changed"/>
        </Grid>

        <Border Grid.Row="4"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceBorder}"
                Background="{DynamicResource SurfaceBg}"
                Padding="8">
            <ListBox x:Name="TechniciansList"
                     Background="Transparent"
                     BorderThickness="0"
                     MouseDoubleClick="TechniciansList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                Background="{DynamicResource CardBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBlock Text="{Binding EmployeeId, StringFormat=ID: {0}}"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="999"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        Background="{DynamicResource SurfaceBg}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="On Duty"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                                                        <Setter Property="Text" Value="Off Shift"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Add to Truck"
                    Width="130"
                    Height="34"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Assign_Click"/>
        </StackPanel>
    </Grid>
</Window>