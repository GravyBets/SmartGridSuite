<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.TopChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOP Change" 
        Width="400" 
        Height="Auto"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" 
        Foreground="{DynamicResource TextPrimary}">
    
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CopyableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="Body" 
          Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Shared heading; both technician and Dispatch use this window. -->
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="TOP Change" 
                       FontSize="18" 
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SiteHeading" 
                       Margin="0,0,0,0"/>            
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource CardBackground}" 
                        CornerRadius="8" 
                        Padding="10" 
                        Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Current site information" 
                                   Style="{StaticResource SectionHeading}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="TOP" 
                                               Grid.Column="0"
                                               Grid.Row="0"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox Text="{Binding CurrentTop, Mode=OneWay}" 
                                             Grid.Row="2"
                                             Style="{StaticResource CopyableValue}"/>

                                    <TextBlock Text="Sector" 
                                               Grid.Column="1"
                                               Grid.Row="0"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox Text="{Binding CurrentSector, Mode=OneWay}" 
                                             Grid.Column="1"
                                             Grid.Row="2"
                                             Margin="0,0,0,4"
                                             Style="{StaticResource CopyableValue}"/>
                                </Grid>

                                <TextBlock Text="Current IP" 
                                           Style="{StaticResource FieldLabel}"/>
                                
                                <TextBox Text="{Binding CurrentIp, Mode=OneWay}" 
                                          Style="{StaticResource CopyableValue}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DataWarning}" 
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Technician: create a request. -->
                <StackPanel x:Name="NewRequestPanel" 
                            Visibility="Collapsed">                    
                    
                    <TextBlock Text="Request a new TOP / sector"
                               Style="{StaticResource SectionHeading}"/>
                    
                    <TextBlock Text="New TOP"                               
                               Style="{StaticResource FieldLabel}"/>

                    <ComboBox x:Name="TopCombo" 
                              MinHeight="34" 
                              HorizontalAlignment="Left"
                              SelectionChanged="TopCombo_SelectionChanged"/>
                    
                    <TextBlock Text="New sector" 
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SectorCombo" 
                              MinHeight="34" 
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Sector"/>
                    
                    <TextBlock Text="Field work status" 
                               Style="{StaticResource FieldLabel}"/>
                    
                    <ComboBox x:Name="TimingCombo" 
                              HorizontalAlignment="Left"
                              MinHeight="34">
                        <ComboBoxItem Content="Change planned — waiting for IP"/>
                        <ComboBoxItem Content="TOP/sector already changed — waiting for IP"/>
                    </ComboBox>
                    
                    <Button Content="Submit TOP Change" 
                            Click="Submit_Click"
                            Style="{DynamicResource PrimaryButtonStyle}" 
                            MinHeight="36" 
                            Margin="0,18,0,0"/>
                </StackPanel>
                
                <!-- Shared saved request; Dispatch-only controls are in DispatchPanel. -->
                <StackPanel x:Name="ExistingRequestPanel" 
                            Visibility="Collapsed">
                    
                    <TextBlock x:Name="RequestStateText" 
                               Style="{StaticResource SectionHeading}"/>
                    
                    <TextBox x:Name="RequestDetailsText" 
                             Style="{StaticResource CopyableValue}"/>
                    
                    <TextBlock Text="Assigned IP" 
                               Style="{StaticResource FieldLabel}"/>
                    
                    <TextBox x:Name="AssignedIpTextBox" MinHeight="34" Padding="8" IsReadOnly="True"/>
                    
                    <Button x:Name="CopyIpButton" 
                            Content="Copy IP" 
                            Click="CopyIp_Click"
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Left"
                            MinHeight="32" 
                            Margin="0,8,0,0" 
                            Visibility="Collapsed"/>
                    
                    <TextBlock Text="Submit your normal site write-up when the work is finished."
                               TextWrapping="Wrap" 
                               Margin="0,12,0,0"/>
                    
                    <!-- Dispatch: copy information into your existing email process, then record the IP. -->
                    <StackPanel x:Name="DispatchPanel" 
                                Visibility="Collapsed" 
                                Margin="0,18,0,0">
                        
                        <TextBlock Text="Dispatch" 
                                   Style="{StaticResource SectionHeading}"/>
                        
                        <TextBlock Text="Copy the request details for your usual IP-assignment email. When an IP is assigned, enter it above and save it for the technician."
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,12"/>
                        <TextBox x:Name="RequestSummaryTextBox" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="130" 
                                 MaxHeight="220" 
                                 Padding="10"/>
                        
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Copy Request Details" Click="CopyRequest_Click"
                                    Style="{DynamicResource SecondaryButtonStyle}" 
                                    MinHeight="36" 
                                    Margin="0,0,12,8"/>
                            <Button Content="Save Assigned IP" 
                                    Click="SaveIp_Click"
                                    Style="{DynamicResource PrimaryButtonStyle}" 
                                    MinHeight="36" 
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                        
                        <TextBlock Text="Saving makes the IP available in the app. No email is sent."
                                   TextWrapping="Wrap"/>                        
                    </StackPanel>
                </StackPanel>
                
                <TextBlock x:Name="NoRequestText" 
                           Text="There is no active TOP-change request on this ticket."
                           Visibility="Collapsed" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        
        <Grid Grid.Row="2" 
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="MessageText" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center" 
                       Margin="0,0,12,0"/>
            
            <Button Grid.Column="1" 
                    Content="Close" 
                    Click="Close_Click" 
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButtonStyle}" 
                    MinWidth="90" 
                    MinHeight="34"/>
        </Grid>
    </Grid>
</Window>
