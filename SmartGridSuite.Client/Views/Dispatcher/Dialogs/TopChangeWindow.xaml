<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.TopChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOP Change" 
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" 
        Foreground="{DynamicResource TextPrimary}">
    
    <!-- Dispatch sizing stays in XAML so it can be adjusted independently of the technician form. -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="700"/>
            <Setter Property="MinWidth" Value="400"/>
            <Setter Property="MinHeight" Value="480"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Dispatch">
                    <Setter Property="Width" Value="960"/>
                    <Setter Property="Height" Value="850"/>
                    <Setter Property="MinWidth" Value="740"/>
                    <Setter Property="MinHeight" Value="560"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CopyableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="Body" 
          Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Shared heading; both technician and Dispatch use this window. -->
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="TOP Change" 
                       FontSize="18" 
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SiteHeading" 
                       Margin="0,0,0,0"/>            
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="CurrentSiteCard" Background="{DynamicResource CardBackground}" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Current site information" 
                                   Style="{StaticResource SectionHeading}"/>
                        <StackPanel x:Name="CurrentSitePanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TOP" 
                                               Margin="2,0,0,4"
                                               Style="{StaticResource FieldLabel}"/>
                                    
                                    <ComboBox x:Name="CurrentTopCombo" 
                                              MinHeight="32"
                                              HorizontalAlignment="Stretch"
                                              Width="Auto"
                                              SelectionChanged="CurrentTopCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sector" 
                                               Margin="2,0,0,4"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CurrentSectorCombo" 
                                              MinHeight="32"
                                              HorizontalAlignment="Stretch"
                                              Width="Auto"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Current IP" 
                                       Style="{StaticResource FieldLabel}" 
                                       Margin="2,6,0,4"/>
                            <TextBox x:Name="CurrentIpTextBox" Style="{StaticResource ModernTextBox}" MaxLength="255"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DataWarning}" 
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Technician: create a request. -->
                <StackPanel x:Name="NewRequestPanel"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">                    
                    
                    <TextBlock Text="Request a new TOP / sector"
                               Style="{StaticResource SectionHeading}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="New TOP"
                                       Margin="2,0,0,4"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="TopCombo" 
                                      MinHeight="34" 
                                      HorizontalAlignment="Stretch"
                                      Width="Auto"
                                    SelectionChanged="TopCombo_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="New sector" 
                                       Margin="2,0,0,4"
                                       Style="{StaticResource FieldLabel}"/>
                            
                            <ComboBox x:Name="SectorCombo" 
                                      MinHeight="34" 
                                      HorizontalAlignment="Stretch"
                                      Width="Auto"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Field work status" 
                               Margin="2,6,0,4"
                               Style="{StaticResource FieldLabel}"/>
                    
                    <ComboBox x:Name="TimingCombo" 
                              HorizontalAlignment="Stretch"
                              Width="Auto"
                              MinHeight="34">
                        <ComboBoxItem Content="Change planned — waiting for IP"/>
                        <ComboBoxItem Content="TOP/sector already changed — waiting for IP"/>
                    </ComboBox>
                    

                </StackPanel>
                
                <!-- Shared saved request; Dispatch-only controls are in DispatchPanel. -->
                <StackPanel x:Name="ExistingRequestPanel" 
                            Visibility="Collapsed">
                    
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Requested TOP / sector" Style="{StaticResource SectionHeading}"/>
                            <TextBox x:Name="RequestedTopText" Style="{StaticResource CopyableValue}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RequestedBaseIpText" FontSize="18" Margin="0,8,0,0"/>
                            <TextBlock x:Name="RequestedBaseIpSourceText" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RequestStateText" 
                               Style="{StaticResource SectionHeading}"/>
                    
                    <TextBox x:Name="RequestDetailsText" 
                             Style="{StaticResource CopyableValue}"/>
                    
                    <TextBlock Text="Assigned IP" 
                               Style="{StaticResource FieldLabel}"/>
                    
                    <TextBox x:Name="AssignedIpTextBox" MinHeight="34" Padding="8" IsReadOnly="True"/>
                    
                    <Button x:Name="CopyIpButton" 
                            Content="Copy IP" 
                            Click="CopyIp_Click"
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Left"
                            MinHeight="32" 
                            Margin="0,8,0,0" 
                            Visibility="Collapsed"/>
                    
                    <TextBlock Text="Submit your normal site write-up when the work is finished."
                               TextWrapping="Wrap" 
                               Margin="0,12,0,0"/>
                    
                    <!-- Dispatch: copy information into your existing email process, then record the IP. -->
                    <StackPanel x:Name="DispatchPanel" 
                                Visibility="Collapsed" 
                                Margin="0,18,0,0">
                        
                        <TextBlock Text="Dispatch" 
                                   Style="{StaticResource SectionHeading}"/>
                        
                        <TextBlock Text="Copy the request details for your usual IP-assignment email. When an IP is assigned, enter it above and save it for the technician."
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,12"/>
                        <TextBox x:Name="RequestSummaryTextBox" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="230" 
                                 MaxHeight="320" 
                                 Padding="10"/>
                        
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Copy IP Request Text" Click="CopyRequest_Click"
                                    Style="{DynamicResource SecondaryButtonStyle}" 
                                    MinHeight="36" 
                                    Margin="0,0,12,8"/>
                            <Button Content="Save Assigned IP" 
                                    Click="SaveIp_Click"
                                    Style="{DynamicResource PrimaryButtonStyle}" 
                                    MinHeight="36" 
                                    Margin="0,0,0,8"/>
                        </WrapPanel>
                        
                        <TextBlock Text="Saving makes the IP available in the app. No email is sent."
                                   TextWrapping="Wrap"/>                        
                    </StackPanel>
                </StackPanel>
                
                <Expander x:Name="CurrentReferenceExpander" Header="Existing TOP / IP (reference)"
                          IsExpanded="False" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBox x:Name="CurrentReferenceText" Style="{StaticResource CopyableValue}" Margin="8"/>
                </Expander>

                <TextBlock x:Name="NoRequestText" 
                           Text="There is no active TOP-change request on this ticket."
                           Visibility="Collapsed" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        
        <Grid Grid.Row="2" 
              Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="MessageText" 
                       Grid.ColumnSpan="2"
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center" 
                       Margin="0,0,12,0"/>
            
            <StackPanel Grid.Row="1" 
                        Grid.ColumnSpan="2" 
                        HorizontalAlignment="Right" 
                        Orientation="Horizontal" 
                        Margin="0,8,0,0">
                
                <Button x:Name="CancelButton" 
                        Content="Cancel" 
                        Click="Close_Click" 
                        IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}" 
                        MinWidth="90" 
                        MinHeight="34"                         
                        Margin="0,0,4,0"/>

                <Button x:Name="SubmitButton" 
                        Content="Submit" 
                        Click="Submit_Click"
                        Visibility="Collapsed" 
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="90" 
                        MinHeight="34"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
