<Window x:Name="TopChangeDialog" x:Class="SmartGridSuite.Client.Views.Dispatcher.Dialogs.TopChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOP Change" 
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" 
        Foreground="{DynamicResource TextPrimary}">
    
    <!-- Dispatch sizing stays in XAML so it can be adjusted independently of the technician form. -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Width" Value="400"/>
            <Setter Property="Height" Value="700"/>
            <Setter Property="MinWidth" Value="400"/>
            <Setter Property="MinHeight" Value="480"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Dispatch">
                    <Setter Property="Width" Value="960"/>
                    <Setter Property="Height" Value="850"/>
                    <Setter Property="MinWidth" Value="740"/>
                    <Setter Property="MinHeight" Value="560"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CopyableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!--
            TOP picker only.
            Keep the selected value non-editable so it always renders correctly,
            but put a real search box inside the dropdown to filter TOPs live.
        -->
        <Style x:Key="TopSearchComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlInputText}"/>
            <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlInputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,0,44,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True"
                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">

                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>

                            <ToggleButton x:Name="PART_DropDownToggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="Transparent"
                                            Padding="12,0,8,0">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          RecognizesAccessKey="True"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>

                                    <Border x:Name="ArrowBd"
                                            Grid.Column="1"
                                            Margin="6"
                                            Background="{DynamicResource TileFill}"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Path x:Name="Arrow"
                                              Data="M 0 0 L 6 6 L 12 0 Z"
                                              Fill="{DynamicResource TextSecondary}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalOffset="0"
                                   VerticalOffset="6"
                                   AllowsTransparency="True"
                                   Focusable="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextElement.Foreground="{DynamicResource TextPrimary}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBox x:Name="TopSearchBox"
                                                 Grid.Row="0"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="34"
                                                 MinWidth="220"
                                                 Tag="Search TOP..."
                                                 TextChanged="TopSearchBox_TextChanged"/>

                                        <ScrollViewer Grid.Row="2"
                                                      MaxHeight="320"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlInputHoverBorder}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="ArrowBd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                                <Setter TargetName="ArrowBd" Property="BorderBrush" Value="{DynamicResource ControlInputHoverBorder}"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlInputFocusBorder}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="6" CenterY="3"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ArrowBd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                                <Setter TargetName="ArrowBd" Property="BorderBrush" Value="#6B7280"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="Body" 
          Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Shared heading; both technician and Dispatch use this window. -->
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="TOP Change" 
                       FontSize="20" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="SiteHeading" 
                       Margin="0,0,0,0"
                       FontWeight="SemiBold"
                       FontSize="14"/>            
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="CurrentSiteCard" Background="{DynamicResource CardBackground}" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Current site information" 
                                   Style="{StaticResource SectionHeading}"/>
                        <StackPanel x:Name="CurrentSitePanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TOP" 
                                               Margin="2,0,0,4"
                                               Style="{StaticResource FieldLabel}"/>
                                    
                                    <ComboBox x:Name="CurrentTopCombo" 
                                              MinHeight="32"
                                              HorizontalAlignment="Stretch"
                                              Width="Auto"
                                              SelectionChanged="CurrentTopCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sector" 
                                               Margin="2,0,0,4"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CurrentSectorCombo" 
                                              MinHeight="32"
                                              HorizontalAlignment="Stretch"
                                              Width="Auto"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Current IP" 
                                       Style="{StaticResource FieldLabel}" 
                                       Margin="2,6,0,4"/>
                            <TextBox x:Name="CurrentIpTextBox" Style="{StaticResource ModernTextBox}" MaxLength="255"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DataWarning}" 
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Technician: create a request. -->
                <StackPanel x:Name="NewRequestPanel"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">                    
                    
                    <TextBlock Text="Request a new TOP / sector"
                               Style="{StaticResource SectionHeading}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="New TOP"
                                       Margin="2,0,0,4"
                                       Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="TopCombo"
                                      MinHeight="34"
                                      HorizontalAlignment="Stretch"
                                      Width="Auto"
                                      Style="{StaticResource TopSearchComboBoxStyle}"
                                      IsEditable="False"
                                      IsTextSearchEnabled="False"
                                      SelectionChanged="TopCombo_SelectionChanged"
                                      DropDownOpened="TopCombo_DropDownOpened"
                                      DropDownClosed="TopCombo_DropDownClosed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="New sector" 
                                       Margin="2,0,0,4"
                                       Style="{StaticResource FieldLabel}"/>
                            
                            <ComboBox x:Name="SectorCombo" 
                                      MinHeight="34" 
                                      HorizontalAlignment="Stretch"
                                      Width="Auto"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>
                    </Grid>


                </StackPanel>
                
                <!-- Shared saved request; Dispatch-only controls are in DispatchPanel. -->
                <StackPanel x:Name="ExistingRequestPanel" 
                            Visibility="Collapsed">
                    
                    <!-- Dispatch comparison: existing on the left, requested on the right. -->
                    <Border Background="{DynamicResource CardBackground}" 
                            CornerRadius="8" 
                            Padding="14" 
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition>
                                    <ColumnDefinition.Style>
                                        <Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" 
                                                    Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, ElementName=TopChangeDialog}" 
                                                             Value="Dispatch">
                                                    <Setter Property="Width" 
                                                            Value="*"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            
                                        </Style>
                                    </ColumnDefinition.Style>
                                </ColumnDefinition>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel x:Name="ExistingTopPanel" 
                                        Visibility="Collapsed" 
                                        Margin="0,0,10,0">
                                
                                <TextBlock Text="Existing TOP" 
                                           Style="{StaticResource SectionHeading}"/>
                                
                                <TextBox x:Name="CurrentReferenceText" 
                                         Style="{StaticResource CopyableValue}" 
                                         FontSize="14"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Requested TOP" 
                                           Style="{StaticResource SectionHeading}"/>
                                
                                <TextBox x:Name="RequestedTopText" 
                                         Style="{StaticResource CopyableValue}" 
                                         FontSize="14"/>
                                
                                <TextBlock x:Name="RequestedBaseIpText" 
                                           FontSize="14" 
                                           Margin="0,0,0,0"/>

                                <TextBlock x:Name="RequestedBaseIpSourceText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Copyable email text sits directly below the comparison card. -->
                    <StackPanel x:Name="DispatchPanel" 
                                Visibility="Collapsed" 
                                Margin="0,0,0,8">
                        
                        <TextBlock Text="IP request message" 
                                   Style="{StaticResource SectionHeading}"/>
                        
                        <Grid>
                            <TextBox x:Name="RequestSummaryTextBox" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="230" 
                                     MaxHeight="300" 
                                     Padding="10,0,48,0"/>
                            
                            <Button x:Name="CopyRequestButton" 
                                    Style="{StaticResource MiniIconButton}"
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top" 
                                    Margin="0,4,18,0"
                                    ToolTip="Copy IP request text" 
                                    AutomationProperties.Name="Copy IP request text"
                                    Click="CopyRequest_Click">
                                
                                <TextBlock x:Name="RequestCopyGlyph" 
                                           Style="{StaticResource CopyGlyph}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Assigned IP" 
                               Style="{StaticResource FieldLabel}" 
                               Margin="0,0,0,4"/>
                    
                    <TextBox x:Name="AssignedIpTextBox" 
                             Style="{StaticResource ModernTextBox}" 
                             IsReadOnly="True"/>
                    
                    <Button x:Name="CopyIpButton" 
                            Content="Copy IP" 
                            Click="CopyIp_Click"
                            Style="{DynamicResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Left"
                            MinHeight="32" 
                            Margin="0,8,0,0" 
                            Visibility="Collapsed"/>
                    
                    <TextBlock x:Name="RequestStateText" 
                               Style="{StaticResource SectionHeading}" 
                               Margin="0,16,0,6"/>
                    
                    <TextBox x:Name="RequestDetailsText" 
                             Style="{StaticResource CopyableValue}"/>
                    
                    <TextBlock Text="Submit your normal site write-up when the work is finished."
                               TextWrapping="Wrap" 
                               Margin="0,12,0,0"/>
                </StackPanel>

                <TextBlock x:Name="NoRequestText" 
                           Text="There is no active TOP-change request on this ticket."
                           Visibility="Collapsed" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        
        <Grid Grid.Row="2" 
              Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="MessageText" 
                       Grid.ColumnSpan="2"
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center" 
                       Margin="0,0,12,0"/>
            
            <StackPanel Grid.Row="1" 
                        Grid.ColumnSpan="2" 
                        HorizontalAlignment="Right" 
                        Orientation="Horizontal" 
                        Margin="0,8,0,0">
                
                <Button x:Name="SaveAssignedIpButton" 
                        Content="Save Assigned IP" 
                        Click="SaveIp_Click"
                        Visibility="Collapsed" 
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="150" 
                        MinHeight="34" 
                        Margin="0,0,8,0"/>
                
                <Button x:Name="CancelButton" 
                        Content="Cancel" 
                        Click="Close_Click" 
                        IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}" 
                        MinWidth="90" 
                        MinHeight="34"                         
                        Margin="0,0,4,0"/>

                <Button x:Name="SubmitButton" 
                        Content="Submit" 
                        Click="Submit_Click"
                        Visibility="Collapsed" 
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="90" 
                        MinHeight="34"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
