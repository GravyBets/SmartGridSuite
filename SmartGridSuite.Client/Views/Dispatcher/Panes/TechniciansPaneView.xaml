<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TechniciansPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Panes"
             mc:Ignorable="d">

    <UserControl.Resources>

        <local:LeadStarBrushConverter x:Key="LeadStarBrushConverter"/>
        <local:TruckBoardRowHeightConverter x:Key="TruckBoardRowHeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Tech assigned to a truck card -->
        <DataTemplate x:Key="AssignedTechnicianTemplate">
            <Border Style="{StaticResource TechCardStyle}"
                    Padding="8"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: compact tech info -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Title}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ScheduleText}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right: lead + remove side-by-side -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <Button Tag="{Binding}"
                                ToolTip="Set as manual lead"
                                Click="SetLeadTechnician_Click">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource TransparentIconButtonStyle}">
                                    <Setter Property="Opacity" Value="1"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Technicians.Count,
                                                                       RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding DataContext.Technicians.Count,
                                                                       RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Viewbox Width="16"
                                     Height="16"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                <Path Stretch="Uniform"
                                      Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z">
                                    <Path.Fill>
                                        <MultiBinding Converter="{StaticResource LeadStarBrushConverter}">
                                            <Binding Path="Id"/>
                                            <Binding Path="DataContext.LeadTechnicianId"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </Path.Fill>
                                </Path>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource TransparentIconButtonStyle}"
                                Margin="4,0,0,0"
                                Tag="{Binding}"
                                ToolTip="Remove from truck"
                                Click="RemoveTechFromTruck_Click">
                            <Viewbox Width="16"
                                     Height="16"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                <Path Fill="{DynamicResource TextSecondary}"
                                      Stretch="Uniform"
                                      Data="M7 4V2.75C7 1.78 7.78 1 8.75 1H15.25C16.22 1 17 1.78 17 2.75V4H21V6H19.85L18.94 20.1C18.84 21.73 17.49 23 15.86 23H8.14C6.51 23 5.16 21.73 5.06 20.1L4.15 6H3V4H7ZM9 4H15V3H9V4ZM6.15 6L7.05 19.97C7.09 20.55 7.57 21 8.14 21H15.86C16.43 21 16.91 20.55 16.95 19.97L17.85 6H6.15ZM9 8H11V19H9V8ZM13 8H15V19H13V8Z"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Left drawer technician card -->
        <DataTemplate x:Key="TechnicianDrawerTemplate">
            <Border Style="{StaticResource TechCardStyle}"
                    Padding="8"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected,
                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                  Mode=TwoWay}"/>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Title}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ScheduleText}"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="3"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{Binding TruckNumber, StringFormat=Truck {0}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TruckNumber}" Value="">
                                        <Setter Property="Text" Value="Unassigned"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TruckNumber}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Unassigned"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Summary -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Daily Truck Board"
                                   Style="{StaticResource PaneTitleTextStyle}"/>

                        <TextBlock Text="{Binding BoardSubtitle}"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right">

                        <TextBlock Text="{Binding DraftStatusText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Button Width="34"
                                Height="32"
                                Margin="0,0,4,0"
                                Padding="0"
                                ToolTip="Previous day"
                                IsEnabled="{Binding CanEditBoard}"
                                Click="PreviousDay_Click">

                            <Viewbox Width="10"
                                     Height="12">
                                <Path Data="M 8,1 L 3,6 L 8,11"
                                      Stroke="{DynamicResource TextPrimary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>

                        <Border Width="86"
                                Height="32"
                                Margin="0,0,4,0"
                                CornerRadius="10"
                                Background="{DynamicResource ControlInputBg}"
                                BorderBrush="{DynamicResource ControlInputBorder}"
                                BorderThickness="1.5">

                            <TextBlock Text="{Binding SelectedWorkDate,
                                              StringFormat={}{0:dddd}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ControlInputText}"/>
                        </Border>

                        <DatePicker x:Name="WorkDatePicker"
                                    Style="{DynamicResource ModernDatePicker}"
                                    Width="175"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    VerticalContentAlignment="Center"
                                    ToolTip="Truck board date"
                                    IsEnabled="{Binding CanEditBoard}"
                                    Text="{Binding SelectedWorkDate,
                                           Mode=OneWay,
                                           StringFormat={}{0:ddd M/d/yyyy}}"
                                    SelectedDate="{Binding SelectedWorkDate,
                                                           Mode=OneWay}"
                                    SelectedDateChanged="WorkDatePicker_SelectedDateChanged"/>

                        <Button Width="34"
                                Height="32"
                                Margin="0,0,22,0"
                                Padding="0"
                                ToolTip="Next day"
                                IsEnabled="{Binding CanEditBoard}"
                                Click="NextDay_Click">

                            <Viewbox Width="10"
                                     Height="12">
                                <Path Data="M 3,1 L 8,6 L 3,11"
                                      Stroke="{DynamicResource TextPrimary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="RefreshBoardButton"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Content="Refresh"
                                Height="32"
                                MinWidth="90"
                                IsEnabled="{Binding CanEditBoard}"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="2"
                             Rows="1"
                             Columns="4">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OnDutyCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="On Duty"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AssignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Assigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding UnassignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Unassigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding TrucksUsedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Trucks Used"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Technician drawer -->
            <Border x:Name="TechnicianDrawerCard"
                    Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Technicians"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Defaults to unassigned technicians."
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VisibleTechnicianCount, StringFormat={}{0} shown}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TechnicianSearchBox"
                                 Grid.Row="0"
                                 Height="32"
                                 Style="{StaticResource ClearableSearchTextBox}"
                                 Tag="Search name, title, truck, schedule..."
                                 TextChanged="TechnicianSearchBox_TextChanged"/>

                        <StackPanel Grid.Row="2">
                            <CheckBox x:Name="ShowAllTechniciansCheckBox"
                                      Content="Show assigned techs too"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Checked="ShowAllTechnicians_Changed"
                                      Unchecked="ShowAllTechnicians_Changed"/>

                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SelectedDrawerTechnicianCount, StringFormat={}{0} selected}"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="TechniciansList"
                             Grid.Row="4"
                             ItemsSource="{Binding Board.AllTechnicians}"
                             ItemTemplate="{StaticResource TechnicianDrawerTemplate}"
                             ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                             Style="{StaticResource BoardListBoxStyle}"
                             SelectionMode="Multiple"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="TechCardList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TechCardList_PreviewMouseMove"
                             DragOver="TechnicianDrawer_DragOver"
                             Drop="TechnicianDrawer_Drop"
                             SelectionChanged="TechniciansList_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Truck board -->
            <Border x:Name="TruckBoardCard"
                    Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="10">

                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <!-- Header and buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Spacing -->
                        <RowDefinition Height="4"/>
                        <!-- Truck cards -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Truck-board header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Trucks"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Drag/drop technicians into trucks. Star sets Lead Tech."
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">

                            <Button Content="Clear All"
                                    Height="32"
                                    MinWidth="90"
                                    Margin="0,0,4,0"
                                    IsEnabled="{Binding CanEditBoard}"
                                    Click="ClearAll_Click"/>

                            <Button Content="Set Home"
                                    Height="32"
                                    MinWidth="90"
                                    Margin="0,0,4,0"
                                    IsEnabled="{Binding CanEditBoard}"
                                    Click="SetHome_Click"/>

                            <Button Content="Cancel"
                                    Height="32"
                                    MinWidth="90"
                                    Margin="0,0,4,0"
                                    IsEnabled="{Binding CanDiscardChanges}"
                                    Click="DiscardChanges_Click"/>

                            <Button Content="{Binding CommitButtonText}"
                                    Height="32"
                                    MinWidth="90"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanCommitChanges}"
                                    Click="CommitChanges_Click"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Truck cards -->
                    <ScrollViewer x:Name="TruckBoardScrollViewer"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PreviewMouseWheel="TruckBoardScrollViewer_PreviewMouseWheel">

                        <ItemsControl ItemsSource="{Binding Board.Trucks}"
                                      MinHeight="0"
                                      ClipToBounds="True">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch"/>

                                    <Setter Property="VerticalAlignment"
                                            Value="Stretch"/>

                                    <Setter Property="Margin"
                                            Value="0,0,8,8"/>

                                    <Setter Property="Height">
                                        <Setter.Value>
                                            <Binding Path="ViewportHeight"
                                                     RelativeSource="{RelativeSource AncestorType=ScrollViewer}"
                                                     Converter="{StaticResource TruckBoardRowHeightConverter}"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TruckCardStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AllowDrop="True"
                                        Tag="{Binding}"
                                        DragOver="TruckCard_DragOver"
                                        Drop="TruckCard_Drop">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Truck header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: truck number/style -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}">
                                                    <Run Text="Truck "/>
                                                    <Run Text="{Binding Truck.TruckNumber}"/>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Truck.TruckStyleName}"
                                                           Margin="0,-2,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>

                                                <!-- Right: count + lead -->
                                                <StackPanel Grid.Column="1"
                                                        Margin="12,2,0,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">

                                                    <TextBlock Text="{Binding Technicians.Count, StringFormat={}{0} techs}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           HorizontalAlignment="Right"
                                                           TextAlignment="Right"/>

                                                    <TextBlock Text="{Binding LeadText}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           HorizontalAlignment="Right"
                                                           TextAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Assigned techs -->
                                            <Grid Grid.Row="2">
                                                <ListBox ItemsSource="{Binding Technicians}"
                                                     ItemTemplate="{StaticResource AssignedTechnicianTemplate}"
                                                     ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                                                     Style="{StaticResource BoardListBoxStyle}"
                                                     SelectionMode="Single"
                                                     PreviewMouseLeftButtonDown="TechCardList_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="TechCardList_PreviewMouseMove"/>

                                                <TextBlock Text="No technicians assigned yet."
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Technicians.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Commit overlay -->
                    <Border Grid.RowSpan="3"
                            Background="#AAFFFFFF"
                            CornerRadius="14"
                            Visibility="{Binding IsCommitting, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="99" Grid.ColumnSpan="3">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="24,18">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Committing truck board..."
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Saving crew assignments and lead techs. Please wait."
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="390"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading truck board..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>