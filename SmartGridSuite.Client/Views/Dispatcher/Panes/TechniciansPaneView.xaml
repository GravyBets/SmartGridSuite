<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TechniciansPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="PaneTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="PaneSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SummaryValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="TruckCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="CountPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BoardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="BoardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TechCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                    <Setter Property="Opacity" Value="0.48"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShiftPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource TileFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DropHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <DataTemplate x:Key="TechnicianCardTemplate">
            <Border Style="{StaticResource TechCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="{Binding EmployeeId, StringFormat=ID: {0}}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource ShiftPillStyle}"
                            Margin="10,0,0,0">
                        <TextBlock Text="On Duty"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="On Duty"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                                            <Setter Property="Text" Value="Off Shift"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top card -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Truck Assignments"
                                   Style="{StaticResource PaneTitleTextStyle}"/>

                        <TextBlock Text="Drag technicians between available and truck assignments"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>

                        <TextBlock x:Name="StatusText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text=""/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button x:Name="ToggleUnassignedBtn"
                                Content="Hide Available"
                                Margin="0,0,8,0"
                                Click="ToggleUnassigned_Click"/>

                        <Button Content="Refresh"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Summary -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OnDutyCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="On Duty"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OffDutyCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Off Shift"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AssignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Assigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource SummaryCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding UnassignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Available / Unassigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="UnassignedColumn" Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Available / Unassigned -->
            <Border x:Name="UnassignedCard"
                    Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Available"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Drop here to remove a technician from a truck"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource CountPillStyle}">
                            <TextBlock Text="{Binding Board.Unassigned.Count, StringFormat={}{0} techs}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,8">
                        <TextBlock Text="Unassigned and available technicians"
                                   Style="{StaticResource DropHintTextStyle}"/>
                    </Border>

                    <Grid Grid.Row="4">
                        <ListBox x:Name="UnassignedList"
                                 ItemsSource="{Binding Board.Unassigned}"
                                 ItemTemplate="{StaticResource TechnicianCardTemplate}"
                                 ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                                 Style="{StaticResource BoardListBoxStyle}"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="List_PreviewMouseMove"
                                 Drop="List_Drop"
                                 Tag="{x:Null}"/>

                        <Border IsHitTestVisible="False"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Board.Unassigned.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="Everyone is assigned."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontStyle="Italic"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Trucks board -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Trucks"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Assign technicians by dragging cards onto a truck"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Style="{StaticResource CountPillStyle}">
                            <TextBlock Text="{Binding Board.Trucks.Count, StringFormat={}{0} trucks}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Board.Trucks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TruckCardStyle}"
                                            Width="360">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Truck header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}">
                                                        <Run Text="Truck "/>
                                                        <Run Text="{Binding Truck.TruckNumber}"/>
                                                    </TextBlock>

                                                    <TextBlock Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Text="{Binding Technicians.Count, StringFormat={}{0} assigned}"/>
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Style="{StaticResource CountPillStyle}">
                                                    <TextBlock Text="{Binding Truck.TruckNumber}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="2"
                                                    Background="{DynamicResource SurfaceBg}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,8">
                                                <TextBlock Text="Drop technicians here"
                                                           Style="{StaticResource DropHintTextStyle}"/>
                                            </Border>

                                            <Grid Grid.Row="4">
                                                <ListBox ItemsSource="{Binding Technicians}"
                                                         ItemTemplate="{StaticResource TechnicianCardTemplate}"
                                                         ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                                                         Style="{StaticResource BoardListBoxStyle}"
                                                         AllowDrop="True"
                                                         PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="List_PreviewMouseMove"
                                                         Drop="List_Drop"
                                                         Tag="{Binding Truck.Id}"/>

                                                <Border IsHitTestVisible="False"
                                                        Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Technicians.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="No technicians assigned yet."
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontStyle="Italic"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>