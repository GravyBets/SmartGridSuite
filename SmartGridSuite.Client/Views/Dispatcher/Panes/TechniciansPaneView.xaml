<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TechniciansPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Dispatch — Truck Board"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="StatusText"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               Text=""/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ToggleUnassignedBtn"
                            Content="Hide Unassigned"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="ToggleUnassigned_Click"/>
                    <Button Content="Refresh"
                            Padding="10,4"
                            Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="UnassignedColumn" Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Trucks board (grid of cards) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Trucks"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Board.Trucks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Auto-wrap into a grid as the window resizes -->
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12"
                                            Padding="12"
                                            Width="340"
                                            CornerRadius="16"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Truck header -->
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}">
                                                        <Run Text="Truck "/>
                                                        <Run Text="{Binding Truck.TruckNumber}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                                                               Text="{Binding Technicians.Count, StringFormat=Techs: {0}}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Drop zone + tech list -->
                                            <ListBox Grid.Row="2"
                                                     ItemsSource="{Binding Technicians}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="List_PreviewMouseMove"
                                                     Drop="List_Drop"
                                                     Tag="{Binding Truck.Id}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="10"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource CardBackground}"
                                                                BorderBrush="{DynamicResource CardBorder}"
                                                                BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding EmployeeId, StringFormat=ID: {0}}"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- Grey out if off shift -->
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Unassigned (collapsible) -->
            <Border x:Name="UnassignedCard"
                    Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="Unassigned"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Foreground="{DynamicResource TextSecondary}"
                                   DockPanel.Dock="Right"
                                   Text="{Binding Board.Unassigned.Count, StringFormat={}{0} techs}"/>
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             x:Name="UnassignedList"
                             ItemsSource="{Binding Board.Unassigned}"
                             Background="Transparent"
                             BorderThickness="0"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="List_PreviewMouseMove"
                             Drop="List_Drop"
                             Tag="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="12"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding EmployeeId, StringFormat=ID: {0}}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>