<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TechniciansPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Text -->
        <Style x:Key="PaneTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="PaneSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SmallLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="SummaryValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Cards -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="TruckCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="10,10,10,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="TechCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnShift}" Value="False">
                    <Setter Property="Opacity" Value="0.48"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox cleanup -->
        <Style x:Key="BoardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="BoardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionChrome"
                                Padding="0"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionChrome"
                                        Property="Background"
                                        Value="#F3F7FF"/>
                                        <Setter TargetName="SelectionChrome"
                                        Property="BorderBrush"
                                        Value="#BFDBFE"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionChrome"
                                        Property="Background"
                                        Value="#DBEAFE"/>
                                        <Setter TargetName="SelectionChrome"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent Icon Button -->
        <Style x:Key="TransparentIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tech assigned to a truck card -->
        <DataTemplate x:Key="AssignedTechnicianTemplate">
            <Border Style="{StaticResource TechCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ScheduleText}"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding Title}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <Button Grid.Column="1"
                            Style="{StaticResource TransparentIconButtonStyle}"
                            Margin="10,0,0,0"
                            Tag="{Binding}"
                            ToolTip="Remove from truck"
                            Click="RemoveTechFromTruck_Click">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Right drawer technician card -->
        <DataTemplate x:Key="TechnicianDrawerTemplate">
            <Border Style="{StaticResource TechCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Top"
                              Margin="0,9,0,0"
                              IsChecked="{Binding IsSelected,
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Mode=TwoWay}"/>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: name/title -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="{Binding Title}"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Right: assignment/schedule -->
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"
                                        Value="{Binding TruckNumber, StringFormat=Assigned: Truck {0}}"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TruckNumber}" Value="">
                                                <Setter Property="Text" Value="Unassigned"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TruckNumber}" Value="{x:Null}">
                                                <Setter Property="Text" Value="Unassigned"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding ScheduleText}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    
    </UserControl.Resources>

    <Grid PreviewMouseDown="RootGrid_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header / Summary -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Daily Truck Board"
                                   Style="{StaticResource PaneTitleTextStyle}"/>

                        <TextBlock Text="Build today’s crews by assigning technicians to trucks."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="Clear All"
                                Height="34"
                                MinWidth="100"
                                Margin="0,0,8,0"
                                Click="ClearAll_Click"/>

                        <Button Content="Set Home"
                                Height="34"
                                MinWidth="100"
                                Margin="0,0,8,0"
                                Click="SetHome_Click"/>

                        <Button Content="Refresh"
                                Height="34"
                                MinWidth="100"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="2"
                             Rows="1"
                             Columns="4">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding OnDutyCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="On Duty"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AssignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Assigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding UnassignedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Unassigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding TrucksUsedCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Trucks Used"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Truck board -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Trucks"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Use + Add Tech to build or adjust crews."
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Board.Trucks.Count, StringFormat={}{0} trucks}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Board.Trucks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TruckCardStyle}"
                                            Width="390"
                                            MinHeight="170">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Truck header + actions -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}">
                                                        <Run Text="Truck "/>
                                                        <Run Text="{Binding Truck.TruckNumber}"/>
                                                    </TextBlock>

                                                    <TextBlock Text="{Binding Truck.TruckStyleName}"
                                                               Margin="0,-2,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Top"
                                                            Margin="12,0,0,0">
                                                    <Button Content="Add Selected"
                                                            Height="30"
                                                            MinWidth="120"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Tag="{Binding}"
                                                            Click="AddSelectedToTruck_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- Assigned techs -->
                                            <Grid Grid.Row="2">
                                                <ListBox ItemsSource="{Binding Technicians}"
                                                         ItemTemplate="{StaticResource AssignedTechnicianTemplate}"
                                                         ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                                                         Style="{StaticResource BoardListBoxStyle}"
                                                         SelectionMode="Single"
                                                         SelectionChanged="AssignedTruckTechList_SelectionChanged"/>

                                                <TextBlock Text="No technicians assigned yet."
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Technicians.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Technician drawer -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Technicians"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Defaults to unassigned technicians."
                                       Margin="0,3,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VisibleTechnicianCount, StringFormat={}{0} shown}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TechnicianSearchBox"
                                 Grid.Row="0"
                                 Height="32"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Tag="Search name, title, truck, schedule..."
                                 TextChanged="TechnicianSearchBox_TextChanged"/>

                        <StackPanel Grid.Row="2">
                            <CheckBox x:Name="ShowAllTechniciansCheckBox"
                                      Content="Show assigned techs too"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimary}"
                                      Checked="ShowAllTechnicians_Changed"
                                      Unchecked="ShowAllTechnicians_Changed"/>

                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SelectedDrawerTechnicianCount, StringFormat={}{0} selected}"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="TechniciansList"
                             Grid.Row="4"
                             ItemsSource="{Binding Board.AllTechnicians}"
                             ItemTemplate="{StaticResource TechnicianDrawerTemplate}"
                             ItemContainerStyle="{StaticResource BoardListBoxItemStyle}"
                             Style="{StaticResource BoardListBoxStyle}"
                             SelectionMode="Multiple"
                             SelectionChanged="TechniciansList_SelectionChanged"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>