<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TaskPaneView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1100" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!-- Copy glyph -->
        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Text" Value="" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Temporary confirmation glyph shown after a value is copied. -->
        <Style x:Key="CheckGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Small transparent button containing the circled expand/collapse chevron. -->
        <Style x:Key="TaskExpandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatCopyIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTip" Value="Show or hide task details"/>
        </Style>

        <!-- Circled expand/collapse chevron. -->
        <!-- Matches the Field Tech History expand indicator. -->
        <DataTemplate x:Key="TaskExpandRowCellTemplate">
            <Grid Width="28"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Button Style="{StaticResource TaskExpandButtonStyle}"
                        Click="ToggleTaskRowDetails_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid Width="18"
                          Height="18">
                        <Ellipse x:Name="ChevronCircle"
                                 Width="18"
                                 Height="18"
                                 Fill="Transparent"
                                 Stroke="{DynamicResource TextPrimary}"
                                 StrokeThickness=".75"/>
                        <Path x:Name="ChevronPath"
                              Width="8"
                              Height="6"
                              Margin="0,0,0,-2"
                              Data="M 0,0 L 4,4 L 8,0"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin=".45,.35">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>

                <!-- Blue dot indicates a submitted write-up is available. -->
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource PrimaryBg}"
                        BorderBrush="{DynamicResource CardBackground}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-1,-1,0"
                        ToolTip="Submitted write-up available">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubmittedWriteUpDisplay}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SubmittedWriteUpDisplay}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DetailsVisibility,
                                       RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             Value="Visible">
                    <Setter TargetName="ChevronPath"
                            Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TaskExpandedLabelText"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="TaskExpandedValueText"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TaskSelectableValueText"
               TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="TaskNoSubmittedWriteUpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskExpandedSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <DataTemplate x:Key="TaskRowDetailsTemplate">
            <Grid Margin="4,4,4,8"
                  MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                  HorizontalAlignment="Stretch">
                <ScrollViewer MaxHeight="500"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">

                    <Grid Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- =========================
                             SUBMITTED WRITE-UP
                             ========================= -->
                        <Border Grid.Column="0"
                                Style="{StaticResource TaskExpandedSectionCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Submitted Write-Up"
                                                   Style="{StaticResource TaskExpandedLabelText}"
                                                   Margin="0"/>

                                        <StackPanel Orientation="Horizontal"
                                            Margin="0,3,0,0">
                                            <TextBlock Text="{Binding SubmittedByName}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock Text="  •  "
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>

                                            <TextBlock Text="{Binding SubmittedAt,
                                                StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="26"
                                            Height="26"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Tag="{Binding SubmittedWriteUpCopyText}"
                                            ToolTip="Copy submitted write-up"
                                            Click="CopySubmittedWriteUp_Click">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource FlatCopyIconButton}">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SubmittedWriteUp}"
                                                                 Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SubmittedWriteUp}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <TextBlock Style="{StaticResource CopyGlyph}"/>
                                    </Button>
                                </Grid>

                                <TextBox Text="{Binding SubmittedWriteUpDisplay,
                                            Mode=OneWay}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         IsTabStop="False"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         HorizontalAlignment="Stretch"
                                         BorderThickness="0"
                                         Padding="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="13"
                                         Cursor="IBeam"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled">

                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SubmittedWriteUpDisplay}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding SubmittedWriteUpDisplay}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Text="No active submitted write-up was found for this task."
                                           Style="{StaticResource TaskNoSubmittedWriteUpText}"/>
                            </StackPanel>
                        </Border>

                        <!-- =========================
                             WORKFLOW / CLOSEOUT
                             ========================= -->
                        <Border Grid.Column="2"
                                Style="{StaticResource TaskExpandedSectionCard}">
                            <StackPanel>
                                <TextBlock Text="Write-Up Flags"
                                           Style="{StaticResource TaskExpandedLabelText}"/>

                                <TextBox Text="{Binding WriteUpFlagsDisplay, Mode=OneWay}"
                                         Style="{StaticResource TaskSelectableValueText}"
                                         Margin="0,0,0,8"/>

                                <!-- IP changes captured in submitted write-up -->
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DispatchChangesDisplay}"
                                                             Value="">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding DispatchChangesDisplay}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Changes"
                                               Style="{StaticResource TaskExpandedLabelText}"
                                               Margin="0,4,0,2"/>

                                    <TextBox Text="{Binding DispatchChangesDisplay, Mode=OneWay}"
                                             Style="{StaticResource TaskSelectableValueText}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ReferToOptionsDisplay}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding ReferToOptionsDisplay}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Refer To"
                                               Style="{StaticResource TaskExpandedLabelText}"/>

                                    <TextBlock Text="{Binding ReferToOptionsDisplay}"
                                               Style="{StaticResource TaskExpandedValueText}"/>
                                </StackPanel>

                                <Border Height="1"
                                        Background="{DynamicResource SurfaceBorder}"
                                        Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center">

                                        <TextBlock.Text>
                                            <Binding Path="RequiredChecklistRemaining"
                                             StringFormat="Required remaining: {0}"/>
                                        </TextBlock.Text>

                                    </TextBlock>

                                    <TextBlock Text="Dispatch Closeout Checklist"
                                       Style="{StaticResource TaskExpandedLabelText}"
                                       Margin="0"/>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CloseoutChecklistItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,0,0"
                                                          IsChecked="{Binding IsCompleted,
                                                                              Mode=TwoWay}"
                                                          Click="DispatchCloseoutItem_Click"/>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"/>

                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,3,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <TextBlock Text="Completed by "
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}"/>

                                                        <TextBlock Text="{Binding CompletedBy}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}"/>

                                                        <TextBlock Text="  •  "
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}"/>

                                                        <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding RequiredLabel}"
                                                           Margin="10,1,0,0"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No closeout checklist items were generated for this submission."
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondary}">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CloseoutChecklistItems.Count}"
                                                             Value="0">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Task actions -->
                                <Border Height="1"
        Background="{DynamicResource SurfaceBorder}"
        Margin="0,14,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="11"
               Foreground="{DynamicResource TextSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                        Value="Complete required checklist items before closing."/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanCloseFromTasks}"
                                 Value="True">
                                                        <Setter Property="Text"
                                Value="Ready to close."/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding IsClosed}"
                                 Value="True">
                                                        <Setter Property="Text"
                                Value="Ticket closed."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">

                                        <Button Content="Edit Ticket"
                                                Height="30"
                                                Width="108"
                                                Padding="12,0"
                                                Margin="8,0,4,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OpenNotification_Click"/>

                                        <Button Content="Mark Closed"
                                                Height="30"
                                                Width="108"
                                                Padding="12,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="{Binding CanCloseFromTasks}"
                                                Click="MarkClosed_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- =========================
                             SITE NOTES
                             ========================= -->
                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource TaskExpandedSectionCard}">

                            <StackPanel>

                                <!-- Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Site Notes"
                                                   Style="{StaticResource TaskExpandedLabelText}"
                                                   Margin="0"
                                                   VerticalAlignment="Center"/>

                                        <Border MinWidth="20"
                                                Height="20"
                                                Padding="6,0"
                                                Margin="8,0,0,0"
                                                CornerRadius="10"
                                                Background="{DynamicResource PrimaryBg}"
                                                VerticalAlignment="Center">

                                            <TextBlock Text="{Binding SiteNotes.Count}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="+ Add"
                                            Width="72"
                                            Height="28"
                                            Padding="10,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddTaskSiteNote_Click"/>
                                </Grid>

                                <!-- Loading -->
                                <TextBlock Text="Loading site notes..."
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4,0,4">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSiteNotesLoading}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Empty -->
                                <TextBlock Text="No site notes for this site."
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4,0,4">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SiteNotesLoaded}"
                                                                   Value="True"/>
                                                        <Condition Binding="{Binding SiteNotes.Count}"
                                                                   Value="0"/>
                                                    </MultiDataTrigger.Conditions>

                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Notes -->
                                <ItemsControl ItemsSource="{Binding SiteNotes}">
                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource TabBgHover}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    BorderThickness="1">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">

                                                        <TextBlock Text="{Binding NoteText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary}"/>

                                                        <TextBlock Margin="0,5,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}">
                                                                    <Run Text="Created by "/>
                                                                    <Run Text="{Binding CreatedBy}"
                                                                         FontWeight="SemiBold"/>
                                                                    <Run Text=" • "/>
                                                                    <Run Text="{Binding CreatedAt,
                                                                               StringFormat={}{0:MM/dd/yyyy HH:mm}}"/>
                                                        </TextBlock>

                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}">

                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible"/>

                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UpdatedAt}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                                <Run Text="Updated by "/>
                                                                <Run Text="{Binding UpdatedBy}"
                                                                     FontWeight="SemiBold"/>
                                                                <Run Text=" • "/>
                                                                <Run Text="{Binding UpdatedAt,
                                                                           StringFormat={}{0:MM/dd/yyyy HH:mm}}"/>
                                                        </TextBlock>

                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Top"
                                                                Margin="12,0,0,0">

                                                        <Button Content="Edit"
                                                                Tag="{Binding}"
                                                                Width="62"
                                                                Height="28"
                                                                Padding="8,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="EditTaskSiteNote_Click"/>

                                                        <Button Content="Delete"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                MaxWidth="48"
                                                                Height="28"
                                                                Padding="8,0"
                                                                Margin="4,0,0,0"                                                                
                                                                Click="DeleteTaskSiteNote_Click"/>
                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <Style x:Key="FilterLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Opacity" Value="0.88" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="TasksGridColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tasks"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />

                <TextBlock Text="Items waiting on dispatch action."
                           Margin="0,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Labels -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Search"
                       Style="{StaticResource FilterLabelText}" />

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Status"
                       Style="{StaticResource FilterLabelText}" />

            <!-- Controls -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="2"
                     Grid.Column="0"
                     Style="{StaticResource ClearableSearchTextBox}"
                     Tag="Search site, notification, WO, tech, action required..."
                     Height="36"
                     TextChanged="SearchBox_TextChanged" />

            <ComboBox x:Name="StatusFilter"
                      Grid.Row="2"
                      Grid.Column="2"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Filters_SelectionChanged" />

            <Button x:Name="ClearTaskFiltersButton"
                    Grid.Row="2"
                    Grid.Column="4"
                    Content="Clear Filters"
                    Height="36"
                    Width="104"
                    Padding="14,0"
                    Click="ClearTaskFilters_Click" />

            <Button x:Name="RefreshTasksButton"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Grid.Row="2"
                    Grid.Column="6"
                    Content="Refresh"
                    Height="36"
                    Width="104"
                    Padding="14,0"
                    VerticalAlignment="Top"
                    Click="Refresh_Click" />
        </Grid>

        <!-- Main workspace -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Task List -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0"
                               LastChildFill="True">

                        <TextBlock Text="Task List"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>

                    <!-- Grid -->
                    <DataGrid Grid.Row="2"
                              x:Name="TasksGrid"
                              Style="{StaticResource ThemedDataGridStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="34"
                              MinRowHeight="34"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                              ColumnHeaderStyle="{StaticResource TasksGridColumnHeaderStyle}"
                              RowDetailsVisibilityMode="Collapsed"
                              RowDetailsTemplate="{StaticResource TaskRowDetailsTemplate}"
                              LoadingRow="TasksGrid_LoadingRow"
                              SelectionChanged="TasksGrid_SelectionChanged"
                              MouseDoubleClick="TasksGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50"
                                                    CanUserResize="False"
                                                    CanUserSort="False"
                                                    CellTemplate="{StaticResource TaskExpandRowCellTemplate}"/>
                            <DataGridTextColumn Header="Site" Width="105"
                                                Binding="{Binding Site}"
                                                ElementStyle="{StaticResource TrimCellText}" />
                            <DataGridTextColumn Header="Notification Name"
                                                Width="2*"
                                                Binding="{Binding NotificationName}"
                                                ElementStyle="{StaticResource TrimCellText}" />
                            <DataGridTextColumn Header="Problem / Issue"
                                                Width="2*" Binding="{Binding Problem}"
                                                ElementStyle="{StaticResource TrimCellText}" />
                            <DataGridTemplateColumn Header="Notification"
                                                    Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Notification}"
                                                       Style="{StaticResource TrimCellText}" />
                                            <Button Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="4,0,0,0"
                                                    Tag="{Binding Notification}"
                                                    ToolTip="Copy notification"
                                                    Click="CopyNotification_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Notification}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Notification}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                           FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Work Order"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding WorkOrder}"
                                                       Style="{StaticResource TrimCellText}" />

                                            <Button Grid.Column="1"
                                                    Width="24" Height="24"
                                                    Margin="4,0,0,0"
                                                    Tag="{Binding WorkOrder}"
                                                    ToolTip="Copy work order"
                                                    Click="CopyWorkOrder_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkOrder}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding WorkOrder}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                           FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="WO Type" Width="105"
                                                Binding="{Binding WorkOrderClassLabel}"
                                                ElementStyle="{StaticResource TrimCellText}" />

                            <DataGridTextColumn Header="Status"
                                                Width="125"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource TrimCellText}" />

                            <DataGridTextColumn Header="Tech" Width="140"
                                                Binding="{Binding Tech}"
                                                ElementStyle="{StaticResource TrimCellText}" />

                            <DataGridTextColumn Header="Action Required"
                                                Width="1.7*"
                                                Binding="{Binding ActionRequired}"
                                                ElementStyle="{StaticResource TrimCellText}" />
                            <DataGridTextColumn Header="Checklist"
                                                Width="135"
                                                Binding="{Binding ChecklistProgressDisplay}"
                                                ElementStyle="{StaticResource TrimCellText}" />

                            <DataGridTextColumn Header="Last Activity"
                                                Width="132"
                                                Binding="{Binding OccurredAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                                ElementStyle="{StaticResource TrimCellText}" />

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="5"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380" Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14" />

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading dispatch tasks..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
