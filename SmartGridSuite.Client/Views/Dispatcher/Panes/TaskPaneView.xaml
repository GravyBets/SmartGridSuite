<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TasksPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>

        <!-- Small icon-ish button (copy) -->
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
        </Style>

        <!-- Copy glyph -->
        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <!-- Windows UI icon font -->
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <!-- U+E8C8 (Copy) -->
            <Setter Property="Text" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Tight single-line cell text -->
        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Small badge for Maint/Cap -->
        <Style x:Key="WoBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Tasks"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Items waiting on dispatch action (work order conversion, finalize notes, parts follow-up, etc.)"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Style="{StaticResource ModernWatermarkTextBox}"
                     Tag="Search site, tech, notification, WO, notes…"
                     Height="34"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="StatusFilter"
                      Grid.Column="2"
                      Height="34"
                      SelectionChanged="Filters_SelectionChanged"/>

            <ComboBox x:Name="CategoryFilter"
                      Grid.Column="4"
                      Height="34"
                      SelectionChanged="Filters_SelectionChanged"/>

            <Button Grid.Column="6"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="34"
                    Content="Refresh"
                    Click="Refresh_Click"/>
        </Grid>

        <!-- Body: table + details panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="DetailsCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Tasks table -->
            <DataGrid Grid.Column="0"
                      x:Name="TasksGrid"
                      Style="{StaticResource ThemedDataGridStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="TasksGrid_SelectionChanged">

                <DataGrid.Columns>
                    <!-- 1 = Date/Time -->
                    <DataGridTextColumn Header="Date/Time"
                                        Width="150"
                                        Binding="{Binding OccurredAt, StringFormat={}{0:MM/dd HH:mm}}"/>

                    <!-- 2 = Site -->
                    <DataGridTextColumn Header="Site"
                                        Width="140"
                                        Binding="{Binding Site}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <!-- 3 = Tech -->
                    <DataGridTextColumn Header="Tech"
                                        Width="150"
                                        Binding="{Binding Tech}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <!-- 4 = Notification + copy -->
                    <DataGridTemplateColumn Header="Notification" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource MiniIconButton}"
                                            ToolTip="Copy Notification"
                                            Tag="{Binding Notification}"
                                            Click="CopyNotification_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}"/>
                                    </Button>

                                    <TextBlock Text="{Binding Notification}"
                                               Style="{StaticResource TrimCellText}"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5 = Work Order + Maint/Cap badge + copy -->
                    <DataGridTemplateColumn Header="Work Order" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">

                                    <!-- Copy button (hide if blank) -->
                                    <Button DockPanel.Dock="Right"
        ToolTip="Copy Work Order"
        Tag="{Binding WorkOrder}"
        Click="CopyWorkOrder_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WorkOrder}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource CopyGlyph}"/>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WorkOrder}"
                                                   Style="{StaticResource TrimCellText}"/>

                                        <!-- Maint/Cap badge (hide if blank) -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource WoBadge}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WorkOrder}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding WorkOrderClassLabel}"
               Foreground="{DynamicResource TextSecondary}"
               FontSize="12"
               VerticalAlignment="Center"/>
                                        </Border> 
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 6 = Action required -->
                    <DataGridTextColumn Header="Action Required"
                                        Width="260"
                                        Binding="{Binding ActionRequired}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <!-- 7 = Notes -->
                    <DataGridTextColumn Header="Notes"
                                        Width="*"
                                        Binding="{Binding Notes}"
                                        ElementStyle="{StaticResource TrimCellText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- Details panel -->
            <Border Grid.Column="2"
                    x:Name="DetailsPanel"
                    Style="{StaticResource Card}"
                    Padding="14"
                    Visibility="Collapsed">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Task Details"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectedTask.Site}"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="10,0,0,0"
                                ToolTip="Close details"
                                Click="CloseDetails_Click"
                                Background="Transparent"
                                BorderThickness="0">
                            <TextBlock Text="✕"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Key fields -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Date/Time" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTask.OccurredAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tech" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.Tech}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Notification row with copy -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Notification" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource MiniIconButton}"
                                    ToolTip="Copy Notification"
                                    Tag="{Binding SelectedTask.Notification}"
                                    Click="CopyNotification_Click">
                                <TextBlock Style="{StaticResource CopyGlyph}"/>
                            </Button>
                            <TextBlock Text="{Binding SelectedTask.Notification}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Work order row with copy + badge -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Work Order" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
        ToolTip="Copy Work Order"
        Tag="{Binding SelectedTask.WorkOrder}"
        Click="CopyWorkOrder_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTask.WorkOrder}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource CopyGlyph}"/>
                            </Button>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTask.WorkOrder}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource WoBadge}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTask.WorkOrder}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding SelectedTask.WorkOrderClassLabel}"
               Foreground="{DynamicResource TextSecondary}"
               FontSize="12"
               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Action Required" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTask.ActionRequired}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Notes + actions -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">

                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="Copy Summary"
                                        Margin="0,0,8,0"
                                        Height="30"
                                        Padding="10,0"
                                        Click="CopySummary_Click"/>

                                <Button Content="Open Notification"
                                        Margin="0,0,8,0"
                                        Height="30"
                                        Padding="10,0"
                                        Click="OpenNotification_Click"/>

                                <Button Content="Mark Done"
                                        Height="30"
                                        Padding="10,0"
                                        Click="MarkDone_Click"/>
                            </StackPanel>

                            <TextBox Margin="0,10,0,0"
                                     Text="{Binding SelectedTask.Notes}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextSecondary}"
                                     VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>