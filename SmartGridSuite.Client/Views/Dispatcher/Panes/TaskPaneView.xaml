<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TaskPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>

        <!-- Copy glyph -->
        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TaskDetailLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="TaskDetailValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TaskDetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FilterLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="TasksGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tasks"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Items waiting on dispatch action."
                       Margin="0,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>            
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Labels -->
            <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Search"
                   Style="{StaticResource FilterLabelText}"/>

            <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Text="Status"
                   Style="{StaticResource FilterLabelText}"/>

            <!-- Controls -->
            <TextBox x:Name="SearchBox"
                 Grid.Row="2"
                 Grid.Column="0"
                 Style="{StaticResource ClearableSearchTextBox}"
                 Tag="Search site, notification, WO, tech, action required..."
                 Height="36"
                 TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="StatusFilter"
                      Grid.Row="2"
                      Grid.Column="2"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Filters_SelectionChanged"/>

            <Button x:Name="ClearTaskFiltersButton"
                    Grid.Row="2"
                    Grid.Column="4"
                    Content="Clear Filters"
                    Height="36"
                    Width="104"
                    Padding="14,0"
                    Click="ClearTaskFilters_Click"/>

            <Button x:Name="RefreshTasksButton"
                    Grid.Row="2"
                    Grid.Column="6"
                    Content="Refresh"
                    Height="36"
                    Width="104"
                    Padding="14,0"
                    VerticalAlignment="Top"
                    Click="Refresh_Click"/>
        </Grid>

        <!-- Main workspace -->
        <Border Grid.Row="4"
            Style="{StaticResource Card}"
            Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailsSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="DetailsCol" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Task List -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0"
                           LastChildFill="True">

                        <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                            <Button x:Name="OpenTaskDetailsButton"
                                    Content="Open Details"
                                    Height="30"
                                    Width="108"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenTaskDetails_Click"/>

                            <Button x:Name="OpenTaskTicketButton"
                                    Content="Edit Ticket"
                                    Height="30"
                                    Width="108"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenNotification_Click"/>

                            <Button x:Name="MarkTaskClosedButton"
                                    Content="Mark Closed"
                                    Height="30"
                                    Width="108"
                                    Padding="12,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="MarkClosed_Click"/>
                        </StackPanel>

                        <TextBlock Text="Task List"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    </DockPanel>

                    <!-- Grid -->
                    <DataGrid Grid.Row="2"
                          x:Name="TasksGrid"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="34"
                          MinRowHeight="34"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                          ColumnHeaderStyle="{StaticResource TasksGridColumnHeaderStyle}"
                          SelectionChanged="TasksGrid_SelectionChanged"
                          MouseDoubleClick="TasksGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Site"
                                            Width="105"
                                            Binding="{Binding Site}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Notification Name"
                                            Width="2*"
                                            Binding="{Binding NotificationName}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Problem / Issue"
                                            Width="2*"
                                            Binding="{Binding Problem}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTemplateColumn Header="Notification"
                                                Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                   Text="{Binding Notification}"
                                                   Style="{StaticResource TrimCellText}"/>

                                            <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                Tag="{Binding Notification}"
                                                ToolTip="Copy notification"
                                                Click="CopyNotification_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                       BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Notification}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Notification}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                       FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Work Order"
                                                Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                   Text="{Binding WorkOrder}"
                                                   Style="{StaticResource TrimCellText}"/>

                                            <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                Tag="{Binding WorkOrder}"
                                                ToolTip="Copy work order"
                                                Click="CopyWorkOrder_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                       BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WorkOrder}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding WorkOrder}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                       FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="WO Type"
                                            Width="105"
                                            Binding="{Binding WorkOrderClassLabel}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Status"
                                            Width="125"
                                            Binding="{Binding Status}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Tech"
                                            Width="140"
                                            Binding="{Binding Tech}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Action Required"
                                            Width="2*"
                                            Binding="{Binding ActionRequired}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Last Activity"
                                            Width="132"
                                            Binding="{Binding OccurredAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                            ElementStyle="{StaticResource TrimCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                          x:Name="DetailsSplitter"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          Visibility="Collapsed"/>

                <!-- Details panel -->
                <Border Grid.Column="2"
                    x:Name="DetailsPanel"
                    Style="{StaticResource Card}"
                    Padding="14"
                    Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTask.Site, TargetNullValue=Task Details}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                                <Border Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="8,3"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedTask.Status}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="10,0,0,0"
                                ToolTip="Close details"
                                Click="CloseDetails_Click"
                                Background="Transparent"
                                BorderThickness="0">
                                <TextBlock Text="✕"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Main info card -->
                        <Border Grid.Row="2"
                            Style="{StaticResource TaskDetailSectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- LEFT 1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Notification Name"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTaskTicket.NotificationName}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 1 -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Problem / Issue"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTaskTicket.Problem}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- LEFT 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Notification"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTask.Notification}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 2 -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Work Order"
                                           Style="{StaticResource TaskDetailLabelText}"/>

                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedTask.WorkOrder}"
                                               Style="{StaticResource TaskDetailValueText}"/>

                                        <TextBlock Text="{Binding SelectedTask.WorkOrderClassLabel}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- LEFT 3 -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Assigned Tech"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTask.Tech}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 3 -->
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="Action Required"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTaskActionRequiredDisplay}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- LEFT 4 -->
                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="Last Activity"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTask.OccurredAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 4 -->
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="Created By"
                                           Style="{StaticResource TaskDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTaskCreatedByDisplay}"
                                           Style="{StaticResource TaskDetailValueText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Collapsible sections -->
                        <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- Site Notes -->
                                <Expander x:Name="TaskSiteNotesExpander"
                                      IsExpanded="False"
                                      Expanded="TaskDetailExpander_ExpandedChanged"
                                      Collapsed="TaskDetailExpander_ExpandedChanged">

                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Site Notes"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <Border Margin="8,0,0,0"
                                                MinWidth="17"
                                                Height="17"
                                                Padding="4,0"
                                                CornerRadius="11"
                                                Background="#D92D20"
                                                VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedTaskSiteNotesCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding SelectedTaskSiteNotesCount}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>

                                    <Border Style="{StaticResource TaskDetailSectionCard}"
                                        Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Reusable notes tied to this site."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"/>

                                                <Button Grid.Column="1"
                                                    Content="+ Add"
                                                    Height="28"
                                                    Width="60"
                                                    Padding="8,0"
                                                    Click="AddSelectedTaskSiteNote_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditSelectedTaskTicket}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                            <ItemsControl Grid.Row="2"
                                                      ItemsSource="{Binding SelectedTaskSiteNotes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                            Padding="10"
                                                            CornerRadius="10"
                                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBg}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="8"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="8"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                       Text="{Binding NoteText}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimary}"/>

                                                                <TextBlock Grid.Row="2"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}">
                                                                <Run Text="Created by "/>
                                                                <Run Text="{Binding CreatedBy}"/>
                                                                <Run Text=" on "/>
                                                                <Run Text="{Binding CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"/>
                                                                </TextBlock>

                                                                <StackPanel Grid.Row="4"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.CanEditSelectedTaskTicket, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>

                                                                    <Button Content="Edit"
                                                                            Height="24"
                                                                            Width="62"
                                                                            Padding="8,0"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Click="EditSelectedTaskSiteNote_Click"/>

                                                                    <Button Content="Delete"
                                                                            Style="{StaticResource DangerButtonStyle}"
                                                                            Height="24"
                                                                            Width="62"
                                                                            Padding="0,0"
                                                                            Tag="{Binding}"                                                                            
                                                                            Click="DeleteSelectedTaskSiteNote_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Dispatch Notes -->
                                <Expander x:Name="TaskDispatchNotesExpander"
                                          Header="Dispatch Notes"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontWeight="Bold"
                                          IsExpanded="False"
                                          Margin="0,10,0,0"
                                          Expanded="TaskDetailExpander_ExpandedChanged"
                                          Collapsed="TaskDetailExpander_ExpandedChanged">
                                    <Border Style="{StaticResource TaskDetailSectionCard}"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="Visible to the assigned field technician."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"/>

                                            <Border Grid.Row="2"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    Background="{DynamicResource SurfaceBg}">

                                                <TextBox x:Name="TaskDispatchNotesTextBox"
                                                        Style="{x:Null}"
                                                        Text="{Binding SelectedTaskTicket.DispatchNotes, UpdateSourceTrigger=PropertyChanged}"
                                                        AcceptsReturn="True"
                                                        TextWrapping="Wrap"
                                                        IsReadOnly="{Binding IsSelectedTaskTicketClosed}"
                                                        MinHeight="160"
                                                        MaxHeight="328"
                                                        Padding="10"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        VerticalContentAlignment="Top"
                                                        VerticalScrollBarVisibility="Auto"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        TextChanged="TaskDispatchNotesTextBox_TextChanged"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Tech Write-Ups -->
                                <Expander x:Name="TaskTechWriteUpsExpander"
                                          Header="Tech Write-Ups"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontWeight="Bold"
                                          IsExpanded="False"
                                          Margin="0,10,0,0"
                                          Expanded="TaskDetailExpander_ExpandedChanged"
                                          Collapsed="TaskDetailExpander_ExpandedChanged">
                                    <Border Style="{StaticResource TaskDetailSectionCard}"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="Dispatcher can edit submitted technician write-ups here. Click Save Notes to save changes."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"/>

                                            <Border Grid.Row="2"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    Background="{DynamicResource SurfaceBg}">

                                                <TextBox x:Name="TaskTechWriteUpsTextBox"
                                                         Style="{x:Null}"
                                                         Text="{Binding SelectedTaskTicket.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="{Binding IsSelectedTaskTicketClosed}"
                                                         IsReadOnlyCaretVisible="True"
                                                         MinHeight="220"
                                                         MaxHeight="342"
                                                         Padding="10"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         TextChanged="TaskTechWriteUpsTextBox_TextChanged"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions -->
                        <StackPanel Grid.Row="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Copy Write-Up"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    Click="CopySummary_Click"/>

                            <Button Content="Edit Ticket"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    Click="OpenNotification_Click"/>

                            <Button x:Name="SaveTaskNotesButton"
                                    Content="Save Notes"
                                    Height="32"
                                    Width="94"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveTaskNotes_Click"/>

                            <Button x:Name="MarkDetailsClosedButton"
                                    Content="Mark Closed"
                                    Height="32"
                                    Width="94"
                                    Padding="12,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="MarkClosed_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="5"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading dispatch tasks..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>