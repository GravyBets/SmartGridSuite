<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.DailyAssignmentsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Panes"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Crew / Technician ComboBox Item -->
        <DataTemplate x:Key="AssignmentTargetComboTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Warning icon only for no-ticket targets -->
                <TextBlock Grid.Column="0"
                           Text="⚠"
                           FontSize="15"
                           Foreground="#DC2626"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoTickets}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Name / Crew -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding PrimaryText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Truck / Title -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding SecondaryText}"
                               Margin="0,1,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Assignment Status -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding ComboStatusText}"
                               Margin="0,1,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#15803D"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoTickets}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding HasUnpublishedChanges}" Value="True">
                                        <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Ticket Card Template (LEFT)-->
        <DataTemplate x:Key="TicketCardTemplate">
            <Border Style="{StaticResource TicketCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Top"
                              Margin="0,5,0,0"
                              IsChecked="{Binding IsSelected,
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Mode=TwoWay}"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Site + Status -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Site}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Notification Name -->
                        <TextBlock Grid.Row="2"
                           Text="{Binding NotificationName}"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"/>

                        <!-- Problem / Issue -->
                        <TextBlock Grid.Row="4"
                           Text="{Binding Problem}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Ticket Card Template (RIGHT)-->
        <DataTemplate x:Key="AssignedTicketTemplate">
            <Border Style="{StaticResource TicketCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="215"/>
                    </Grid.ColumnDefinitions>

                    <!-- Route order, no bubble -->
                    <TextBlock Grid.Column="0"
                               Margin="0,0,8,0"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Top"
                               TextAlignment="Right"
                               Text="{Binding SortOrder, StringFormat={}{0}.}"/>

                    <!-- Left: site / notification / problem -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           FontSize="14"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Site}"
                         Foreground="{DynamicResource TextPrimary}"/>
                    <Run Text=" "/>
                    <Run Text="("
                         Foreground="{DynamicResource TextSecondary}"/>
                    <Run Text="{Binding Status}"
                         Foreground="{DynamicResource TextSecondary}"/>
                    <Run Text=")"
                         Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2"
                           Text="{Binding NotificationName}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="4"
                           Text="{Binding Problem}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Right: ticket numbers + row actions -->
                    <Grid Grid.Column="2"
                  Margin="12,0,0,0"
                  VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- Notification # + Up -->
                        <StackPanel Grid.Row="0"
                            Grid.Column="0">
                            <TextBlock Text="Notification #"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text="{Binding Notification}"
                               Margin="0,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource TransparentIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="Move up"
                        Click="MoveAssignedTicketUp_Click">
                            <TextBlock Text="▲"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"/>
                        </Button>

                        <!-- Work Order # + Down -->
                        <StackPanel Grid.Row="2"
                            Grid.Column="0">
                            <TextBlock Text="Work Order #"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text="{Binding WorkOrder}"
                               Margin="0,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource TransparentIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="Move down"
                        Click="MoveAssignedTicketDown_Click">
                            <TextBlock Text="▼"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"/>
                        </Button>

                        <!-- WO Type + Trash -->
                        <StackPanel Grid.Row="4"
                            Grid.Column="0">
                            <TextBlock Text="WO Type"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text="{Binding WorkOrderClass}"
                               Margin="0,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource TransparentIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="Remove from assignment"
                        Click="RemoveAssignedTicket_Click">
                            <Viewbox Width="14"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                        <Path Style="{StaticResource TrashCanIconPathStyle}"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Floating ticket card shown while dragging -->
        <DataTemplate x:Key="DragGhostTicketTemplate">
            <Border Width="390"
            Padding="12"
            CornerRadius="12"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource PrimaryBg}"
            BorderThickness="2"
            Opacity="0.93">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Ticket.Site}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">

                            <Border Padding="7,2"
                            Margin="0,0,8,0"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1">
                                <TextBlock Text="{Binding Ticket.Status}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                            </Border>

                            <Border Padding="7,2"
                            CornerRadius="10"
                            Background="{DynamicResource PrimaryBg}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdditionalCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding AdditionalCountText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2"
                       Text="{Binding Ticket.NotificationName}"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                       Text="{Binding Ticket.Problem}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       MaxHeight="36"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Daily Assignments"
                                   Style="{StaticResource PaneTitleTextStyle}"/>

                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="RefreshAssignmentsButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Height="34"
                            MinWidth="100"
                            Click="Refresh_Click"/>
                </Grid>

                <UniformGrid Grid.Row="2"
                             Rows="1"
                             Columns="4">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TicketPoolCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Ticket Pool"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding AssignedTicketCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Assigned"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding FieldCompleteCount}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Field Complete"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding BoardStatusText}"
                                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Board Status"
                                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Grid.Row="4"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ticket Pool -->
            <Border x:Name="TicketPoolCard"
                    Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Ticket Pool"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>

                        <TextBlock Text="Defaults to unassigned, non-closed tickets."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TicketPoolSearchBox"
                                 Grid.Row="0"
                                 Height="32"
                                 Style="{StaticResource ClearableSearchTextBox}"
                                 Tag="Search site, WO, notification, problem..."
                                 TextChanged="TicketPoolSearchBox_TextChanged"/>

                        <CheckBox x:Name="IncludeAssignedTicketsCheckBox"
                                  Grid.Row="2"
                                  Content="Include assigned tickets"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Checked="IncludeAssignedTickets_Changed"
                                  Unchecked="IncludeAssignedTickets_Changed"/>

                        <TextBlock Grid.Row="4"
                                   Text="{Binding TicketPoolSummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <ListBox x:Name="TicketPoolList"
                             Grid.Row="4"
                             ItemsSource="{Binding FilteredTicketPool}"
                             ItemTemplate="{StaticResource TicketCardTemplate}"
                             ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                             Style="{StaticResource CleanListBoxStyle}"
                             SelectionMode="Extended"
                             SelectionChanged="TicketPoolList_SelectionChanged"
                             PreviewMouseLeftButtonDown="TicketPoolList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TicketPoolList_PreviewMouseMove"
                             GiveFeedback="DragSource_GiveFeedback"/>
                </Grid>
            </Border>

            <!-- Crew / Technician Work List -->
            <Border x:Name="WorkListCard"
                    Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header outside the bordered work area -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Crew / Technician Work List"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="{Binding SelectedTargetSubtitle}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">

                            <Button Content="Clear List"
                                    Height="34"
                                    MinWidth="105"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding HasSelectedTargetAssignedTickets}"
                                    Click="ClearSelectedTargetList_Click"/>

                            <Button Content="Save &amp; Publish"
                                    Height="34"
                                    MinWidth="140"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding HasSelectedTarget}"
                                    Click="PublishSelectedTarget_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bordered routing/work-list area -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Crew selector + Add Selected -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="AssignmentTargetComboBox"
                                          Grid.Column="2"
                                          Height="64"
                                          Width="Auto"
                                          Padding="8,3"
                                          ItemsSource="{Binding AssignmentTargets}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource AssignmentTargetComboTemplate}"
                                          MaxDropDownHeight="340"/>

                                <Button Grid.Column="0"
                                        Content="Add Selected"
                                        Height="64"
                                        MinWidth="130"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasSelectedTickets}"
                                        Click="AddSelectedToSelectedTarget_Click"/>
                            </Grid>

                            <!-- Selected crew/tech tickets -->
                            <Grid Grid.Row="2">
                                <ListBox x:Name="AssignedTicketsList"
                                         ItemsSource="{Binding SelectedTarget.AssignedTickets}"
                                         ItemTemplate="{StaticResource AssignedTicketTemplate}"
                                         ItemContainerStyle="{StaticResource CleanListBoxItemStyle}"
                                         Style="{StaticResource CleanListBoxStyle}"
                                         SelectionMode="Single"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="AssignedTicketsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="AssignedTicketsList_PreviewMouseMove"
                                         GiveFeedback="DragSource_GiveFeedback"
                                         DragOver="AssignedTicketsList_DragOver"
                                         DragLeave="AssignedTicketsList_DragLeave"
                                         Drop="AssignedTicketsList_Drop"/>

                                <TextBlock Text="Select a crew or technician to view their work list."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedTarget}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="No tickets assigned to this crew/technician."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasSelectedTarget}" Value="True"/>
                                                        <Condition Binding="{Binding SelectedTarget.AssignedTicketCount}" Value="0"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="390"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading daily assignments..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>