<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.DailyAssignmentsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Panes"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Crew / Technician selectable card -->
        <DataTemplate x:Key="AssignmentTargetCardTemplate">
            <Border Width="218"
                    MinHeight="78"
                    Margin="0,0,6,6"
                    Padding="9"
                    CornerRadius="11">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                        <Setter Property="BorderThickness" Value="1"/>

                        <Style.Triggers>
                            <!-- Hover -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ListItemHoverBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHover}"/>
                            </DataTrigger>

                            <!-- Selected -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ListSelectedBg}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBg}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- Primary technician / first crew member -->
                    <TextBlock Text="{Binding PrimaryLine1}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis"/>

                    <!-- Second crew member -->
                    <TextBlock Text="{Binding PrimaryLine2}"
                       Margin="0,1,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryLine2}"
                                         Value="">
                                        <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Truck / title -->
                    <TextBlock Text="{Binding SecondaryText}"
                       Margin="0,3,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>

                    <!-- Publication status -->
                    <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,0">

                        <Ellipse Width="7"
                         Height="7"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center">

                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill"
                                    Value="#15803D"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoTickets}"
                                             Value="True">
                                            <Setter Property="Fill"
                                            Value="#DC2626"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding HasUnpublishedChanges}"
                                             Value="True">
                                            <Setter Property="Fill"
                                            Value="#B45309"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding ComboStatusText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                    Value="#15803D"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoTickets}"
                                             Value="True">
                                            <Setter Property="Foreground"
                                            Value="#DC2626"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding HasUnpublishedChanges}"
                                             Value="True">
                                            <Setter Property="Foreground"
                                            Value="#B45309"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Ticket Card Template (LEFT) -->
        <DataTemplate x:Key="TicketCardTemplate">
            <Border Style="{StaticResource TicketCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsSelected,
                                          RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                          Mode=TwoWay}"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TOP: Site left / Notification Name right -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="{Binding Site}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2"
                               Text="{Binding NotificationName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NotificationName}"/>
                        </Grid>

                        <!-- BOTTOM: Problem left / Status right -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                               Text="{Binding Problem}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Problem}"/>

                            <TextBlock Grid.Column="2"
                               Text="{Binding Status}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Assigned / Route Ticket Card -->
        <DataTemplate x:Key="AssignedTicketTemplate">
            <Border Style="{StaticResource TicketCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>

                    <!-- Route position -->
                    <TextBlock Grid.Column="0"
                       Margin="0,1,8,0"
                       Text="{Binding SortOrder, StringFormat={}{0}.}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Top"
                       TextAlignment="Right"/>

                    <!-- Site / Problem -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="{Binding Site}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="2"
                           Text="{Binding Problem}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Problem}"/>
                    </Grid>

                    <!-- Notification / WO information -->
                    <Grid Grid.Column="2"
                  Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="{Binding NotificationName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding NotificationName}"/>

                        <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                            <TextBlock Text="{Binding WorkOrder}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text=" · "
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                        Value="Visible"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkOrder}"
                                                 Value="">
                                                <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding WorkOrderClass}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text=" · "
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock Text="{Binding Status}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Route actions -->
                    <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">

                        <Button Width="28"
                        Height="28"
                        Margin="0,0,2,0"
                        Style="{StaticResource TransparentIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="Move up"
                        Click="MoveAssignedTicketUp_Click">
                            <TextBlock Text="▲"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"/>
                        </Button>

                        <Button Width="28"
                                Height="28"
                                Margin="0,0,2,0"
                                Style="{StaticResource TransparentIconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="Move down"
                                Click="MoveAssignedTicketDown_Click">
                            <TextBlock Text="▼"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Button>

                        <Button Width="28"
                                Height="28"
                                Style="{StaticResource TransparentIconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="Remove from assignment"
                                Click="RemoveAssignedTicket_Click">
                            <Viewbox Width="13"
                             Height="13">
                                <Path Style="{StaticResource TrashCanIconPathStyle}"/>
                            </Viewbox>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Floating ticket card shown while dragging -->
        <DataTemplate x:Key="DragGhostTicketTemplate">
            <Border Width="390"
            Padding="12"
            CornerRadius="12"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource PrimaryBg}"
            BorderThickness="2"
            Opacity="0.93">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Ticket.Site}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">

                            <Border Padding="7,2"
                            Margin="0,0,8,0"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1">
                                <TextBlock Text="{Binding Ticket.Status}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                            </Border>

                            <Border Padding="7,2"
                            CornerRadius="10"
                            Background="{DynamicResource PrimaryBg}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdditionalCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding AdditionalCountText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2"
                       Text="{Binding Ticket.NotificationName}"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4"
                       Text="{Binding Ticket.Problem}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       MaxHeight="36"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Daily Assignments"
                                   Style="{StaticResource PaneTitleTextStyle}"/>

                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource PaneSubtitleTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="RefreshAssignmentsButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Height="34"
                            MinWidth="100"
                            Click="Refresh_Click"/>
                </Grid>

                <ListBox x:Name="AssignmentTargetListBox"
                         Grid.Row="2"
                         MaxHeight="190"
                         ItemsSource="{Binding AssignmentTargets}"
                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                         ItemTemplate="{StaticResource AssignmentTargetCardTemplate}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
                            <Setter Property="Background"
                    Value="Transparent"/>
                            <Setter Property="BorderThickness"
                    Value="0"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Grid.Row="4"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="680"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ticket Pool -->
            <Border x:Name="TicketPoolCard"
                    Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Ticket Pool"
                                       Style="{StaticResource SectionHeaderTextStyle}"/>

                            <TextBlock Text="Defaults to unassigned, non-closed tickets."
                                       Margin="0,4,0,0"
                                       Style="{StaticResource PaneSubtitleTextStyle}"/>
                        </StackPanel>

                        <Button x:Name="NewTicketButton"
                                Grid.Column="1"
                                Content="New Ticket"
                                Height="34"
                                MinWidth="100"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Top"
                                Click="NewTicket_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TicketPoolSearchBox"
                                 Grid.Row="0"
                                 Height="32"
                                 Style="{StaticResource ClearableSearchTextBox}"
                                 Tag="Search site, WO, notification, problem..."
                                 TextChanged="TicketPoolSearchBox_TextChanged"/>

                        <CheckBox x:Name="IncludeAssignedTicketsCheckBox"
                                  Grid.Row="2"
                                  Content="Include assigned tickets"
                                  Foreground="{DynamicResource TextPrimary}"
                                  Checked="IncludeAssignedTickets_Changed"
                                  Unchecked="IncludeAssignedTickets_Changed"/>

                        <TextBlock Grid.Row="4"
                                   Text="{Binding TicketPoolSummaryText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>

                    <ListBox x:Name="TicketPoolList"
                             Grid.Row="4"
                             ItemsSource="{Binding FilteredTicketPool}"
                             ItemTemplate="{StaticResource TicketCardTemplate}"
                             Style="{StaticResource CleanListBoxStyle}"
                             SelectionMode="Extended"
                             SelectionChanged="TicketPoolList_SelectionChanged"
                             MouseDoubleClick="TicketPoolList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="TicketPoolList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TicketPoolList_PreviewMouseMove"
                             GiveFeedback="DragSource_GiveFeedback">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource CleanListBoxItemStyle}">
                                <Setter Property="Margin"
                                        Value="0,0,0,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Crew / Technician Work List -->
            <Border x:Name="WorkListCard"
                    Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header outside the bordered work area -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Selected Tech / Crew + assignment status -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedTargetHeaderText}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Same status indicator used by the Tech/Crew cards -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility"
                            Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedTarget}"
                                     Value="False">
                                                    <Setter Property="Visibility"
                                    Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center">

                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill"
                                Value="#15803D"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTarget.HasNoTickets}"
                                         Value="True">
                                                        <Setter Property="Fill"
                                        Value="#DC2626"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding SelectedTarget.HasUnpublishedChanges}"
                                         Value="True">
                                                        <Setter Property="Fill"
                                        Value="#B45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Text="{Binding SelectedTarget.ComboStatusText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                Value="#15803D"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTarget.HasNoTickets}"
                                         Value="True">
                                                        <Setter Property="Foreground"
                                        Value="#DC2626"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding SelectedTarget.HasUnpublishedChanges}"
                                         Value="True">
                                                        <Setter Property="Foreground"
                                        Value="#B45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding SelectedTargetContextText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">

                            <Button Content="Add Selected"
                                    Height="34"
                                    MinWidth="115"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding HasSelectedTickets}"
                                    Click="AddSelectedToSelectedTarget_Click"/>

                            <Button Content="Clear List"
                                    Height="34"
                                    MinWidth="105"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding HasSelectedTargetAssignedTickets}"
                                    Click="ClearSelectedTargetList_Click"/>

                            <Button Content="Save &amp; Publish"
                                    Height="34"
                                    MinWidth="140"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding HasSelectedTarget}"
                                    Click="PublishSelectedTarget_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bordered routing/work-list area -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14"
                            VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Selected crew/tech tickets -->
                            <Grid Grid.Row="0">
                                <ListBox x:Name="AssignedTicketsList"
                                         ItemsSource="{Binding SelectedTarget.AssignedTickets}"
                                         ItemTemplate="{StaticResource AssignedTicketTemplate}"
                                         Style="{StaticResource CleanListBoxStyle}"
                                         SelectionMode="Single"
                                         AllowDrop="True"
                                         MouseDoubleClick="TicketPoolList_MouseDoubleClick"
                                         PreviewMouseLeftButtonDown="AssignedTicketsList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="AssignedTicketsList_PreviewMouseMove"
                                         GiveFeedback="DragSource_GiveFeedback"
                                         DragOver="AssignedTicketsList_DragOver"
                                         DragLeave="AssignedTicketsList_DragLeave"
                                         Drop="AssignedTicketsList_Drop">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource CleanListBoxItemStyle}">
                                            <Setter Property="Margin"
                                                    Value="0,0,0,4"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <TextBlock Text="Select a crew or technician to view their work list."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedTarget}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="No tickets assigned to this crew/technician."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasSelectedTarget}" Value="True"/>
                                                        <Condition Binding="{Binding SelectedTarget.AssignedTicketCount}" Value="0"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="390"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading daily assignments..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>