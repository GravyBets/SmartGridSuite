<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TicketsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- Mini copy button -->
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
        </Style>

        <!-- Copy glyph -->
        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Single-line trimmed -->
        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Maint/Cap badge -->
        <Style x:Key="WoBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Tickets"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Site visits / service events tied to notifications. Never delete—close for history."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: main filter strip -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernWatermarkTextBox}"
                         Tag="Search site, notification, WO, tech, summary…"
                         Height="34"
                         TextChanged="SearchBox_TextChanged"/>

                <!-- Date Range -->
                <ComboBox x:Name="DateRangeFilter"
                          Grid.Column="2"
                          Height="34"
                          SelectionChanged="Filters_SelectionChanged"/>

                <!-- Status -->
                <ComboBox x:Name="StatusFilter"
                          Grid.Column="4"
                          Height="34"
                          SelectionChanged="Filters_SelectionChanged"/>

                <!-- Tech -->
                <ComboBox x:Name="TechFilter"
                          Grid.Column="6"
                          Height="34"
                          SelectionChanged="Filters_SelectionChanged"/>

                <Button Grid.Column="8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="34"
                        Padding="14,0"
                        MinWidth="110"
                        Content="Refresh"
                        Click="Refresh_Click"/>

                <Button Grid.Column="10"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="34"
                        Padding="14,0"
                        MinWidth="120"
                        Content="New Ticket"
                        Click="NewTicket_Click"/>
            </Grid>

            <!-- Row 1: Custom date pickers (only when DateRange = Custom) -->
            <Border Grid.Row="1"
                    x:Name="CustomDatePanel"
                    Margin="0,10,0,0"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="From"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <DatePicker x:Name="FromDatePicker"
                                Grid.Column="1"
                                SelectedDateChanged="CustomDate_SelectedDateChanged"/>

                    <TextBlock Grid.Column="3"
                               Text="To"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <DatePicker x:Name="ToDatePicker"
                                Grid.Column="4"
                                SelectedDateChanged="CustomDate_SelectedDateChanged"/>

                    <TextBlock Grid.Column="5"
                               Text="(Filters by Last Activity date)"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Body: list + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="DetailsCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Tickets grid -->
            <DataGrid Grid.Column="0"
                      x:Name="TicketsGrid"
                      Style="{StaticResource ThemedDataGridStyle}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="TicketsGrid_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Last"
                                        Width="120"
                                        Binding="{Binding LastActivityAt, StringFormat={}{0:MM/dd HH:mm}}"/>

                    <DataGridTextColumn Header="Site"
                                        Width="120"
                                        Binding="{Binding Site}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <DataGridTextColumn Header="Notification Name"
                                        Width="160"
                                        Binding="{Binding NotificationName}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <!-- Notification + copy -->
                    <DataGridTemplateColumn Header="Notification" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource MiniIconButton}"
                                            ToolTip="Copy Notification"
                                            Tag="{Binding Notification}"
                                            Click="CopyNotification_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}"/>
                                    </Button>

                                    <TextBlock Text="{Binding Notification}"
                                               Style="{StaticResource TrimCellText}"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Work Order + Maint/Cap + copy -->
                    <DataGridTemplateColumn Header="Work Order" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">

                                    <Button DockPanel.Dock="Right"
                                            ToolTip="Copy Work Order"
                                            Tag="{Binding CurrentWorkOrder}"
                                            Click="CopyWorkOrder_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Style="{StaticResource CopyGlyph}"/>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentWorkOrder}"
                                                   Style="{StaticResource TrimCellText}"/>

                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource WoBadge}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding WorkOrderClassLabel}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type"
                                        Width="80"
                                        Binding="{Binding GroupCode}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <DataGridTextColumn Header="Pri"
                                        Width="60"
                                        Binding="{Binding PriorityLabel}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <DataGridTextColumn Header="Status"
                                        Width="130"
                                        Binding="{Binding Status}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <DataGridTextColumn Header="Tech"
                                        Width="150"
                                        Binding="{Binding AssignedTech}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                    <DataGridTextColumn Header="Problem / Issue"
                                        Width="*"
                                        Binding="{Binding Problem}"
                                        ElementStyle="{StaticResource TrimCellText}"/>

                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <!-- Details panel -->
            <Border Grid.Column="2"
                    x:Name="DetailsPanel"
                    Style="{StaticResource Card}"
                    Padding="14"
                    Visibility="Collapsed">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTicket.Site}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextPrimary}"/>                            
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="10,0,0,0"
                                ToolTip="Close details"
                                Click="CloseDetails_Click"
                                Background="Transparent"
                                BorderThickness="0">
                            <TextBlock Text="✕"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Key fields -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Problem/Issue -->
                            <RowDefinition Height="Auto"/>
                            <!-- Notification Name -->
                            <RowDefinition Height="Auto"/>
                            <!-- Notification # -->
                            <RowDefinition Height="Auto"/>
                            <!-- Work Order -->
                            <RowDefinition Height="Auto"/>
                            <!-- Work Order Type -->
                            <RowDefinition Height="Auto"/>
                            <!-- Work Order Code -->
                            <RowDefinition Height="Auto"/>
                            <!-- Priority -->
                            <RowDefinition Height="Auto"/>
                            <!-- Created By -->
                            <RowDefinition Height="Auto"/>
                            <!-- Created -->
                            <RowDefinition Height="Auto"/>
                            <!-- Last Activity -->
                        </Grid.RowDefinitions>

                        <!-- Problem/Issue -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Problem/Issue"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedTicket.Problem}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>

                        <!-- Notification Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Notification Name"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedTicket.NotificationName}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Notification # (copy) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Notification"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,0">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource MiniIconButton}"
                                    ToolTip="Copy Notification"
                                    Tag="{Binding SelectedTicket.Notification}"
                                    VerticalAlignment="Top"                                    
                                    Click="CopyNotification_Click">
                                <TextBlock Style="{StaticResource CopyGlyph}"/>
                            </Button>
                            <TextBlock Text="{Binding SelectedTicket.Notification}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Top"/>
                        </DockPanel>

                        <!-- Work Order (copy) - NO badge/tag here -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Work Order"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,-4,0,8"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,-4,0,0">
                            <Button DockPanel.Dock="Right"                                    
                                    ToolTip="Copy Work Order"
                                    Tag="{Binding SelectedTicket.CurrentWorkOrder}"
                                    VerticalAlignment="Top"
                                    Click="CopyWorkOrder_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTicket.CurrentWorkOrder}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource CopyGlyph}"
                                           VerticalAlignment="Top"/>
                            </Button>

                            <TextBlock Text="{Binding SelectedTicket.CurrentWorkOrder}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Top"/>
                        </DockPanel>

                        <!-- Work Order Type (show label only) -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Work Order Type"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding SelectedTicket.WorkOrderClassLabel}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Work Order Code -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Work Order Code"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{Binding SelectedTicket.GroupCode}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Priority -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Priority"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Grid.Column="1"
                                   Text="{Binding SelectedTicket.PriorityLabel}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Created By -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Created By"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Grid.Column="1"
                                   Text="{Binding SelectedTicket.CreatedBy}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Created -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Created"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="8" Grid.Column="1"
                                   Text="{Binding SelectedTicket.CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Last Activity -->
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Last Activity"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Row="9" Grid.Column="1"
                                   Text="{Binding SelectedTicket.LastActivityAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Grid>

                    <!-- Notes/actions -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">

                        <DockPanel LastChildFill="True">

                            <!-- Buttons (3 only) -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="Assign Tech"
                                        Margin="0,0,8,0"
                                        Height="30"
                                        Padding="10,0"
                                        Click="AssignTech_Click"/>

                                <Button Content="Add Note"
                                        Margin="0,0,8,0"
                                        Height="30"
                                        Padding="10,0"
                                        Click="AddNote_Click"/>

                                <Button Content="Edit Ticket"
                                        Height="30"
                                        Padding="10,0"
                                        Click="EditTicket_Click"/>
                            </StackPanel>

                            <TextBlock Margin="0,12,0,6"
                                       Text="Notes"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBox Text="{Binding SelectedTicket.Notes}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextSecondary}"
                                     VerticalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>