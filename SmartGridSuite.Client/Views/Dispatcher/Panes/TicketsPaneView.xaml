<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TicketsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FilterLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DetailLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="DetailCopyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="SummaryValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StatusCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TicketsGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TicketDetailLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="TicketDetailValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TicketDetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top card -->
        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tickets"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Queue, filtering, and service history"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">

                <Button x:Name="RefreshTicketsButton"
                        Content="Refresh"
                        Width="96"
                        Margin="0,0,4,0"
                        Click="Refresh_Click"/>

                <Button x:Name="ImportSapQueueButton"
                        Content="Import SAP Queue"
                        Margin="0,0,4,0"
                        Click="ImportSapQueue_Click"/>

                <Button x:Name="NewTicketButton"
                        Content="New Ticket"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="96"
                        Click="NewTicket_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="170"/>

                <ColumnDefinition x:Name="CustomFromSpacerCol" Width="0"/>
                <ColumnDefinition x:Name="CustomFromCol" Width="0"/>
                <ColumnDefinition x:Name="CustomToSpacerCol" Width="0"/>
                <ColumnDefinition x:Name="CustomToCol" Width="0"/>

                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Labels -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Search"
                       Style="{StaticResource FilterLabelText}"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Date Type"
                       Style="{StaticResource FilterLabelText}"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="4"
                       Grid.ColumnSpan="5"
                       Text="Date Range"
                       Style="{StaticResource FilterLabelText}"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="10"
                       Text="Status Filter"
                       Style="{StaticResource FilterLabelText}"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="12"
                       Text="Tech"
                       Style="{StaticResource FilterLabelText}"/>

            <!-- Controls -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="2"
                     Grid.Column="0"
                     Style="{StaticResource ClearableSearchTextBox}"
                     Tag="Search site, Notification, WO, Tech, Notes, Serial #..."
                     Height="36"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="DateFieldFilter"
                      Grid.Row="2"
                      Grid.Column="2"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Filters_SelectionChanged"/>

            <ComboBox x:Name="DateRangeFilter"
                      Grid.Row="2"
                      Grid.Column="4"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Filters_SelectionChanged"/>

            <DatePicker x:Name="FromDatePicker"
                        Grid.Row="2"
                        Grid.Column="6"
                        Style="{DynamicResource ModernDatePicker}"
                        Height="36"
                        Width="Auto"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

            <DatePicker x:Name="ToDatePicker"
                        Grid.Row="2"
                        Grid.Column="8"
                        Style="{DynamicResource ModernDatePicker}"
                        Height="36"
                        Width="Auto"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

            <Grid Grid.Row="2"
                  Grid.Column="10">
                <Button x:Name="StatusFilterButton"
                        Height="36"
                        Padding="12,0"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="StatusFilterButton_Click"
                        ToolTip="Choose which ticket statuses are shown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Filter Statuses"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SelectedStatusesSummary}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="▾"
                                   Margin="10,0,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Popup x:Name="StatusPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=StatusFilterButton}"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Width="300">
                        <StackPanel>

                            <TextBlock Text="Filter Tickets by Status"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="Choose the statuses you want visible. Changes apply when you click OK. Closed is excluded by default."
                                       Margin="0,3,0,10"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <Border Padding="10"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBg}">
                                <ItemsControl ItemsSource="{Binding StatusOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource StatusCheckBoxStyle}"
                                                      Checked="StatusOption_Changed"
                                                      Unchecked="StatusOption_Changed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Height="1"
                                    Margin="0,12,0,10"
                                    Background="{DynamicResource CardBorder}"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Staged selection summary -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding StagedStatusesSummary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <!-- Actions -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="ToggleAllStatusesButton"
                                            Grid.Column="0"
                                            Content="Select All"
                                            Height="30"
                                            MinWidth="86"
                                            Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ToggleAllStatuses_Click"/>

                                    <Button Grid.Column="2"
                                            Content="Cancel"
                                            Height="30"
                                            MinWidth="76"
                                            Padding="10,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CancelStatusFilter_Click"/>

                                    <Button Grid.Column="4"
                                            Content="OK"
                                            Height="30"
                                            MinWidth="70"
                                            Padding="10,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ConfirmStatusFilter_Click"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <ComboBox x:Name="TechFilter"
                      Grid.Row="2"
                      Grid.Column="12"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="Filters_SelectionChanged"/>

            <Button x:Name="ClearTicketsFiltersButton"
                    Grid.Row="2"
                    Grid.Column="14"
                    Content="Clear Filters"
                    Height="36"
                    Padding="14,0"
                    Click="ClearFilters_Click"/>
        </Grid>

        <!-- Summary panel -->
        <Border Grid.Row="4"
                x:Name="SummaryPanel"
                Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,12"
                Visibility="Visible">

            <ItemsControl ItemsSource="{Binding SummaryStatuses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SummaryCardStyle}"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Count}"
                                           Style="{StaticResource SummaryValueTextStyle}"/>

                                <TextBlock Text="{Binding Status}"
                                           Style="{StaticResource SummaryLabelTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Main workspace -->
        <Border Grid.Row="5"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailsSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="DetailsCol" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Ticket list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="True">

                        <!-- Actions -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="CopySelectedWorkOrdersButton"
                                    Content="Copy WOs"
                                    Height="30"
                                    Width="92"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Copy selected Work Orders as a vertical list for Excel"
                                    Click="CopySelectedWorkOrders_Click"/>

                            <Button x:Name="AssignSelectedButton"
                                    Content="Assign Selected"
                                    Height="30"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Click="AssignSelected_Click"/>

                            <Button x:Name="BulkSetProblemButton"
                                    Content="Set Problem"
                                    Height="30"
                                    Width="108"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BulkSetProblem_Click"/>

                            <Button x:Name="BulkSetWorkOrderTypeButton"
                                    Content="Set WO Type"
                                    Height="30"
                                    Width="116"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BulkSetWorkOrderType_Click"/>

                            <Button x:Name="BulkSetStatusButton"
                                    Content="Set Status"
                                    Height="30"
                                    Width="104"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BulkSetStatus_Click"/>

                            <Button x:Name="OpenDetailsButton"
                                    Content="Open Details"
                                    Height="30"
                                    Width="96"
                                    Padding="12,0"
                                    Margin="0,0,4,0"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenDetails_Click"/>

                            <Button x:Name="EditSelectedTicketButton"
                                    Content="Edit Ticket"
                                    Height="30"
                                    Width="84"
                                    Padding="12,0"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="EditSelectedTicket_Click"/>
                        </StackPanel>

                        <!-- Title / quick filter / status -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Quick Filter"
                                       Margin="2,0,6,0"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="QuickFilterComboBox"
                                      Width="170"
                                      Height="30"
                                      MinWidth="0"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="QuickFilterComboBox_SelectionChanged"/>

                            <Border x:Name="MissingProblemsBadge"
                                    Margin="10,0,0,0"
                                    Padding="8,3"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="MissingProblemsBadgeText"
                                           Text="Quick Filter"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock x:Name="SelectedCountTextBlock"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="TicketsGrid"
                              Style="{StaticResource ThemedDataGridStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              RowHeight="34"
                              MinRowHeight="34"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                              ColumnHeaderStyle="{StaticResource TicketsGridColumnHeaderStyle}"
                              SelectionChanged="TicketsGrid_SelectionChanged"
                              MouseDoubleClick="TicketsGrid_MouseDoubleClick">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="42"
                                                    CanUserResize="False"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="HeaderSelectAllCheckBox"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Select or clear all showing tickets"
                                              Click="HeaderSelectAllCheckBox_Click"/>
                                </DataGridTemplateColumn.Header>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsSelected,
                                                                      RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}"
                                                  PreviewMouseLeftButtonDown="TicketRowCheckBox_PreviewMouseLeftButtonDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Site"
                                                Width="105"
                                                Binding="{Binding Site}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Notification Name"
                                                Width="2*"
                                                Binding="{Binding NotificationName}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Problem / Issue"
                                                Width="2*"
                                                Binding="{Binding Problem}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTemplateColumn Header="Notification"
                                                    Width="128">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Notification}"
                                                       Style="{StaticResource TrimCellText}"/>

                                            <Button Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="4,0,0,0"
                                                    Tag="{Binding Notification}"
                                                    ToolTip="Copy notification"
                                                    Click="CopyGridValue_Click">

                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Notification}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding Notification}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                           FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Work Order"
                                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding CurrentWorkOrder}"
                                                       Style="{StaticResource TrimCellText}"/>

                                            <Button Grid.Column="1"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="4,0,0,0"
                                                    Tag="{Binding CurrentWorkOrder}"
                                                    ToolTip="Copy work order"
                                                    Click="CopyGridValue_Click">

                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource FlatCopyIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock Style="{StaticResource CopyGlyph}"
                                                           FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="WO Type"
                                                Width="105"
                                                Binding="{Binding WorkOrderType}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Status"
                                                Width="115"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Tech"
                                                Width="140"
                                                Binding="{Binding AssignedTech}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Created"
                                                Width="95"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd/yyyy}}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Last Activity"
                                                Width="132"
                                                Binding="{Binding LastActivityAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding TicketPageSummary}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">

                            <Button x:Name="PreviousTicketPageButton"
                                    Content="Previous"
                                    Height="30"
                                    MinWidth="90"
                                    Margin="0,0,4,0"
                                    IsEnabled="{Binding CanGoToPreviousTicketPage}"
                                    Click="PreviousTicketPage_Click"/>

                            <Button x:Name="NextTicketPageButton"
                                    Content="Next"
                                    Height="30"
                                    MinWidth="90"
                                    IsEnabled="{Binding CanGoToNextTicketPage}"
                                    Click="NextTicketPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <GridSplitter x:Name="DetailsSplitter"
                              Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True"
                              Visibility="Collapsed"/>

                <!-- Details inspector -->
                <Border Grid.Column="2"
                        x:Name="DetailsPanel"
                        Style="{StaticResource Card}"
                        Padding="14"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTicket.Site, TargetNullValue=Ticket Details}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Border Padding="8,3"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBg}"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedTicket.Status}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Padding="8,3"
                                            CornerRadius="10"
                                            Background="{DynamicResource SurfaceBg}"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedTicket.AssignedTech}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    ToolTip="Close details"
                                    Click="CloseDetails_Click"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <TextBlock Text="✕"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Main info card -->
                        <Border Grid.Row="2"
                                Style="{StaticResource TicketDetailSectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- LEFT 1: Notification Name -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Notification Name"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.NotificationName}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 1: Problem / Issue -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Problem / Issue"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.Problem}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- LEFT 2: Notification -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Notification"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.Notification}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 2: Work Order -->
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Work Order"
                                               Style="{StaticResource TicketDetailLabelText}"/>

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedTicket.CurrentWorkOrder}"
                                                   Style="{StaticResource TicketDetailValueText}"
                                                   VerticalAlignment="Center"/>

                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Margin" Value="8,0,0,0"/>
                                                    <Setter Property="Padding" Value="8,3"/>
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTicket.CurrentWorkOrder}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTicket.CurrentWorkOrder}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTicket.WorkOrderClassLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTicket.WorkOrderClassLabel}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding SelectedTicket.WorkOrderClassLabel}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- LEFT 3: Task Category -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Task Category"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.TaskCategoryName}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 3: Action Required -->
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="Action Required"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.ActionRequiredOverride}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- LEFT 4: Last Activity -->
                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="Last Activity"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicket.LastActivityAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>

                                <!-- RIGHT 4: Created By -->
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="Created By"
                                               Style="{StaticResource TicketDetailLabelText}"/>
                                    <TextBlock Text="{Binding SelectedTicketCreatedByDisplay}"
                                               Style="{StaticResource TicketDetailValueText}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Collapsible note sections -->
                        <ScrollViewer Grid.Row="4"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- Site Notes -->
                                <Expander x:Name="SiteNotesExpander"
                                          IsExpanded="False"
                                          Expanded="TicketDetailExpander_ExpandedChanged"
                                          Collapsed="TicketDetailExpander_ExpandedChanged">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Site Notes"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>

                                            <Border Margin="8,0,0,0"
                                                    MinWidth="17"
                                                    Height="17"
                                                    Padding="4,0"
                                                    CornerRadius="11"
                                                    Background="#D92D20"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedTicketSiteNotesCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding SelectedTicketSiteNotesCount}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    
                                    <Border Style="{StaticResource TicketDetailSectionCard}"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Reusable notes tied to this site."
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1"
                                                        Content="+ Add"
                                                        Height="28"
                                                        Width="60"
                                                        Padding="12,0"
                                                        Click="AddSelectedTicketSiteNote_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanEditSelectedTicket}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding SelectedTicketSiteNotes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="10"
                                                                CornerRadius="10"
                                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                                BorderThickness="1"
                                                                Background="{DynamicResource SurfaceBg}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="8"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="8"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Text="{Binding NoteText}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextPrimary}"/>

                                                                <TextBlock Grid.Row="2"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondary}">
                                                                    <Run Text="Created by "/>
                                                                    <Run Text="{Binding CreatedBy}"/>
                                                                    <Run Text=" on "/>
                                                                    <Run Text="{Binding CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"/>
                                                                </TextBlock>

                                                                <StackPanel Grid.Row="4"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.CanEditSelectedTicket, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>

                                                                    <Button Content="Edit"
                                                                            Height="24"
                                                                            Width="48"
                                                                            Padding="8,0"
                                                                            Margin="0,0,6,0"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Click="EditSelectedTicketSiteNote_Click"/>

                                                                    <Button Content="Delete"
                                                                            Height="24"
                                                                            Padding="8,0"
                                                                            Tag="{Binding}"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Click="DeleteSelectedTicketSiteNote_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Dispatch Notes -->
                                <Expander x:Name="DispatchNotesExpander"
                                          Header="Dispatch Notes"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontWeight="Bold"
                                          IsExpanded="False"
                                          Margin="0,10,0,0"
                                          Expanded="TicketDetailExpander_ExpandedChanged"
                                          Collapsed="TicketDetailExpander_ExpandedChanged">
                                    <Border Style="{StaticResource TicketDetailSectionCard}"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="Notes for remote troubleshooting, follow-up instructions, or things dispatch wants checked."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"/>

                                            <Border Grid.Row="2"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    Background="{DynamicResource SurfaceBg}">

                                                <TextBox x:Name="DetailsDispatchNotesTextBox"
                                                         Style="{x:Null}"
                                                         Text="{Binding SelectedTicket.DispatchNotes, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="{Binding IsSelectedTicketClosed}"
                                                         VerticalContentAlignment="Top"
                                                         HorizontalContentAlignment="Left"
                                                         VerticalAlignment="Stretch"
                                                         HorizontalAlignment="Stretch"
                                                         MinHeight="160"
                                                         MaxHeight="328"
                                                         Padding="10"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         TextChanged="DetailsDispatchNotesTextBox_TextChanged"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <!-- Tech Write-Ups -->
                                <Expander x:Name="TechWriteUpsExpander"
                                          Header="Tech Write-Ups"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontWeight="Bold"
                                          IsExpanded="False"
                                          Margin="0,10,0,0"
                                          Expanded="TicketDetailExpander_ExpandedChanged"
                                          Collapsed="TicketDetailExpander_ExpandedChanged">
                                    <Border Style="{StaticResource TicketDetailSectionCard}"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="Technician write-up and ticket notes."
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondary}"/>

                                            <Border Grid.Row="2"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    Background="{DynamicResource SurfaceBg}">

                                                <TextBox x:Name="DetailsTechWriteUpsTextBox"
                                                         Style="{x:Null}"
                                                         Text="{Binding SelectedTicket.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         IsReadOnly="{Binding IsSelectedTicketClosed}"
                                                         VerticalContentAlignment="Top"
                                                         HorizontalContentAlignment="Left"
                                                         VerticalAlignment="Stretch"
                                                         HorizontalAlignment="Stretch"
                                                         MinHeight="160"
                                                         MaxHeight="342"
                                                         Padding="10"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         TextChanged="DetailsTechWriteUpsTextBox_TextChanged"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedTicketClosedLockText}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="EditTicketButton"
                                        Content="Edit"
                                        Height="32"
                                        MinWidth="80"
                                        Margin="2,0,4,0"
                                        Click="EditTicket_Click"/>

                                <Button x:Name="SaveTicketButton"
                                        Content="Save Notes"
                                        Height="32"
                                        MinWidth="110"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveDetails_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="6"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="380"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading tickets..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>