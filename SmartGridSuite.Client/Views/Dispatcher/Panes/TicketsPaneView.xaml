<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TicketsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
        </Style>

        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WoBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DetailLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Combined header + filters card -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>                    
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tickets"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Site visits / service events tied to notifications. Never delete—close for history."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                MinWidth="105"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                Content="Refresh"
                                Click="Refresh_Click"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="34"
                                MinWidth="145"
                                Padding="14,0"
                                Margin="0,0,10,0"
                                Content="Import SAP Queue"
                                Click="ImportSapQueue_Click"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Height="34"
                                MinWidth="120"
                                Padding="14,0"
                                Content="New Ticket"
                                Click="NewTicket_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Filter labels -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition x:Name="InlineDateSpacer1Col" Width="0"/>
                        <ColumnDefinition x:Name="InlineFromCol" Width="0"/>
                        <ColumnDefinition x:Name="InlineDateSpacer2Col" Width="0"/>
                        <ColumnDefinition x:Name="InlineToCol" Width="0"/>
                        <ColumnDefinition x:Name="InlineDateSpacer3Col" Width="0"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Search"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock Grid.Column="2"
                               Text="Date Range"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock x:Name="FromDateLabel"
                               Grid.Column="4"
                               Text="From"
                               Style="{StaticResource FilterLabelText}"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="ToDateLabel"
                               Grid.Column="6"
                               Text="To"
                               Style="{StaticResource FilterLabelText}"
                               Visibility="Collapsed"/>

                    <TextBlock Grid.Column="8"
                               Text="Status"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock Grid.Column="10"
                               Text="Tech"
                               Style="{StaticResource FilterLabelText}"/>
                </Grid>

                <!-- Filters -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition x:Name="InlineDateSpacer1Col2" Width="0"/>
                        <ColumnDefinition x:Name="InlineFromCol2" Width="0"/>
                        <ColumnDefinition x:Name="InlineDateSpacer2Col2" Width="0"/>
                        <ColumnDefinition x:Name="InlineToCol2" Width="0"/>
                        <ColumnDefinition x:Name="InlineDateSpacer3Col2" Width="0"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Tag="Search site, notification, WO, tech, notes, serial..."
                             Height="36"
                             TextChanged="SearchBox_TextChanged"/>

                    <ComboBox x:Name="DateRangeFilter"
                              Grid.Column="2"
                              Height="36"
                              SelectionChanged="Filters_SelectionChanged"/>

                    <DatePicker x:Name="FromDatePicker"
                                Style="{DynamicResource ModernDatePicker}"
                                Grid.Column="4"
                                Height="36"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

                    <DatePicker x:Name="ToDatePicker"
                                Style="{DynamicResource ModernDatePicker}"
                                Grid.Column="6"
                                Height="36"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

                    <ComboBox x:Name="StatusFilter"
                              Grid.Column="8"
                              Height="36"
                              SelectionChanged="Filters_SelectionChanged"/>

                    <ComboBox x:Name="TechFilter"
                              Grid.Column="10"
                              Height="36"
                              SelectionChanged="Filters_SelectionChanged"/>
                </Grid>

                
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailsSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="DetailsCol" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Ticket list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Ticket List"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="Select a ticket to view details"
                                   Foreground="{DynamicResource TextSecondary}"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="TicketsGrid"
                              Style="{StaticResource ThemedDataGridStyle}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="TicketsGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Last Activity"
                                                Width="130"
                                                Binding="{Binding LastActivityAt, StringFormat={}{0:MM/dd/yy HH:mm}}"/>

                            <DataGridTextColumn Header="Site"
                                                Width="110"
                                                Binding="{Binding Site}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTemplateColumn Header="Notification" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource MiniIconButton}"
                                                    ToolTip="Copy Notification"
                                                    Tag="{Binding Notification}"
                                                    Click="CopyNotification_Click">
                                                <TextBlock Style="{StaticResource CopyGlyph}"/>
                                            </Button>

                                            <TextBlock Text="{Binding Notification}"
                                                       Style="{StaticResource TrimCellText}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Work Order" Width="235">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">

                                            <Button DockPanel.Dock="Right"
                                                    ToolTip="Copy Work Order"
                                                    Tag="{Binding CurrentWorkOrder}"
                                                    Click="CopyWorkOrder_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Style="{StaticResource CopyGlyph}"/>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentWorkOrder}"
                                                           Style="{StaticResource TrimCellText}"/>

                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource WoBadge}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding WorkOrderClassLabel}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Status"
                                                Width="130"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Tech"
                                                Width="150"
                                                Binding="{Binding AssignedTech}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Problem / Issue"
                                                Width="*"
                                                Binding="{Binding Problem}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter x:Name="DetailsSplitter"
                              Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True"
                              Visibility="Collapsed"/>

                <!-- Details inspector -->
                <Border Grid.Column="2"
                        x:Name="DetailsPanel"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Ticket Details"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBlock Text="{Binding SelectedTicket.Site}"
                                           Margin="0,2,0,0"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    ToolTip="Close details"
                                    Click="CloseDetails_Click"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <TextBlock Text="✕"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Content="Assign Tech"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Click="AssignTech_Click"/>

                            <Button Content="Add Note"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Click="AddNote_Click"/>

                            <Button Content="Edit Ticket"
                                    Height="32"
                                    Padding="12,0"
                                    Click="EditTicket_Click"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="4"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Ticket Information"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Problem / Issue"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding SelectedTicket.Problem}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Notification Name"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SelectedTicket.NotificationName}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="Notification"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource MiniIconButton}"
                                                ToolTip="Copy Notification"
                                                Tag="{Binding SelectedTicket.Notification}"
                                                Click="CopyNotification_Click">
                                            <TextBlock Style="{StaticResource CopyGlyph}"/>
                                        </Button>

                                        <TextBlock Text="{Binding SelectedTicket.Notification}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="Work Order"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                                        <Button DockPanel.Dock="Right"
                                                ToolTip="Copy Work Order"
                                                Tag="{Binding SelectedTicket.CurrentWorkOrder}"
                                                Click="CopyWorkOrder_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTicket.CurrentWorkOrder}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Style="{StaticResource CopyGlyph}"/>
                                        </Button>

                                        <TextBlock Text="{Binding SelectedTicket.CurrentWorkOrder}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="Work Order Type"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding SelectedTicket.WorkOrderClassLabel}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                               Text="Work Order Code"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               Text="{Binding SelectedTicket.GroupCode}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Text="Priority"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               Text="{Binding SelectedTicket.PriorityLabel}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0"
                                               Text="Created By"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1"
                                               Text="{Binding SelectedTicket.CreatedBy}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0"
                                               Text="Created"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1"
                                               Text="{Binding SelectedTicket.CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                               Style="{StaticResource DetailValueText}"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0"
                                               Text="Last Activity"
                                               Style="{StaticResource DetailLabelText}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1"
                                               Text="{Binding SelectedTicket.LastActivityAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                               Style="{StaticResource DetailValueText}"/>
                                </Grid>

                                <TextBlock Text="Notes"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,6,0,10"/>

                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12">
                                    <TextBox Text="{Binding SelectedTicket.Notes}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextSecondary}"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="140"/>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>