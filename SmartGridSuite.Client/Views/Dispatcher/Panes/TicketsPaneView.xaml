<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.TicketsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="FilterLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="DetailLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DetailValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="DetailCopyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TrimCellText" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="SummaryValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="SummaryLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="StatusCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TicketsGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="12,9,12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="TicketsGridRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource ThemedDataGridRowStyle}">
            <Setter Property="MinHeight" Value="54"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top card -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tickets"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Queue, filtering, and service history"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button Content="Refresh"
                                Margin="0,0,10,0"
                                Click="Refresh_Click"/>

                        <Button Content="Import SAP Queue"
                                Margin="0,0,10,0"
                                Click="ImportSapQueue_Click"/>

                        <Button Content="New Ticket"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewTicket_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Filters -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition x:Name="CustomFromSpacerCol" Width="0"/>
                        <ColumnDefinition x:Name="CustomFromCol" Width="0"/>
                        <ColumnDefinition x:Name="CustomToSpacerCol" Width="0"/>
                        <ColumnDefinition x:Name="CustomToCol" Width="0"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Labels -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Search"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Grid.ColumnSpan="5"
                               Text="Created Date"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="8"
                               Text="Status"
                               Style="{StaticResource FilterLabelText}"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="10"
                               Text="Tech"
                               Style="{StaticResource FilterLabelText}"/>

                    <!-- Controls -->
                    <TextBox x:Name="SearchBox"
                             Grid.Row="2"
                             Grid.Column="0"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Tag="Search site, Notification, WO, Tech, Notes, Serial #..."
                             Height="36"
                             TextChanged="SearchBox_TextChanged"/>

                    <ComboBox x:Name="DateRangeFilter"
                              Grid.Row="2"
                              Grid.Column="2"
                              Height="36"
                              SelectionChanged="Filters_SelectionChanged"/>

                    <DatePicker x:Name="FromDatePicker"
                                Grid.Row="2"
                                Grid.Column="4"
                                Style="{DynamicResource ModernDatePicker}"
                                Height="36"
                                Visibility="Collapsed"
                                SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

                    <DatePicker x:Name="ToDatePicker"
                                Grid.Row="2"
                                Grid.Column="6"
                                Style="{DynamicResource ModernDatePicker}"
                                Height="36"
                                Visibility="Collapsed"
                                SelectedDateChanged="InlineCustomDate_SelectedDateChanged"/>

                    <Grid Grid.Row="2"
                          Grid.Column="8">
                        <Button x:Name="StatusFilterButton"
                                Height="36"
                                Padding="12,0"
                                HorizontalContentAlignment="Stretch"
                                Click="StatusFilterButton_Click">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding SelectedStatusesSummary}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>

                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           Text="▾"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Button>

                        <Popup x:Name="StatusPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=StatusFilterButton}"
                               VerticalOffset="6"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Width="240">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding StatusOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource StatusCheckBoxStyle}"
                                                          Checked="StatusOption_Changed"
                                                          Unchecked="StatusOption_Changed"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1"
                                            Margin="0,4,0,10"
                                            Background="{DynamicResource CardBorder}"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="All Open"
                                                Height="30"
                                                MinWidth="80"
                                                Padding="10,0"
                                                Margin="0,0,8,0"
                                                Click="SelectAllOpenStatuses_Click"/>

                                        <Button Content="All"
                                                Height="30"
                                                MinWidth="64"
                                                Padding="10,0"
                                                Click="SelectAllStatuses_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <ComboBox x:Name="TechFilter"
                              Grid.Row="2"
                              Grid.Column="10"
                              Height="36"
                              SelectionChanged="Filters_SelectionChanged"/>

                    <Button Grid.Row="2"
                            Grid.Column="12"
                            Content="Clear Filters"
                            Height="36"
                            Padding="14,0"
                            Click="ClearFilters_Click"/>
                </Grid>

                <!-- Summary strip -->
                <UniformGrid Grid.Row="4"
             Rows="1"
             Columns="8">
                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding VisibleTicketCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Showing"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalLoadedTicketCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Loaded"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding NeedsReviewCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Needs Review"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OpenCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Open"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding AssignedCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Assigned"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding InProgressCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="In Progress"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WaitingDispatchCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Waiting Dispatch"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SummaryCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding ClosedCount}"
                       Style="{StaticResource SummaryValueTextStyle}"/>
                            <TextBlock Text="Closed"
                       Style="{StaticResource SummaryLabelTextStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailsSplitterCol" Width="0"/>
                    <ColumnDefinition x:Name="DetailsCol" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Ticket list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Ticket List"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>                        
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="TicketsGrid"
                              Style="{StaticResource ThemedDataGridStyle}"
                              RowStyle="{StaticResource TicketsGridRowStyle}"                              
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="TicketsGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Created"
                                                Width="130"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd/yy HH:mm}}"/>

                            <DataGridTextColumn Header="Last Activity"
                                                Width="130"
                                                Binding="{Binding LastActivityAt, StringFormat={}{0:MM/dd/yy HH:mm}}"/>

                            <DataGridTextColumn Header="Site"
                                                Width="110"
                                                Binding="{Binding Site}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Notification"
                                                Width="160"
                                                Binding="{Binding Notification}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTemplateColumn Header="Work Order"
                                                    Width="180">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{Binding CurrentWorkOrder}"
                                                       Style="{StaticResource TrimCellText}"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBlock Text="{Binding WorkOrderClassLabel}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Status"
                                                Width="130"
                                                Binding="{Binding Status}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Tech"
                                                Width="150"
                                                Binding="{Binding AssignedTech}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                            <DataGridTextColumn Header="Problem / Issue"
                                                Width="*"
                                                Binding="{Binding Problem}"
                                                ElementStyle="{StaticResource TrimCellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter x:Name="DetailsSplitter"
                              Grid.Column="1"
                              Width="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True"
                              Visibility="Collapsed"/>

                <!-- Details inspector -->
                <Border Grid.Column="2"
                        x:Name="DetailsPanel"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Visibility="Collapsed">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Ticket Details"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBlock Text="{Binding SelectedTicket.Site}"
                                           Margin="0,2,0,0"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    ToolTip="Close details"
                                    Click="CloseDetails_Click"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <TextBlock Text="✕"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal">
                            <Button Content="Assign Tech"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Click="AssignTech_Click"/>

                            <Button Content="Add Note"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Click="AddNote_Click"/>

                            <Button Content="Edit Ticket"
                                    Height="32"
                                    Padding="12,0"
                                    Click="EditTicket_Click"/>
                        </StackPanel>

                        <!-- Content -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Ticket info -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left info column -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Problem / Issue"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.Problem}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Notification Name"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.NotificationName}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Notification #"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding SelectedTicket.Notification}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DetailCopyButtonStyle}"
                                                    Content="Copy"
                                                    Tag="{Binding SelectedTicket.Notification}"
                                                    Click="CopyDetailValue_Click"/>
                                        </Grid>

                                        <TextBlock Text="Work Order"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding SelectedTicket.CurrentWorkOrder}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0"/>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DetailCopyButtonStyle}"
                                                    Content="Copy"
                                                    Tag="{Binding SelectedTicket.CurrentWorkOrder}"
                                                    Click="CopyDetailValue_Click"/>
                                        </Grid>

                                        <TextBlock Text="Work Order Type"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.WorkOrderClassLabel}"
                                                   Style="{StaticResource DetailValueText}"/>
                                    </StackPanel>

                                    <!-- Right info column -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Work Order Code"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.GroupCode}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Priority"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.PriorityLabel}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Created By"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.CreatedBy}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Created"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                                   Style="{StaticResource DetailValueText}"/>

                                        <TextBlock Text="Last Activity"
                                                   Style="{StaticResource DetailLabelText}"/>
                                        <TextBlock Text="{Binding SelectedTicket.LastActivityAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"
                                                   Style="{StaticResource DetailValueText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Notes -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Notes"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBox Grid.Row="2"
                                             Text="{Binding SelectedTicket.Notes}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextSecondary}"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="220"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>