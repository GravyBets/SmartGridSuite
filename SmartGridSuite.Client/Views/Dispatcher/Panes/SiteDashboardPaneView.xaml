<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboardPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search / Load -->
        <Border Grid.Row="0"
                Padding="14"
                CornerRadius="12"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SiteIdTextBox"
                         Height="36"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         KeyDown="SiteIdTextBox_KeyDown" />

                <Button x:Name="LoadButton"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="110"
                        Height="36"
                        Content="Load Site"
                        Click="LoadButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="2,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Enter a site ID and load the dashboard shell." />
            </Grid>
        </Border>

        <!-- Main -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Common site summary -->
                <Border Margin="0,0,0,12"
                        Padding="14"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Site Summary"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />

                        <UniformGrid Margin="0,12,0,0" Columns="3">
                            <Border Margin="0,0,8,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Site ID"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="SiteIdValueTextBlock"
                                               Margin="0,4,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="—"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,0"
                                    Padding="12"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Dashboard Kind"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="DashboardKindValueTextBlock"
                                               Margin="0,4,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="—"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <Border Padding="12"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Route Site Type"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="RouteSiteTypeValueTextBlock"
                                               Margin="0,4,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="—"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Per-dashboard-type content area -->
                <Border Margin="0,0,0,12"
                        Padding="14"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Dashboard Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />

                        <TextBlock x:Name="DashboardDetailsKindTitleTextBlock"
                                   Margin="0,12,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="Dashboard Type" />

                        <TextBlock x:Name="DashboardDetailsEmptyTextBlock"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="Load a site to show dashboard details." />

                        <ListView x:Name="DashboardDetailsListView"
                                  Margin="0,12,0,0"
                                  Visibility="Collapsed"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            CornerRadius="10"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfaceBg}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Text="{Binding Label}" />

                                            <TextBlock Grid.Column="1"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- History area -->
                <Border Padding="14"
                        CornerRadius="12"
                        Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="History"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />                        
                        
                        <TextBlock x:Name="HistoryEmptyTextBlock"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="No history loaded yet." />

                        <ListView x:Name="HistoryListView"
                                  Margin="0,12,0,0"
                                  Visibility="Collapsed"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12"
                                            CornerRadius="10"
                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfaceBg}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Date"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Text="{Binding DateText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Techs"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Text="{Binding TechsText}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                                <TextBlock Text="Summary"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Text="{Binding SummaryText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>