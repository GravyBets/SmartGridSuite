<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboardTestPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="10"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Background="White">
            <StackPanel>
                <TextBlock Text="Site Dashboard Test"
                           FontSize="20"
                           FontWeight="Bold"/>
                <TextBlock Text="Temporary read-only test pane for the generic site dashboard endpoint."
                           Margin="0,4,0,0"
                           Foreground="DimGray"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="16"
                CornerRadius="10"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SiteIdTextBox"
                         Grid.Column="0"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="27435"/>

                <Button Grid.Column="2"
                        Width="100"
                        Height="34"
                        Content="Load"
                        Click="LoadButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="3"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Text="Enter a site ID and click Load."/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Site ID:" FontWeight="Bold"/>
                    <TextBlock x:Name="SiteIdValueTextBlock" Grid.Row="0" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Dashboard Kind:" FontWeight="Bold"/>
                    <TextBlock x:Name="DashboardKindValueTextBlock" Grid.Row="2" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Route Site Type:" FontWeight="Bold"/>
                    <TextBlock x:Name="RouteSiteTypeValueTextBlock" Grid.Row="4" Grid.Column="1" Text="-"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    x:Name="DacsSummaryCard"
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Background="White"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DACS Site Status:" FontWeight="Bold"/>
                    <TextBlock x:Name="DacsSiteStatusTextBlock" Grid.Row="0" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Top Name:" FontWeight="Bold"/>
                    <TextBlock x:Name="DacsTopNameTextBlock" Grid.Row="2" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary Comms IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="DacsPrimaryIpTextBlock" Grid.Row="4" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Tunnel IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="DacsTunnelIpTextBlock" Grid.Row="6" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="RTU IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="DacsRtuIpTextBlock" Grid.Row="8" Grid.Column="1" Text="-"/>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    x:Name="AmsSummaryCard"
                    Padding="16"
                    Margin="0,140,0,0"
                    CornerRadius="10"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Background="White"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AMS Site Status:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsSiteStatusTextBlock" Grid.Row="0" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Primary Comms IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsPrimaryIpTextBlock" Grid.Row="2" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Secondary WAN IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsSecondaryWanIpTextBlock" Grid.Row="4" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Secondary LAN IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsSecondaryLanIpTextBlock" Grid.Row="6" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Top Name:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsTopNameTextBlock" Grid.Row="8" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Secondary SIM:" FontWeight="Bold"/>
                    <TextBlock x:Name="AmsSecondarySimTextBlock" Grid.Row="10" Grid.Column="1" Text="-"/>
                </Grid>
            </Border>

            <Border Grid.Row="6"
        x:Name="RxSummaryCard"
        Padding="16"
        CornerRadius="10"
        BorderBrush="#D0D7DE"
        BorderThickness="1"
        Background="White"
        Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="RX Site Status:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxSiteStatusTextBlock" Grid.Row="0" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Meter Number:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxMeterNumberTextBlock" Grid.Row="2" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="MAC Address:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxMacAddressTextBlock" Grid.Row="4" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Pole Point:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxPolePointTextBlock" Grid.Row="6" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Transformer GLN:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxTransformerGlnTextBlock" Grid.Row="8" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="City:" FontWeight="Bold"/>
                    <TextBlock x:Name="RxCityTextBlock" Grid.Row="10" Grid.Column="1" Text="-"/>
                </Grid>
            </Border>

            <Border Grid.Row="8"
        x:Name="IgsdSummaryCard"
        Padding="16"
        CornerRadius="10"
        BorderBrush="#D0D7DE"
        BorderThickness="1"
        Background="White"
        Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IGSD Site Status:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdSiteStatusTextBlock" Grid.Row="0" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Primary Comms IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdPrimaryIpTextBlock" Grid.Row="2" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Primary WAN IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdPrimaryWanIpTextBlock" Grid.Row="4" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Secondary WAN IP:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdSecondaryWanIpTextBlock" Grid.Row="6" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Top Name:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdTopNameTextBlock" Grid.Row="8" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Cyberlock Serial:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdCyberlockTextBlock" Grid.Row="10" Grid.Column="1" Text="-"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Tunnel PSK:" FontWeight="Bold"/>
                    <TextBlock x:Name="IgsdTunnelPskTextBlock" Grid.Row="12" Grid.Column="1" Text="-"/>
                </Grid>
            </Border>

            <Border Grid.Row="10"                    
                    Padding="16"
                    CornerRadius="10"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Raw Data JSON"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <TextBox x:Name="DataJsonTextBox"
                             Grid.Row="2"
                             Height="320"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             IsReadOnly="True"
                             FontFamily="Consolas"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>