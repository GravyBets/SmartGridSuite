<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.DeviceLookupPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}" Unloaded="DeviceLookupPaneView_Unloaded">

    <UserControl.Resources>
        <Style x:Key="DeviceLookupGridTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="DeviceLookupWorkOrderTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource DeviceLookupGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DeviceLookupGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Device Lookup"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="2"
                           Text="Choose the identifier type to find equipment, related tickets, and Site History."
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SearchTypeComboBox"
                              Grid.Column="0"
                              Width="235"
                              Height="34"
                              Style="{StaticResource ModernComboBox}"
                              SelectedIndex="0"
                              ToolTip="Choose which identifier to search. History Text is a broader search.">
                        <ComboBoxItem Content="Device Serial Number" Tag="DeviceSerialNumber"/>
                        <ComboBoxItem Content="Site #" Tag="Site"/>
                        <ComboBoxItem Content="IP Address" Tag="IpAddress"/>
                        <ComboBoxItem Content="SIM Number" Tag="Sim"/>
                        <ComboBoxItem Content="Notification" Tag="Notification"/>
                        <ComboBoxItem Content="Work Order" Tag="WorkOrder"/>
                        <ComboBoxItem Content="History Text" Tag="HistoryText"/>
                    </ComboBox>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="2"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="34"
                             MinWidth="160"
                             MaxLength="250"
                             Padding="10,0"
                             Tag="Enter the selected identifier..."
                             VerticalContentAlignment="Center"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <Button x:Name="SearchButton"
                            Grid.Column="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Search"
                            Height="34"
                            MinWidth="96"
                            Padding="16,0"
                            Click="SearchButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="0"
                       Text="Select a search type and enter its identifier. Searches use exact identifier matches."
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="4,0"/>

            <TabControl Grid.Row="2"
                        Margin="16,0,0,0"
                        Style="{StaticResource WorkspaceTabControlStyle}"
                        Foreground="{DynamicResource TextPrimary}">
                <TabItem Header="Device Records" Margin="0" Style="{StaticResource WorkspaceTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <Border Style="{StaticResource Card}"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Related Sites"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <ItemsControl x:Name="RelatedSitesItemsControl"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6"
                                                        Padding="10,5"
                                                        CornerRadius="8"
                                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource SurfaceBg}">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="ParentRecordsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RecordType}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"/>

                                                        <TextBlock Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}">
                                                            <Run Text="Match: "/>
                                                            <Run Text="{Binding MatchField}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Padding="9,4"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource SurfaceBg}"
                                                            Visibility="Visible">
                                                        <TextBlock Text="{Binding SiteId}"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Fields}"
                                                              Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           FontWeight="SemiBold"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           Foreground="{DynamicResource TextPrimary}"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Tickets" Style="{StaticResource WorkspaceTabItemStyle}">
                    <Border Style="{StaticResource Card}"
                            Margin="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Related Tickets"
                                           Margin="2,0,0,0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Ticket activity associated with the matched site or device."
                                           Margin="2,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <DataGrid x:Name="TicketsDataGrid"
                                      Grid.Row="2"
                                      Style="{StaticResource ThemedDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      MinRowHeight="34"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                                      ColumnHeaderStyle="{StaticResource DeviceLookupGridColumnHeaderStyle}"
                                      RowDetailsVisibilityMode="Collapsed"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Margin="74,4,10,12"
                                                Padding="12"
                                                CornerRadius="8"
                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceBg}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Submitted Write-Up"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondary}"/>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding WriteUpSubmittedBy}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                        <TextBlock Text="  "
                                                                   FontSize="11"/>
                                                        <TextBlock Text="{Binding WriteUpSubmittedAt, StringFormat={}{0:g}}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBox Text="{Binding SubmittedWriteUp}"
                                                         IsReadOnly="True"
                                                         IsReadOnlyCaretVisible="True"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         FontSize="13"
                                                         MinHeight="28"
                                                         MaxHeight="300"
                                                         VerticalScrollBarVisibility="Auto">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <TextBlock Text="No submitted write-up is associated with this ticket."
                                                           FontSize="12"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextSecondary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SubmittedWriteUp}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="42"
                                                            CanUserResize="False"
                                                            CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Margin="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip="Show or hide submitted write-up"
                                                        Click="ToggleTicketRowDetails_Click">
                                                    <Grid Width="18" Height="18">
                                                        <Ellipse Width="18"
                                                                 Height="18"
                                                                 Fill="Transparent"
                                                                 Stroke="{DynamicResource TextPrimary}"
                                                                 StrokeThickness=".75"/>
                                                        <Path Width="8"
                                                              Height="6"
                                                              Margin="0,0,0,-2"
                                                              Data="M 0,0 L 4,4 L 8,0"
                                                              Stroke="{DynamicResource TextPrimary}"
                                                              StrokeThickness="1.1"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Last Activity"
                                                        Width="150"
                                                        Binding="{Binding LastActivityAt, StringFormat={}{0:ddd\, MM/dd/yy HH:mm}}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Site"
                                                        Width="110"
                                                        Binding="{Binding Site}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Problem / Issue"
                                                        Width="2*"
                                                        Binding="{Binding Problem}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Notification"
                                                        Width="138"
                                                        Binding="{Binding Notification}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Work Order"
                                                        Width="145"
                                                        Binding="{Binding WorkOrder}"
                                                        ElementStyle="{StaticResource DeviceLookupWorkOrderTextStyle}"/>
                                    <DataGridTextColumn Header="WO Type"
                                                        Width="90"
                                                        Binding="{Binding WorkOrderClass}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Status"
                                                        Width="145"
                                                        Binding="{Binding Status}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                    <DataGridTextColumn Header="Summary"
                                                        Width="2*"
                                                        Binding="{Binding Summary}"
                                                        ElementStyle="{StaticResource DeviceLookupGridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Site History" Style="{StaticResource WorkspaceTabItemStyle}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource Card}"
                                CornerRadius="0,0,10,10"
                                Padding="0,0,0,24"
                                ClipToBounds="True">
                            <Border CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="0"
                                    Background="{DynamicResource CardBackground}"
                                    ClipToBounds="True">
                                <DataGrid x:Name="HistoryDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          RowHeaderWidth="0"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          BorderThickness="0"
                                          Background="{DynamicResource CardBackground}"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="HistoryDataGrid_SelectionChanged">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="Background" Value="{DynamicResource TabBgHover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DataGridHeaderBorder}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1.25"/>
                                        </Style>

                                        <Style TargetType="{x:Type DataGridRow}">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="MinHeight" Value="34"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TileFillHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TileFillPressed}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="12,6"/>
                                            <Setter Property="FontSize" Value="13.25"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>

                                        <Style x:Key="LookupHistoryGridTextStyle"
                                               TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="FontSize" Value="13.25"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                        </Style>

                                        <Style x:Key="LookupHistoryGridIssueTextStyle"
                                               TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource LookupHistoryGridTextStyle}">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxHeight" Value="38"/>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Site"
                                                            Width="110"
                                                            Binding="{Binding SiteId}"
                                                            ElementStyle="{StaticResource LookupHistoryGridTextStyle}"/>
                                        <DataGridTextColumn Header="Date"
                                                            Width="110"
                                                            Binding="{Binding VisitDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                            ElementStyle="{StaticResource LookupHistoryGridTextStyle}"/>
                                        <DataGridTextColumn Header="Tech 1"
                                                            Width="145"
                                                            Binding="{Binding PrimaryTech}"
                                                            ElementStyle="{StaticResource LookupHistoryGridTextStyle}"/>
                                        <DataGridTextColumn Header="Tech 2"
                                                            Width="145"
                                                            Binding="{Binding SecondaryTech}"
                                                            ElementStyle="{StaticResource LookupHistoryGridTextStyle}"/>
                                        <DataGridTextColumn Header="Site Issue"
                                                            Width="*"
                                                            Binding="{Binding IssueText}"
                                                            ElementStyle="{StaticResource LookupHistoryGridIssueTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource Card}"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Site History Write-Up"
                                               Margin="4,0,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>

                                    <TextBlock x:Name="HistorySourceTextBlock"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource SurfaceBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceBg}">
                                    <TextBox x:Name="HistoryNarrativeTextBox"
                                             Style="{x:Null}"
                                             Padding="12"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             IsTabStop="False"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextPrimary}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="14"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             HorizontalContentAlignment="Left"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>
