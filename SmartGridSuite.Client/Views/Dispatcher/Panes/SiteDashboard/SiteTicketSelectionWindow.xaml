<Window x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteTicketSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Ticket"
        Width="900"
        Height="470"
        MinWidth="760"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Multiple Tickets Match This Site"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock x:Name="ExplanationTextBlock"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Smart Grid Suite could not safely determine which ticket should receive this write-up. Select the correct ticket below."/>
        </StackPanel>

        <!-- Ticket list -->
        <Border Grid.Row="2"
                Padding="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="TicketsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      MouseDoubleClick="TicketsGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Ticket"
                                        Binding="{Binding TicketId}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Notification Name"
                                        Binding="{Binding NotificationName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Notification #"
                                        Binding="{Binding Notification}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Work Order"
                                        Binding="{Binding WorkOrder}"
                                        Width="115"/>

                    <DataGridTextColumn Header="WO Type"
                                        Binding="{Binding WorkOrderClass}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Assigned To"
                                        Binding="{Binding AssignedTech}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedAt,
                                                  StringFormat={}{0:MM-dd-yyyy HH:mm}}"
                                        Width="135"/>

                    <DataGridTextColumn Header="Problem / Issue"
                                        Binding="{Binding Problem}"
                                        Width="2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="The selected ticket will become the working ticket for this dashboard tab."/>

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100"
                    Height="34"
                    Content="Cancel"
                    Click="Cancel_Click"/>

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="145"
                    Height="34"
                    Content="Use Selected Ticket"
                    Click="UseSelectedTicket_Click"/>
        </Grid>
    </Grid>
</Window>