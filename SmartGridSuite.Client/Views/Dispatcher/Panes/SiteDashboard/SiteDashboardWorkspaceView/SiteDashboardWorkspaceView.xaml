<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteDashboardWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <UserControl.Resources>
        <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="-4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource TabBgHover}"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="12,12,0,0"
                                Padding="14,8,12,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                <Setter Property="Panel.ZIndex" Value="20"/>
                                <Setter Property="Margin" Value="-4,0,0,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        </Style>

        <Style x:Key="WorkspaceSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="WorkspaceReadOnlyBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="WorkspaceEditorBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernWatermarkTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="WorkspaceMiniLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopIpLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InputBorderFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopAccessValueBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource WorkspaceEditorBoxStyle}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TopAccessOpenButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TopAccessTestButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="126"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SnmpResultBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="{DynamicResource TabBgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="DashboardCleanCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                        CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SiteNoteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabBgHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SiteNoteDeleteIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SiteNoteIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#DC5050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="WorkspaceTabControl"
                    Grid.Row="0"
                    Margin="16,0,0,0"
                    Style="{StaticResource WorkspaceTabControlStyle}"
                    SelectionChanged="WorkspaceTabControl_SelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource WorkspaceTabItemStyle}" />
            </TabControl.ItemContainerStyle>

            <TabItem Header="Main" Tag="TopWriteUp" Margin="0,0,0,0"/>
            <TabItem x:Name="TowerOverviewTabItem" Header="Tower" Tag="TowerOverview" Visibility="Collapsed"/>
            <TabItem x:Name="RxOverviewTabItem" Header="Range Extender" Tag="RxOverview" Visibility="Collapsed"/>
            <TabItem x:Name="PortalTabItem" Header="PingScreen" Tag="Portal" Visibility="Collapsed"/>
            <TabItem Header="Site History" Tag="SiteHistory"/>
            <TabItem x:Name="EquipmentTabItem"
                     Header="Equipment"
                     Tag="Equipment"/>
            <TabItem x:Name="SnmpTabItem" Header="SNMP Tool" Tag="SNMPTool" Height="33" Margin="-4,0,0,0" VerticalAlignment="Top"/>
        </TabControl>

        <Grid Grid.Row="1"
              x:Name="WorkspaceContentRoot"
              Margin="0">

            <!-- TOP / Write Up -->
            <Grid x:Name="TopWriteUpPanel" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: TOP Access + Site Notes -->
                    <Border Grid.Column="0"
                            Style="{StaticResource Card}"
                            VerticalAlignment="Stretch"
                            Padding="10,10,10,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="TopInfoTextBox"
                                        Visibility="Collapsed" />

                            <!-- Header row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="88"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TopAccessTitleTextBlock"
                                            Grid.Column="0"
                                            Text="TOP Access"
                                            Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />

                                <Button x:Name="TestTopPairButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Content="Active Test"
                                        Height="28"
                                        MinWidth="88"
                                        Padding="12,0"
                                        Click="TestTopPairButton_Click" />
                            </Grid>

                            <!-- IP A -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                            Text="IP A"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <TextBox x:Name="TopIpATextBox"
                                            Grid.Column="2"
                                            Style="{StaticResource WorkspaceEditorBoxStyle}"
                                            IsReadOnly="True"
                                            Width="118"
                                            Height="28"
                                            Padding="10,0" />

                                <Button x:Name="OpenTopIpAButton"
                                        Grid.Column="4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Open"
                                        Width="72"
                                        Height="28"
                                        Padding="8,0"
                                        Click="OpenTopIpAButton_Click" />

                                <TextBlock x:Name="TopIpAStateTextBlock"
                                            Grid.Column="6"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}"
                                            VerticalAlignment="Center" />
                            </Grid>

                            <!-- IP B -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                            Text="IP B"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <TextBox x:Name="TopIpBTextBox"
                                            Grid.Column="2"
                                            Style="{StaticResource WorkspaceEditorBoxStyle}"
                                            IsReadOnly="True"
                                            Width="118"
                                            Height="28"
                                            Padding="10,0" />

                                <Button x:Name="OpenTopIpBButton"
                                        Grid.Column="4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Open"
                                        Width="72"
                                        Height="28"
                                        Padding="8,0"
                                        Click="OpenTopIpBButton_Click" />

                                <TextBlock x:Name="TopIpBStateTextBlock"
                                            Grid.Column="6"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}"
                                            VerticalAlignment="Center" />
                            </Grid>

                            <!-- Tunnel -->
                            <Grid x:Name="TopTunnelRow"
                                    Grid.Row="6"
                                    Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                            Text="Tunnel"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <TextBox x:Name="TopTunnelIpTextBox"
                                            Grid.Column="2"
                                            Style="{StaticResource WorkspaceEditorBoxStyle}"
                                            Height="28"
                                            Padding="10,0"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True" />

                                <Button x:Name="OpenTopTunnelButton"
                                        Grid.Column="4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Open"
                                        Width="72"
                                        Height="28"
                                        Padding="8,0"
                                        Click="OpenTopTunnelButton_Click" />
                            </Grid>

                            <Border Grid.Row="8"
                                    Background="{DynamicResource SurfaceBorder}" />

                            <!-- Site Notes Header -->
                            <Grid Grid.Row="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">

                                    <Border x:Name="SiteNotesCountBadge"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="6,0"
                                            Margin="0,0,6,0"
                                            CornerRadius="14"
                                            Background="#D92D20"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="SiteNotesCountTextBlock"
                                                   Text="0"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Site Notes / Access Info"
                                               Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="+ Add"
                                        Height="28"
                                        Width="60"
                                        Padding="8,0,0,0"
                                        Click="AddSiteNoteButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanManageSiteNotes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="12"
                                        x:Name="SiteNotesEmptyTextBlock"
                                        Text="No site notes for this site."
                                        TextWrapping="Wrap"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource TextSecondary}"/>

                            <ScrollViewer Grid.Row="14"
                                          MaxHeight="176"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SiteNotesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="8"
                                                    CornerRadius="8"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource SurfaceBg}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                                Text="{Binding NoteText}"
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextPrimary}"/>

                                                    <TextBlock Grid.Row="2"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextSecondary}">
                                                        <Run Text="Created by "/>
                                                        <Run Text="{Binding CreatedBy}"/>
                                                        <Run Text=" on "/>
                                                        <Run Text="{Binding CreatedAt, StringFormat={}{0:MM/dd/yyyy HH:mm}}"/>
                                                    </TextBlock>

                                                    <StackPanel Grid.Row="4"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanManageSiteNotes, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <Button Style="{StaticResource SiteNoteIconButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="Edit note"
                                                                Click="EditSiteNoteButton_Click">
                                                            <TextBlock Text="&#xE70F;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>

                                                        <Button Style="{StaticResource SiteNoteDeleteIconButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="Delete note"
                                                                Margin="4,0,0,0"
                                                                Click="DeleteSiteNoteButton_Click">
                                                            <TextBlock Text="&#xE107;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="14"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Ticket card -->
                    <Border Grid.Column="2"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Ticket Information"
                                           Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                <Button x:Name="RefreshTicketButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Refresh Ticket"
                                        Height="28"
                                        Padding="12,0"
                                        Click="RefreshTicketButton_Click" />
                            </Grid>

                            <!-- Body -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: Ticket details -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Notification Name -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Notification Name"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketNotificationNameTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Notification -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Notification"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TicketNotificationNumberTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />

                                            <Button x:Name="CopyTicketNotificationButton"
                                                    Style="{StaticResource MiniIconButton}"
                                                    Margin="6,0,0,0"
                                                    Width="22"
                                                    Height="22"
                                                    ToolTip="Copy notification"
                                                    Click="CopyTicketNotificationButton_Click">
                                                <TextBlock Style="{StaticResource CopyGlyph}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Problem / Issue -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Problem / Issue"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketProblemIssueTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Work Order -->
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Work Order"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TicketWorkOrderTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />

                                            <Button x:Name="CopyTicketWorkOrderButton"
                                                    Style="{StaticResource MiniIconButton}"
                                                    Margin="6,0,0,0"
                                                    Width="22"
                                                    Height="22"
                                                    ToolTip="Copy work order"
                                                    Click="CopyTicketWorkOrderButton_Click">
                                                <TextBlock Style="{StaticResource CopyGlyph}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Work Order Type -->
                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Work Order Type"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <Border x:Name="TicketWorkOrderTypeBadge"
                                                Grid.Column="1"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="TicketWorkOrderTypeTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>

                                    <!-- Assigned To -->
                                    <Grid Grid.Row="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Assigned To"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketAssignedToTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Status -->
                                    <Grid Grid.Row="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Status"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <Border x:Name="TicketStatusBadge"
                                                Grid.Column="1"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="TicketStatusTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>

                                    <!-- Date Created -->
                                    <Grid Grid.Row="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Date Created"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketDateCreatedTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </Grid>

                                <!-- RIGHT: Dispatch Notes, same card/no nested border -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Dispatch Notes"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}"
                                               VerticalAlignment="Top" />

                                    <ScrollViewer Grid.Row="2"
                                                  MaxHeight="190"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="TicketDispatchNotesTextBlock"
                                                   Text="No dispatch notes."
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Write-Up -->
                <Border Grid.Row="2" 
                        Style="{StaticResource Card}"
                        Padding="12,12,16,16">
                        
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Write Up"
                                       Style="{StaticResource WorkspaceSectionHeaderStyle}" 
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="WriteUpTextBox"
                                     Grid.Column="0"
                                     MinHeight="260"
                                     Height="Auto"
                                     Padding="6,6,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="WriteUpTextBox_TextChanged" />

                            <Border Grid.Column="2"
                                    Padding="10,8"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBg}">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="Available Ticket Requests"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />

                                            <TextBlock x:Name="TicketRequestsDescriptionTextBlock"
                                                        Text="Only request actions available for this ticket are shown."
                                                        TextWrapping="Wrap"
                                                        Margin="0,0,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}" />

                                                <Button x:Name="RequestTicketButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Request Ticket"
                                                        Height="30"
                                                        Margin="0,6,0,0"
                                                        Padding="12,0"
                                                        HorizontalAlignment="Stretch"
                                                        Click="RequestTicketButton_Click" />

                                                <Button x:Name="RequestMaintenanceButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Request Maintenance"
                                                        Height="30"
                                                        Margin="0,6,0,0"
                                                        Padding="12,0"
                                                        HorizontalAlignment="Stretch"
                                                        Click="RequestMaintenanceButton_Click" />

                                                <Button x:Name="RequestCapitalButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Request Capital"
                                                        Height="30"
                                                        Margin="0,6,0,0"
                                                        Padding="12,0"
                                                        HorizontalAlignment="Stretch"
                                                        Click="RequestCapitalButton_Click" />

                                            <StackPanel x:Name="WriteUpFlagsSection"
                                                        Visibility="Collapsed">

                                                <Border Height="1"
                                                        Margin="0,6,0,4"
                                                        Background="{DynamicResource SurfaceBorder}" />

                                            <TextBlock Text="Write-Up Flags"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimary}" />

                                            <!--
                                            Administrator-configured Write-Up Flags are inserted here.
                                            Refer To remains below them so future flags always appear first.
                                            -->
                                        <StackPanel x:Name="WriteUpFlagsOptionsPanel"
                                                    Margin="0,4,0,0" />

                                        <StackPanel x:Name="ReferToOptionsSection"
                                                    Visibility="Collapsed">

                                            <CheckBox x:Name="IncludeReferToCheckBox"
                                                      Content="Refer To"
                                                      IsChecked="False"
                                                      Margin="0,1,0,0"
                                                      Foreground="{DynamicResource TextPrimary}"
                                                      Checked="IncludeReferToCheckBox_CheckedChanged"
                                                      Unchecked="IncludeReferToCheckBox_CheckedChanged" />

                                            <StackPanel x:Name="ReferToOptionsPanel"
                                                        Visibility="Collapsed"
                                                        Margin="18,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="1"
                                            Margin="0,4,0,4"
                                            Background="{DynamicResource SurfaceBorder}" />

                                    <TextBlock Text="Include With Submit"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <CheckBox x:Name="IncludePingStatsCheckBox"
                                              Content="Ping stats"
                                              IsChecked="True"
                                              Margin="0,4,0,0"
                                              Foreground="{DynamicResource TextPrimary}" />

                                    <CheckBox x:Name="IncludeSnmpStatsCheckBox"
                                              Content="SNMP stats"
                                              IsChecked="False"
                                              Margin="0,4,0,0"
                                              Foreground="{DynamicResource TextPrimary}"
                                              Checked="IncludeSnmpStatsCheckBox_CheckedChanged"
                                              Unchecked="IncludeSnmpStatsCheckBox_CheckedChanged" />

                                    <StackPanel x:Name="SnmpCategoryOptionsPanel"
                                                Visibility="Collapsed"
                                                Margin="18,4,0,0">

                                        <CheckBox x:Name="IncludeSnmpAdminCheckBox"
                                                  Content="Admin"
                                                  IsChecked="True"
                                                  Margin="0,0,0,4"
                                                  Foreground="{DynamicResource TextPrimary}" />

                                        <CheckBox x:Name="IncludeSnmpConfigCheckBox"
                                                  Content="Config"
                                                  IsChecked="True"
                                                  Margin="0,0,0,4"
                                                  Foreground="{DynamicResource TextPrimary}" />

                                        <CheckBox x:Name="IncludeSnmpStatsCategoryCheckBox"
                                                  Content="Stats"
                                                  IsChecked="True"
                                                  Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button x:Name="SubmitWriteUpButton"
                                            Grid.Row="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Submit"
                                            Height="32"
                                            Margin="0,4,0,0"
                                            Padding="14,0"
                                            HorizontalAlignment="Stretch"
                                            Click="SubmitWriteUpButton_Click" />

                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tower Overview -->
            <Grid x:Name="TowerOverviewPanel"
                    Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TowerHeaderTextBlock"
                                    Text="Tower"
                                    Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                    VerticalAlignment="Center"/>

                        <Button x:Name="TestAllTowerSectorsButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Test"
                                Height="28"
                                MinWidth="88"
                                Padding="12,0"
                                Click="TestAllTowerSectorsButton_Click"/>
                    </Grid>
                </Border>

                <!-- Sector cards -->
                <Border Grid.Row="2"
                        Style="{StaticResource Card}">
                    <ScrollViewer x:Name="TowerSectorCardsScrollViewer"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Auto"
                                    SizeChanged="TowerSectorCardsScrollViewer_SizeChanged">
                        <StackPanel x:Name="TowerSectorCardsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Stretch" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Range Extender -->
            <Grid x:Name="RxOverviewPanel"
                    Margin="0"
                    Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Range Extender"
                                    Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                        <TextBlock Text="RX lookup tools and related site research."
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RX Links / Reference -->
                    <Border Grid.Column="0"
                                Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="RX Tools"
                                        Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                            <Button x:Name="OpenRangeExtenderLinkButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Open Range Extender Link"
                                    Height="32"
                                    Margin="0,12,0,0"
                                    Padding="12,0"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenRangeExtenderLinkButton_Click" />

                            <Border Height="1"
                                    Margin="0,14,0,12"
                                    Background="{DynamicResource SurfaceBorder}" />

                            <TextBlock Text="Reference"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}" />

                            <!-- Range Extender SN -->
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                            Text="Range Extender SN"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <Grid Grid.Row="2">
                                    <TextBox x:Name="RxRangeExtenderSnTextBox"
                                                Style="{StaticResource ModernTextBox}"
                                                Height="30"
                                                Padding="10,0,34,0"
                                                VerticalContentAlignment="Center"
                                                IsReadOnly="True"
                                                IsReadOnlyCaretVisible="True" />

                                    <Button Style="{StaticResource DashboardCleanCopyButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTip="Copy Range Extender SN"
                                                Tag="{Binding ElementName=RxRangeExtenderSnTextBox, Path=Text}"
                                                Click="CopyRxReferenceButton_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}" 
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- MAC Address -->
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                            Text="MAC Address"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <Grid Grid.Row="2">
                                    <TextBox x:Name="RxMacAddressTextBox"
                                                Style="{StaticResource ModernTextBox}"
                                                Height="30"
                                                Padding="10,0,34,0"
                                                VerticalContentAlignment="Center"
                                                IsReadOnly="True"
                                                IsReadOnlyCaretVisible="True" />

                                    <Button Style="{StaticResource DashboardCleanCopyButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTip="Copy MAC Address"
                                                Tag="{Binding ElementName=RxMacAddressTextBox, Path=Text}"
                                                Click="CopyRxReferenceButton_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}" 
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Pole Point -->
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                            Text="Pole Point"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <Grid Grid.Row="2">
                                    <TextBox x:Name="RxPolePointTextBox"
                                                Style="{StaticResource ModernTextBox}"
                                                Height="30"
                                                Padding="10,0,34,0"
                                                VerticalContentAlignment="Center"
                                                IsReadOnly="True"
                                                IsReadOnlyCaretVisible="True" />

                                    <Button Style="{StaticResource DashboardCleanCopyButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTip="Copy Pole Point"
                                                Tag="{Binding ElementName=RxPolePointTextBox, Path=Text}"
                                                Click="CopyRxReferenceButton_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}" 
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Transformer GLN -->
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                            Text="Transformer GLN"
                                            Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <Grid Grid.Row="2">
                                    <TextBox x:Name="RxTransformerGlnTextBox"
                                                Style="{StaticResource ModernTextBox}"
                                                Height="30"
                                                Padding="10,0,34,0"
                                                VerticalContentAlignment="Center"
                                                IsReadOnly="True"
                                                IsReadOnlyCaretVisible="True" />

                                    <Button Style="{StaticResource DashboardCleanCopyButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTip="Copy Transformer GLN"
                                                Tag="{Binding ElementName=RxTransformerGlnTextBox, Path=Text}"
                                                Click="CopyRxReferenceButton_Click">
                                        <TextBlock Style="{StaticResource CopyGlyph}" 
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Associated Site Lookup -->
                    <Border Grid.Column="2"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                        Text="Find Associated Site by ANY IP, PMR Serial Number, or RX Serial Number"
                                        Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="RxIpLookupTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource WorkspaceEditorBoxStyle}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Enter IP, PMR SN, or RX SN"
                                         KeyDown="RxIpLookupTextBox_KeyDown" />

                                <Button Grid.Column="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Search"
                                        Height="32"
                                        MinWidth="90"
                                        Padding="14,0"
                                        Click="SearchRxIpButton_Click" />
                            </Grid>

                            <Border Grid.Row="4"
                                    Padding="12"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBg}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="RxIpLookupStatusTextBlock"
                                               Grid.Row="0"
                                               Text="Enter an IP address, PMR SN, or RX SN to look up the associated site."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />

                                    <ScrollViewer Grid.Row="2"
                                                  MaxHeight="240"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="RxAssociatedSitesItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="10"
                                                            CornerRadius="8"
                                                            BorderBrush="{DynamicResource SurfaceBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource SurfaceBg}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayText}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>

                                                            <Button Grid.Column="2"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Content="Open"
                                                                    Height="28"
                                                                    MinWidth="68"
                                                                    Padding="12,0"
                                                                    Tag="{Binding SiteId}"
                                                                    Click="OpenAssociatedSiteResultButton_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!--Portal Tab-->
            <Grid x:Name="PortalPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="PingScreen"
                                   Margin="10,4,0,0"
                                   Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                   FontSize="16"/>

                        <Button Grid.Column="2"
                                x:Name="ReloadPortalButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Reload"
                                Height="28"
                                Width="96"
                                Padding="12,0"
                                Click="ReloadPortalButton_Click" />

                        <Button Grid.Column="4"
                                x:Name="OpenPortalInBrowserButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Open in Browser"
                                Height="28"
                                Padding="12,0"
                                Click="OpenPortalInBrowserButton_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        CornerRadius="10"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="0.5"
                        Background="{DynamicResource SurfaceBg}">
                    <wv2:WebView2 x:Name="PortalWebView" />
                </Border>

            </Grid>

            <!-- Site History -->
            <Grid x:Name="SiteHistoryPanel"
                  Margin="0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- History list -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        CornerRadius="0,0,10,10"
                        Padding="0,0,0,24"
                        ClipToBounds="True">

                    <Border CornerRadius="10"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="0"
                            Background="{DynamicResource CardBackground}"
                            ClipToBounds="True">

                        <DataGrid x:Name="HistoryDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="HistoryDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <!-- HEADER: stronger, larger, no vertical separators -->
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource TabBgHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridHeaderBorder}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1.25"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="True"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <!-- ROW -->
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="MinHeight" Value="34"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TileFillHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TileFillPressed}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <!-- CELL: horizontal separator only -->
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="FontSize" Value="13.25"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      HorizontalAlignment="Left"
                                                                      SnapsToDevicePixels="True"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="HistoryGridTextStyle"
                                       TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize" Value="13.25"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                </Style>

                                <Style x:Key="HistoryGridIssueTextStyle"
                                       TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource HistoryGridTextStyle}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxHeight" Value="38"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date"
                                    Width="110"
                                    Binding="{Binding DateText}"
                                    ElementStyle="{StaticResource HistoryGridTextStyle}" />

                                <DataGridTextColumn Header="Tech 1"
                                    Width="145"
                                    Binding="{Binding Tech1Text}"
                                    ElementStyle="{StaticResource HistoryGridTextStyle}" />

                                <DataGridTextColumn Header="Tech 2"
                                    Width="145"
                                    Binding="{Binding Tech2Text}"
                                    ElementStyle="{StaticResource HistoryGridTextStyle}" />

                                <DataGridTextColumn Header="Site Issue"
                                    Width="*"
                                    Binding="{Binding IssueText}"
                                    ElementStyle="{StaticResource HistoryGridIssueTextStyle}" />
                                
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Border>

                <!-- History narrative card -->
                <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Site History Write-Up"
                                       Margin="4,0,0,0"
                                       Style="{StaticResource WorkspaceSectionHeaderStyle}"/>

                            <TextBlock x:Name="HistoryEditedTextBlock"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceBg}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="NarrativeTextBlock"
                               Padding="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Equipment -->
            <Grid x:Name="EquipmentPanel"
                        Visibility="Collapsed"
                        Margin="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Top">

                    <!-- Serialized Devices -->
                    <Border Style="{StaticResource Card}"
                                Padding="16"
                                Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Serialized Devices"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"/>

                            <StackPanel x:Name="SerializedDevicesPanel"
                                            Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Access & Security -->
                    <Border x:Name="AccessSecurityCard"
                                Style="{StaticResource Card}"
                                Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Access &amp; Security"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                VerticalAlignment="Center"/>

                                <Button x:Name="ToggleSensitiveEquipmentButton"
                                            Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="View"
                                            Height="28"
                                            MinWidth="78"
                                            Padding="12,0"
                                            Click="ToggleSensitiveEquipmentButton_Click"/>
                            </Grid>

                            <StackPanel x:Name="AccessSecuritySectionPanel"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT SIDE -->
                <Border Grid.Column="2"
                            Style="{StaticResource Card}"
                            Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Replacement Entries"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                        Content="+ Add Blank"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="28"
                                        MinWidth="102"
                                        Padding="12,0"
                                        Click="AddReplacementEntryButton_Click"/>
                        </Grid>

                        <!-- Replacement Entries Scroll Area -->
                        <ScrollViewer Grid.Row="2"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ReplacementEntriesPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- SNMP -->
            <Grid x:Name="SnmpPanel" Margin="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="SNMP Tool"
                                       Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                       VerticalAlignment="Center" />

                            <TextBlock x:Name="SnmpSupportInlineTextBlock"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="No site loaded." />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Profile"
                                       Style="{StaticResource WorkspaceMiniLabelStyle}"
                                       VerticalAlignment="Center" />

                            <ComboBox x:Name="SnmpProfileComboBox"
                                     Grid.Column="2"
                                     Height="28"
                                     MinWidth="220"
                                     IsEditable="False"
                                     DisplayMemberPath="DisplayLabel"
                                     SelectedValuePath="Id"
                                     TextSearch.TextPath="DisplayLabel"
                                     SelectionChanged="SnmpProfileComboBox_SelectionChanged" />

                            <Button x:Name="RefreshSnmpButton"
                                    Grid.Column="4"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Content="Refresh SNMP Config"
                                    Height="28"
                                    Padding="12,0"
                                    Click="RefreshSnmpButton_Click" />

                            <TextBlock Grid.Column="6"
                                       Text="Target"
                                       Style="{StaticResource WorkspaceMiniLabelStyle}"
                                       VerticalAlignment="Center" />

                            <ComboBox x:Name="SnmpTargetComboBox"
                                     Grid.Column="8"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     SelectionChanged="SnmpTargetComboBox_SelectionChanged"/>

                            <TextBox x:Name="SnmpTargetTextBox"
                                     Grid.Column="10"
                                     Style="{StaticResource WorkspaceEditorBoxStyle}"
                                     Height="28"
                                     MinWidth="104"
                                     Padding="10,0,14,0"
                                     VerticalContentAlignment="Center"
                                     LostFocus="SnmpTargetTextBox_LostFocus" />

                            <Button x:Name="PollAllSnmpButton"
                                    Grid.Column="12"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Poll All"
                                    Height="28"
                                    Width="66"
                                    MinWidth="66"
                                    MaxWidth="66"
                                    Padding="8,0"
                                    Click="PollAllSnmpButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Category cards -->
                <Grid Grid.Row="2">
                    <ItemsControl x:Name="SnmpCategoryItemsControl"
                                  Margin="0,0,-6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="10,8"
                                        MinHeight="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="2"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Category header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Category}"
                                                       Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Rows.Count, StringFormat={}{0} OIDs}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Category contents -->
                                        <Grid Grid.Row="2"
                                              MinHeight="0">
                                            <TextBlock Text="{Binding EmptyMessage}"
                                                       Visibility="{Binding EmptyMessageVisibility}"
                                                       Foreground="{DynamicResource TextSecondary}"/>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="True">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,4"
                                                                    Padding="0,0,0,4"
                                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                                    BorderThickness="0,0,0,1">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="2"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Row 1: OID label + run button -->
                                                                    <TextBlock Grid.Row="0"
                                                                               Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxHeight="34"
                                                                               Margin="4,0,8,0"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"/>

                                                                    <Button Grid.Row="0"
                                                                            Grid.Column="1"
                                                                            Style="{StaticResource MiniIconButton}"
                                                                            Foreground="{DynamicResource TextSecondary}"
                                                                            FontFamily="Segoe MDL2 Assets"
                                                                            Content="&#xE72C;"
                                                                            Height="22"
                                                                            MinWidth="26"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Padding="0"
                                                                            Tag="{Binding}"
                                                                            VerticalAlignment="Center"
                                                                            Click="RunSnmpOidButton_Click"/>

                                                                    <!-- Row 2: Result -->
                                                                    <TextBox Grid.Row="2"
                                                                             Grid.Column="0"
                                                                             Grid.ColumnSpan="2"
                                                                             Text="{Binding ResultText}"
                                                                             Style="{StaticResource SnmpResultBoxStyle}"
                                                                             MinHeight="28"
                                                                             MaxHeight="52"
                                                                             Padding="6,4"
                                                                             FontSize="12"
                                                                             VerticalScrollBarVisibility="Auto"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- SNMP Set Tool -->
                <Border Grid.Row="4"
                        Style="{StaticResource Card}"
                        Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Set controls -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="SNMP Set Tool"
                                       Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="280"/>                                    
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Choose OID"
                                           Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <ComboBox x:Name="SnmpWritableOidComboBox"
                                          Grid.Column="2"
                                          Height="28"
                                          Width="280"
                                          HorizontalAlignment="Stretch"
                                          IsEditable="False"
                                          DisplayMemberPath="DisplayLabel"
                                          TextSearch.TextPath="DisplayLabel"
                                          SelectionChanged="SnmpWritableOidComboBox_SelectionChanged" />
                            </Grid>
                            
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>                                    
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Set Value"
                                           Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                <Grid Grid.Column="2">
                                    <TextBox x:Name="SnmpSetValueTextBox"
                                             Style="{StaticResource WorkspaceEditorBoxStyle}"
                                             Height="28"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             IsEnabled="False" />

                                    <ComboBox x:Name="SnmpSetValueComboBox"
                                              Height="28"
                                              Width="280"
                                              HorizontalAlignment="Stretch"
                                              IsEditable="False"
                                              DisplayMemberPath="DisplayLabel"
                                              SelectedValuePath="RawValue"
                                              TextSearch.TextPath="DisplayLabel"
                                              Visibility="Collapsed"
                                              IsEnabled="False" />
                                </Grid>

                                <Button x:Name="SetSelectedSnmpButton"
                                        Grid.Column="4"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Set Selected"
                                        Height="28"
                                        MinWidth="108"
                                        Padding="12,0"
                                        IsEnabled="False"
                                        Click="SetSelectedSnmpButton_Click" />
                            </Grid>
                        </Grid>

                        <!-- Right: Decoder help -->
                        <Grid Grid.Column="2"
                              VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Decoder"
                                       Style="{StaticResource WorkspaceMiniLabelStyle}" />

                            <TextBox x:Name="SnmpDecoderValuesTextBox"
                                     Grid.Row="2"
                                     Style="{StaticResource WorkspaceReadOnlyBoxStyle}"
                                     MinHeight="56"
                                     MinWidth="220"
                                     Padding="10,7"
                                     VerticalContentAlignment="Top"
                                     HorizontalAlignment="Stretch"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsReadOnly="True" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>