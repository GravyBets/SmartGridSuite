<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboardPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sd="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NetworkColumn" Width="340"/>
            <ColumnDefinition x:Name="NetworkGapColumn" Width="8"/>
            <ColumnDefinition x:Name="WorkspaceColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <sd:SiteDashboardTopBarView x:Name="TopBarView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3" />

        <sd:SiteDashboardNetworkView x:Name="NetworkView"
                                     Grid.Row="2"
                                     Grid.Column="0" />

        <sd:SiteDashboardWorkspaceView x:Name="WorkspaceView"
                                       Grid.Row="2"
                                       Grid.Column="2" />
        
        <Border x:Name="PoppedOutOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Visibility="Collapsed"
                Background="#990F172A"
                CornerRadius="12"
                Panel.ZIndex="999"
                IsHitTestVisible="True">

            <Grid>
                <Border Width="460"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="18"
                        Background="#FFF8FAFC"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Opacity="0.35"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Site Dashboard Popped Out"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#FF0F172A"
                           HorizontalAlignment="Center"/>

                        <TextBlock x:Name="PoppedOutOverlaySiteTextBlock"
                           Text="All open Site Dashboard tabs are open in another window."
                           Margin="0,10,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FF475569"/>

                        <Button Content="Bring Pop-Out Forward"
                        Margin="0,22,0,0"
                        Height="36"
                        MinWidth="190"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BringPoppedOutForwardButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>