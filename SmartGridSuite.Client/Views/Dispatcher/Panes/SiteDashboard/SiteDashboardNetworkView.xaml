<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteDashboardNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NetworkHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="NetworkHeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkSummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NetworkMiniButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkPrimaryMiniButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkSectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        </Style>

        <Style x:Key="NetworkOutputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="NetworkDangerMiniButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#D92D20"/>
            <Setter Property="BorderBrush" Value="#B42318"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B42318"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#912018"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#912018"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NetworkIpTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>

            <RowDefinition x:Name="PrimarySectionRow" Height="*"/>
            <RowDefinition Height="8"/>

            <RowDefinition x:Name="MiddleSectionRow" Height="*"/>
            <RowDefinition Height="8"/>

            <RowDefinition x:Name="SecondarySectionRow" Height="*"/>
            <RowDefinition Height="8"/>

            <RowDefinition x:Name="BottomReferenceRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Header / action card -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="NetworkHeaderTextBlock"
                           Grid.Column="0"
                           Text="Site"
                           Style="{StaticResource NetworkHeaderTitleStyle}" />
                    
                </Grid>

                <Grid Grid.Row="2">
                    <TextBox x:Name="PingCountTextBox"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="30"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Blank = continuous"
                             Tag="Ping Count"
                             PreviewTextInput="PingCountTextBox_PreviewTextInput"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PingAllButton"
                            Grid.Column="1"
                            Style="{StaticResource NetworkPrimaryMiniButtonStyle}"
                            Content="Ping All"
                            Click="PingAllButton_Click" />

                    <Button x:Name="ClearAllButton"
                            Grid.Column="3"
                            Style="{StaticResource NetworkMiniButtonStyle}"
                            Content="Clear"
                            Click="ClearAllButton_Click" />

                    <Button x:Name="TestAllButton"
                            Grid.Column="5"
                            Style="{StaticResource NetworkPrimaryMiniButtonStyle}"
                            Content="Test"
                            Click="TestAllButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Primary Ping Card -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PrimaryPingLabelTextBlock"
                               Grid.Column="0"
                               Text="Primary"
                               Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="PrimaryIpTextBox"
                             Grid.Column="1"
                             Style="{StaticResource NetworkIpTextBoxStyle}"
                             Height="30"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             FontSize="13"
                             FontWeight="SemiBold" />

                    <Button x:Name="PrimaryPingButton"
                            Grid.Column="3"
                            Style="{StaticResource NetworkMiniButtonStyle}"
                            Content="Ping"
                            Click="PingPrimaryButton_Click" />
                </Grid>

                <Border Grid.Row="2"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource SurfaceBg}">
                    <TextBox x:Name="PrimaryResultsTextBox"
                         Style="{StaticResource NetworkOutputTextBoxStyle}" />
                </Border>

                <TextBlock x:Name="PrimarySummaryTextBlock"
                       Grid.Row="4"
                       Text="Ready."
                       Style="{StaticResource NetworkSummaryTextStyle}" />
            </Grid>
        </Border>

        <!-- Normal LAN Ping Card (non-IGSD only) -->
        <Border x:Name="LanSectionBorder"
            Grid.Row="4"
            Style="{StaticResource Card}"
            Padding="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LanPingLabelTextBlock"
                               Grid.Column="0"
                               Text="LAN"
                               Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="LanIpTextBox"
                             Grid.Column="1"
                             Style="{StaticResource NetworkIpTextBoxStyle}"
                             Height="30"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             FontSize="13"
                             FontWeight="SemiBold" />

                    <Button x:Name="LanPingButton"
                            Grid.Column="3"
                            Style="{StaticResource NetworkMiniButtonStyle}"
                            Content="Ping"
                            Click="PingLanButton_Click" />
                </Grid>

                <Border Grid.Row="2"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource SurfaceBg}">
                    <TextBox x:Name="LanResultsTextBox"
                         Style="{StaticResource NetworkOutputTextBoxStyle}" />
                </Border>

                <TextBlock x:Name="LanSummaryTextBlock"
                       Grid.Row="4"
                       Text="Ready."
                       Style="{StaticResource NetworkSummaryTextStyle}" />
            </Grid>
        </Border>

        <!-- IGSD Primary RTU reference card -->
        <Border x:Name="PrimaryRtuReferenceSectionBorder"
                Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="10,10,10,10"
                Visibility="Collapsed">
            <StackPanel>
                <Grid x:Name="PrimaryCommsEthRow"
                      Margin="0,0,0,8"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Primary Comms Eth IP"
                               Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="IgsdPrimaryCommsEthernetIpTextBox"
                             Grid.Column="2"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="30"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             IsReadOnly="False" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Primary RTU IP"
                               Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="IgsdPrimaryRtuIpTextBox"
                             Grid.Column="2"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="30"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             FontWeight="SemiBold"
                             IsReadOnly="False" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Secondary Ping Card -->
        <Border Grid.Row="6"
                Style="{StaticResource Card}"
                Padding="10"
                Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SecondaryPingLabelTextBlock"
                               Grid.Column="0"
                               Text="Secondary"
                               Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="SecondaryIpTextBox"
                             Grid.Column="1"
                             Style="{StaticResource NetworkIpTextBoxStyle}"
                             Height="30"
                             Padding="2,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             FontSize="13"
                             FontWeight="SemiBold" />

                    <Button x:Name="SecondaryPingButton"
                            Grid.Column="3"
                            Style="{StaticResource NetworkMiniButtonStyle}"
                            Content="Ping"
                            Click="PingSecondaryButton_Click" />
                </Grid>

                <Border Grid.Row="2"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1"
                        Background="{DynamicResource SurfaceBg}">
                    <TextBox x:Name="SecondaryResultsTextBox"
                         Style="{StaticResource NetworkOutputTextBoxStyle}" />
                </Border>

                <TextBlock x:Name="SecondarySummaryTextBlock"
                       Grid.Row="4"
                       Text="Ready."
                       Style="{StaticResource NetworkSummaryTextStyle}" />
            </Grid>
        </Border>

        <!-- IGSD Secondary reference card -->
        <Border x:Name="SecondaryReferenceSectionBorder"
                Grid.Row="8"
                Style="{StaticResource Card}"
                Padding="10"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Text="Secondary Comms Eth IP"
                           Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="IgsdSecondaryCommsEthernetIpTextBox"
                         Grid.Column="2"
                         Style="{StaticResource ModernWatermarkTextBox}"
                         Height="30"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         FontWeight="SemiBold"
                         IsReadOnly="False" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Text="Secondary RTU IP"
                           Style="{StaticResource NetworkHeaderLabelStyle}" />

                    <TextBox x:Name="IgsdSecondaryRtuIpTextBox"
                         Grid.Column="2"
                         Style="{StaticResource ModernWatermarkTextBox}"
                         Height="30"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         FontWeight="SemiBold"
                         IsReadOnly="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

</UserControl>