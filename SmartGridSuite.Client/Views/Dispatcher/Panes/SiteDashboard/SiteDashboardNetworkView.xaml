<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteDashboardNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NetworkHeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="NetworkHeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkSummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="NetworkMiniButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkPrimaryMiniButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NetworkSectionBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        </Style>

        <Style x:Key="NetworkOutputTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="10"
            CornerRadius="12"
            Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / action card -->
            <Border Grid.Row="0"
                    Style="{StaticResource NetworkSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="NetworkHeaderTextBlock"
                                   Grid.Column="0"
                                   Text="Site"
                                   Style="{StaticResource NetworkHeaderTitleStyle}" />

                        <Button x:Name="TestAllButton"
                                Grid.Column="1"
                                Style="{StaticResource NetworkPrimaryMiniButtonStyle}"
                                Content="Test"
                                Click="TestAllButton_Click" />
                    </Grid>

                    <!-- Action row -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Ping Count"
                                   Style="{StaticResource NetworkHeaderLabelStyle}" />

                        <TextBox x:Name="PingCountTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="30"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 ToolTip="Blank = continuous" 
                                 PreviewTextInput="PingCountTextBox_PreviewTextInput"/>

                        <Button x:Name="PingAllButton"
                                Grid.Column="4"
                                Style="{StaticResource NetworkPrimaryMiniButtonStyle}"
                                Content="Ping All"
                                Click="PingAllButton_Click" />

                        <Button x:Name="StopAllButton"
                                Grid.Column="6"
                                Style="{StaticResource NetworkMiniButtonStyle}"
                                Content="Stop"
                                Click="StopAllButton_Click" />

                        <Button x:Name="ClearAllButton"
                                Grid.Column="8"
                                Style="{StaticResource NetworkMiniButtonStyle}"
                                Content="Clear"
                                Click="ClearAllButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Primary -->
            <Border Grid.Row="2"
                    Style="{StaticResource NetworkSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Primary"
                                   Style="{StaticResource NetworkHeaderLabelStyle}" />

                        <TextBox x:Name="PrimaryIpTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="30"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Text="" />

                        <Button Grid.Column="3"
                                Style="{StaticResource NetworkMiniButtonStyle}"
                                Content="Ping"
                                Click="PingPrimaryButton_Click" />
                    </Grid>

                    <Border Grid.Row="2"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource SurfaceBg}">
                        <TextBox x:Name="PrimaryResultsTextBox"
                                 Style="{StaticResource NetworkOutputTextBoxStyle}" />
                    </Border>

                    <TextBlock x:Name="PrimarySummaryTextBlock"
                               Grid.Row="4"
                               Text="Ready."
                               Style="{StaticResource NetworkSummaryTextStyle}" />
                </Grid>
            </Border>

            <!-- LAN -->
            <Border Grid.Row="4"
                    Style="{StaticResource NetworkSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="LAN"
                                   Style="{StaticResource NetworkHeaderLabelStyle}" />

                        <TextBox x:Name="LanIpTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="30"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Text="" />

                        <Button Grid.Column="3"
                                Style="{StaticResource NetworkMiniButtonStyle}"
                                Content="Ping"
                                Click="PingLanButton_Click" />
                    </Grid>

                    <Border Grid.Row="2"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource SurfaceBg}">
                        <TextBox x:Name="LanResultsTextBox"
                                 Style="{StaticResource NetworkOutputTextBoxStyle}" />
                    </Border>

                    <TextBlock x:Name="LanSummaryTextBlock"
                               Grid.Row="4"
                               Text="Ready."
                               Style="{StaticResource NetworkSummaryTextStyle}" />
                </Grid>
            </Border>

            <!-- Secondary -->
            <Border Grid.Row="6"
                    Style="{StaticResource NetworkSectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Secondary"
                                   Style="{StaticResource NetworkHeaderLabelStyle}" />

                        <TextBox x:Name="SecondaryIpTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="30"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Text="" />

                        <Button Grid.Column="3"
                                Style="{StaticResource NetworkMiniButtonStyle}"
                                Content="Ping"
                                Click="PingSecondaryButton_Click" />
                    </Grid>

                    <Border Grid.Row="2"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource SurfaceBg}">
                        <TextBox x:Name="SecondaryResultsTextBox"
                                 Style="{StaticResource NetworkOutputTextBoxStyle}" />
                    </Border>

                    <TextBlock x:Name="SecondarySummaryTextBlock"
                               Grid.Row="4"
                               Text="Ready."
                               Style="{StaticResource NetworkSummaryTextStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>