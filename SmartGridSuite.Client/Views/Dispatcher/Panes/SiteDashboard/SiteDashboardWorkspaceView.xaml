<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteDashboardWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="WorkspaceTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="-4,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource TabBgHover}"
                                BorderBrush="{DynamicResource SurfaceBorder}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="12,12,0,0"
                                Padding="14,8,12,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorderFocus}"/>
                                <Setter Property="Panel.ZIndex" Value="20"/>
                                <Setter Property="Margin" Value="-4,0,0,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
        </Style>

        <Style x:Key="WorkspaceSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="WorkspaceReadOnlyBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="WorkspaceEditorBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernWatermarkTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="WorkspaceMiniLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopIpLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InputBorderFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopAccessValueBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource WorkspaceEditorBoxStyle}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TopAccessOpenButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TopAccessTestButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="126"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Border Padding="12"
            CornerRadius="12"
            Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource SurfaceBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="WorkspaceTabControl"
                        Grid.Row="0"
                        Margin="10,0,0,0"
                        Style="{StaticResource WorkspaceTabControlStyle}"
                        SelectionChanged="WorkspaceTabControl_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource WorkspaceTabItemStyle}" />
                </TabControl.ItemContainerStyle>

                <TabItem Header="Main" Tag="TopWriteUp" Margin="0,0,0,0"/>
                <TabItem Header="Site History" Tag="SiteHistory"/>
                <TabItem Header="Equipment" Tag="Equipment"/>
                <TabItem Header="SNMP Tool" Tag="SNMPTool"/>
            </TabControl>

            <Border Grid.Row="1"
                    Margin="0,-1,0,0"
                    CornerRadius="0,12,12,12"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource SurfaceBorder}"
                    BorderThickness="1">
                <Grid x:Name="WorkspaceContentRoot">

                    <!-- TOP / Write Up -->
                    <Grid x:Name="TopWriteUpPanel" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: TOP card -->
                            <Border Grid.Column="0" Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="TopInfoTextBox"
                                             Visibility="Collapsed" />

                                    <!-- Header row -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="TopAccessTitleTextBlock"
                                                   Grid.Column="0"
                                                   Text="TOP Access"
                                                   Style="{StaticResource WorkspaceSectionHeaderStyle}"
                                                   VerticalAlignment="Center" />

                                        <Button x:Name="TestTopPairButton"
                                                Grid.Column="1"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Active Test"
                                                Height="28"
                                                MinWidth="88"
                                                Padding="12,0"
                                                Click="TestTopPairButton_Click" />
                                    </Grid>

                                    <!-- IP A -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="IP A"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBox x:Name="TopIpATextBox"
                                                 Grid.Column="2"
                                                 Style="{StaticResource WorkspaceEditorBoxStyle}"
                                                 IsReadOnly="True"
                                                 Width="118"
                                                 Height="28"
                                                 Padding="10,0" />

                                        <Button x:Name="OpenTopIpAButton"
                                                Grid.Column="4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Open"
                                                Width="56"
                                                Height="28"
                                                Padding="8,0"
                                                Click="OpenTopIpAButton_Click" />

                                        <TextBlock x:Name="TopIpAStateTextBlock"
                                                   Grid.Column="6"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- IP B -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="IP B"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBox x:Name="TopIpBTextBox"
                                                 Grid.Column="2"
                                                 Style="{StaticResource WorkspaceEditorBoxStyle}"
                                                 IsReadOnly="True"
                                                 Width="118"
                                                 Height="28"
                                                 Padding="10,0" />

                                        <Button x:Name="OpenTopIpBButton"
                                                Grid.Column="4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Open"
                                                Width="56"
                                                Height="28"
                                                Padding="8,0"
                                                Click="OpenTopIpBButton_Click" />

                                        <TextBlock x:Name="TopIpBStateTextBlock"
                                                   Grid.Column="6"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- RIGHT: Ticket card -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Ticket Information"
                                                   Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                        <Button x:Name="RefreshTicketButton"
                                                Grid.Column="1"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Refresh Ticket"
                                                Height="28"
                                                Padding="12,0"
                                                Click="RefreshTicketButton_Click" />
                                    </Grid>

                                    <!-- Notification Name -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Notification Name"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketNotificationNameTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Notification -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Notification"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TicketNotificationNumberTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />

                                            <Button x:Name="CopyTicketNotificationButton"
                                                    Style="{StaticResource MiniIconButton}"
                                                    Margin="6,0,0,0"
                                                    Width="22"
                                                    Height="22"
                                                    ToolTip="Copy notification"
                                                    Click="CopyTicketNotificationButton_Click">
                                                <TextBlock Style="{StaticResource CopyGlyph}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Problem / Issue -->
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Problem / Issue"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketProblemIssueTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Work Order -->
                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Work Order"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TicketWorkOrderTextBlock"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center" />

                                            <Button x:Name="CopyTicketWorkOrderButton"
                                                    Style="{StaticResource MiniIconButton}"
                                                    Margin="6,0,0,0"
                                                    Width="22"
                                                    Height="22"
                                                    ToolTip="Copy work order"
                                                    Click="CopyTicketWorkOrderButton_Click">
                                                <TextBlock Style="{StaticResource CopyGlyph}" />
                                            </Button>

                                            <Border x:Name="TicketWorkOrderTypeBadge"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource TabBgHover}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TicketWorkOrderTypeTextBlock"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Border>

                                            <Button x:Name="RequestCapitalButton"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="Request Capital"
                                                    Padding="12,0"
                                                    Height="28"
                                                    Visibility="Collapsed"
                                                    Click="RequestCapitalButton_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Assigned To -->
                                    <Grid Grid.Row="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Assigned To"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketAssignedToTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>

                                    <!-- Date Created + Current Status -->
                                    <Grid Grid.Row="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Date Created"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <TextBlock x:Name="TicketDateCreatedTextBlock"
                                                   Grid.Column="1"
                                                   Foreground="{DynamicResource TextPrimary}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="Status"
                                                   Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                        <Border x:Name="TicketStatusBadge"
                                                Grid.Column="4"
                                                Padding="8,2"
                                                CornerRadius="10"
                                                Background="{DynamicResource TabBgHover}"
                                                BorderBrush="{DynamicResource SurfaceBorder}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="TicketStatusTextBlock"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Write Up"
                                           Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                <TextBox x:Name="WriteUpTextBox"
                                         Grid.Row="2"
                                         MinHeight="260"
                                         Height="Auto"
                                         Padding="6,6,0,0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="WriteUpTextBox_TextChanged" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Site History -->
                    <Grid x:Name="SiteHistoryPanel" Margin="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="HistoryDataGrid"
                                  Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="HistoryDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TabBgHover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding DateText}" />
                                <DataGridTextColumn Header="Tech 1" Width="145" Binding="{Binding Tech1Text}" />
                                <DataGridTextColumn Header="Tech 2" Width="145" Binding="{Binding Tech2Text}" />
                                <DataGridTextColumn Header="Site Issue" Width="*" Binding="{Binding IssueText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Site History Write-Up"
                                       Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,0,12"
                                    Background="{DynamicResource SurfaceBg}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="NarrativeTextBlock"
                                               Padding="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Equipment -->
                    <Grid x:Name="EquipmentPanel" Margin="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Enclosure"
                                               Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                    <TextBox x:Name="EnclosureCardTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource WorkspaceReadOnlyBoxStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Primary Communications"
                                                Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                    <TextBox x:Name="PrimaryCardTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource WorkspaceReadOnlyBoxStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Secondary Communications"
                                               Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                    <TextBox x:Name="SecondaryCardTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource WorkspaceReadOnlyBoxStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Grid.Column="2"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Antenna"
                                               Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                    <TextBox x:Name="AntennaCardTextBox"
                                             Grid.Row="2"
                                             Style="{StaticResource WorkspaceReadOnlyBoxStyle}" />
                                </Grid>
                            </Border>

                            <!-- hidden raw text source used for parsing/lookups -->
                            <TextBox x:Name="EquipmentTextBox"
                                     Visibility="Collapsed" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Replacement Entry"
                                           Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Serialized Item"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                    <ComboBox x:Name="ReplacementItemComboBox"
                                              Grid.Column="1"
                                              SelectionChanged="ReplacementItemComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Enclosure SN"/>
                                        <ComboBoxItem Content="Primary SN"/>
                                        <ComboBoxItem Content="Secondary SN"/>
                                        <ComboBoxItem Content="Antenna SN"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="3"
                                               Text="Old Serial"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                    <TextBox x:Name="OldSerialTextBox"
                                             Grid.Column="4"
                                             Style="{StaticResource WorkspaceEditorBoxStyle}"
                                             IsReadOnly="True" />
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="New Serial"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                    <TextBox x:Name="NewSerialTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource WorkspaceEditorBoxStyle}" />

                                    <Button x:Name="AddReplacementToWriteUpButton"
                                            Grid.Column="3"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Add to Write Up"
                                            Click="AddReplacementToWriteUpButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    
                    <!-- SNMP -->
                    <Grid x:Name="SnmpPanel" Margin="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="190"/>
                        </Grid.RowDefinitions>

                        <!-- Summary / target -->
                        <Border Grid.Row="0"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="SNMP Tool"
                                               Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                    <Button x:Name="RunSelectedSnmpButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Run Selected"
                                            Height="28"
                                            Padding="12,0"
                                            Click="RunSelectedSnmpButton_Click" />

                                    <Button x:Name="RefreshSnmpButton"
                                            Grid.Column="3"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Refresh Config"
                                            Height="28"
                                            Padding="12,0"
                                            Click="RefreshSnmpButton_Click" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Support"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />
                                    <TextBlock x:Name="SnmpSupportTextBlock"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Column="3"
                                               Text="Profile"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />
                                    <TextBlock x:Name="SnmpProfileTextBlock"
                                               Grid.Column="4"
                                               Foreground="{DynamicResource TextPrimary}" />

                                    <TextBlock Grid.Column="6"
                                               Text="Family"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />
                                    <TextBlock x:Name="SnmpFamilyTextBlock"
                                               Grid.Column="7"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- OID list -->
                        <Border Grid.Row="2"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Configured OIDs"
                                           Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                <!-- Target -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Target"
                                               Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                    <TextBox x:Name="SnmpTargetTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource WorkspaceEditorBoxStyle}"
                                             Height="28"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             LostFocus="SnmpTargetTextBox_LostFocus" />
                                </Grid>

                                <!-- Set value -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                       Text="Set Value"
                       Style="{StaticResource WorkspaceMiniLabelStyle}" />

                                    <TextBox x:Name="SnmpSetValueTextBox"
                     Grid.Column="1"
                     Style="{StaticResource WorkspaceEditorBoxStyle}"
                     Height="28"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     IsEnabled="False" />

                                    <Button x:Name="SetSelectedSnmpButton"
                    Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Set Selected"
                    Height="28"
                    Padding="12,0"
                    IsEnabled="False"
                    Click="SetSelectedSnmpButton_Click" />

                                    <TextBlock x:Name="SnmpSetHintTextBlock"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Select a writable OID to enable setting a value." />
                                </Grid>

                                <DataGrid x:Name="SnmpOidDataGrid"
                  Grid.Row="6"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  BorderThickness="0"
                  Background="Transparent"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionChanged="SnmpOidDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category"
                                    Width="120"
                                    Binding="{Binding Category}" />
                                        <DataGridTextColumn Header="Label"
                                    Width="180"
                                    Binding="{Binding Label}" />
                                        <DataGridTextColumn Header="OID"
                                    Width="*"
                                    Binding="{Binding Oid}" />
                                        <DataGridTextColumn Header="Type"
                                    Width="90"
                                    Binding="{Binding ValueType}" />
                                        <DataGridTextColumn Header="Decode"
                                    Width="90"
                                    Binding="{Binding DecodeMode}" />
                                        <DataGridCheckBoxColumn Header="Writable"
                                        Width="80"
                                        Binding="{Binding IsWritable}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Preview -->
                        <Border Grid.Row="4"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="SNMP Preview"
                                           Style="{StaticResource WorkspaceSectionHeaderStyle}" />

                                <TextBox x:Name="SnmpPreviewTextBox"
                                         Grid.Row="2"
                                         Style="{StaticResource WorkspaceReadOnlyBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>