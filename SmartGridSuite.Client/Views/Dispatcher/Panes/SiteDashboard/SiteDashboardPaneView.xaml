<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboardPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sd="clr-namespace:SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <sd:SiteDashboardTopBarView x:Name="TopBarView"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3" />

        <sd:SiteDashboardNetworkView x:Name="NetworkView"
                                     Grid.Row="2"
                                     Grid.Column="0" />

        <sd:SiteDashboardWorkspaceView x:Name="WorkspaceView"
                                       Grid.Row="2"
                                       Grid.Column="2" />
    </Grid>
</UserControl>