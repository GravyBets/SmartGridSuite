<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteDashboard.SiteDashboardTopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="AttachedTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="AttachedTabItemStyle" TargetType="TabItem">            
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                        Background="{DynamicResource TabBgHover}"
                        BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="16,16,0,0"
                        Padding="18,9,14,8"
                        SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                <Setter Property="Panel.ZIndex" Value="20"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!--Add Tab Button-->
        <Style x:Key="AddTabButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Margin" Value="0,-1,0,0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!--Close Tabs Button-->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarInfoBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ControlSecondaryBg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopBarLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TopBarValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TopBarCleanCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                        CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs outside card, visually attached -->
        <DockPanel Grid.Row="0"
                   LastChildFill="False"
                   Margin="20,0,0,-1"
                   Panel.ZIndex="6">
            <TabControl x:Name="SiteTabsControl"
                        Style="{StaticResource AttachedTabControlStyle}"
                        DockPanel.Dock="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="SiteTabsControl_SelectionChanged">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource AttachedTabItemStyle}" />
                </TabControl.ItemContainerStyle>
            </TabControl>

            <Button x:Name="AddTabButton"
                    DockPanel.Dock="Left"
                    Style="{StaticResource AddTabButtonStyle}"
                    Content="+"
                    Click="AddTabButton_Click" />
        </DockPanel>

        <!-- Site Dashboard status -->
        <TextBlock x:Name="TopBarStatusTextBlock"
                   Grid.Row="0"
                   Margin="0,0,12,6"
                   MaxWidth="520"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        
        <!-- Card -->
        <Border Grid.Row="1"
                Padding="12"
                CornerRadius="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="98"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{DynamicResource ModernWatermarkTextBox}"
                             Height="34"
                             Padding="12,0,12,0"
                             VerticalContentAlignment="Center"                             
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown" />

                    <TextBlock x:Name="SearchWatermarkTextBlock"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               IsHitTestVisible="False"
                               Text="Enter a site ID and load the dashboard." />
                </Grid>

                <!-- Load -->
                <Button x:Name="LoadButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"                        
                        Content="Load"
                        Click="LoadButton_Click" />

                <!-- Address -->
                <Border Grid.Column="4"
                        Style="{StaticResource TopBarInfoBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Address:"
                                   Style="{StaticResource TopBarLabelStyle}" />

                        <TextBlock x:Name="AddressTextBlock"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource TopBarValueStyle}"
                                   Text="—" />

                        <Button x:Name="CopyAddressButton"
                                Grid.Column="2"
                                Style="{StaticResource TopBarCleanCopyButtonStyle}"
                                ToolTip="Copy address"
                                Click="CopyAddressButton_Click">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>

                    </Grid>
                </Border>

                <!-- Coords -->
                <Border Grid.Column="6"
                        Style="{StaticResource TopBarInfoBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Coords:"
                                   Style="{StaticResource TopBarLabelStyle}" />

                        <TextBlock x:Name="CoordinatesTextBlock"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource TopBarValueStyle}"
                                   Text="—" />

                        <Button x:Name="CopyCoordinatesButton"
                                Grid.Column="2"
                                Style="{StaticResource TopBarCleanCopyButtonStyle}"
                                ToolTip="Copy coordinates"
                                Click="CopyCoordinatesButton_Click">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Pop-Out -->
                <Button x:Name="PopOutButton"
                        Grid.Column="8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,0"
                        MinWidth="96"
                        Click="PopOutButton_Click">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource PopOutGlyph}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="Pop-Out"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Button>


            </Grid>
        </Border>
    </Grid>
</UserControl>