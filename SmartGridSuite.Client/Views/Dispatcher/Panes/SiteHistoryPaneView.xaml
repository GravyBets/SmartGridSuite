<UserControl x:Class="SmartGridSuite.Client.Views.Dispatcher.Panes.SiteHistoryPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header card only -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Site History"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Search a site, review history, and correct SmartGridSuite write-ups."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Search + history grid -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SiteSearchTextBox"
                                 Grid.Column="0"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 Tag="Type in a Site #"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 KeyDown="SiteSearchTextBox_KeyDown"/>

                        <Button Grid.Column="2"
                                Content="Search"
                                Width="90"
                                Height="34"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Search_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ResultsHeaderTextBlock"
                                   Text="Search for a site"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock x:Name="ResultsCountTextBlock"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="HistoryGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              ItemsSource="{Binding HistoryRows}"
                              SelectionChanged="HistoryGrid_SelectionChanged"
                              Style="{StaticResource ThemedDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / Time"
                                                Width="145"
                                                Binding="{Binding DateTimeText}"/>

                            <DataGridTextColumn Header="Tech 1"
                                                Width="140"
                                                Binding="{Binding Tech1Text}"/>

                            <DataGridTextColumn Header="Tech 2"
                                                Width="140"
                                                Binding="{Binding Tech2Text}"/>

                            <DataGridTextColumn Header="Issue"
                                                Width="*"
                                                Binding="{Binding IssueText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"/>

            <!-- RIGHT: Selected history details -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Selected Write-Up"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock x:Name="EditAuditTextBlock"
                                   Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock x:Name="SelectedHintTextBlock"
                               Grid.Row="2"
                               Text="Select a history row to view it."
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"/>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">
                            <TextBlock Text="Date / Time"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="DateTimeTextBox"
                                     Height="32"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">
                            <TextBlock Text="Primary Tech"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="Tech1TextBox"
                                     Height="32"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="Secondary Tech / Crew"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="Tech2TextBox"
                                     Height="32"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="Issue"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="IssueTextBox"
                                     Height="32"
                                     Margin="0,4,0,0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="DetailTextBox_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="5"
                               Text="Write-Up Body"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Bottom"/>

                    <TextBox x:Name="NarrativeTextBox"
                             Grid.Row="6"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top"
                             IsReadOnly="True"
                             Padding="10"
                             FontSize="14"
                             TextChanged="DetailTextBox_TextChanged"
                             Style="{StaticResource ModernTextBox}"/>

                    <StackPanel Grid.Row="8"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="EditButton"
                                Content="Edit"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Edit_Click"
                                IsEnabled="False"/>

                        <Button x:Name="SaveButton"
                                Content="Save"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Save_Click"
                                IsEnabled="False"/>

                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Width="90"
                                Height="32"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Cancel_Click"
                                IsEnabled="False"/>

                        <Button x:Name="DeleteButton"
                                Content="Delete"
                                Width="90"
                                Height="32"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Delete_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>