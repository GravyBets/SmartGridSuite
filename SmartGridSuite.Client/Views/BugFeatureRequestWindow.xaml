<Window x:Class="SmartGridSuite.Client.Views.BugFeatureRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bug / Feature Request"
        Width="700"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}"
        ContentRendered="Window_ContentRendered">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="12"
                Style="{StaticResource Card}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="46"
                        Height="46"
                        Margin="0,0,12,0"
                        CornerRadius="12"
                        Background="{DynamicResource PrimaryBg}">

                    <TextBlock Text="!"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Bug / Feature Request"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Create a structured request and copy it to the clipboard. Nothing is submitted automatically."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <Border Grid.Row="2"
                Padding="15"
                Style="{StaticResource Card}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="8"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="4"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Request type -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="4,0,0,0"
                           Text="Request type"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <ComboBox x:Name="RequestTypeComboBox"
                          Grid.Row="2"
                          Grid.Column="0"
                          Height="36"
                          Width="308"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource ModernComboBox}">

                    <ComboBoxItem Content="Bug"
                      IsSelected="True"/>

                    <ComboBoxItem Content="Feature Request"/>

                    <ComboBoxItem Content="Improvement"/>
                </ComboBox>

                <!-- Application area -->
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Area of the application"
                           Margin="4,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <ComboBox x:Name="AreaComboBox"
                          Grid.Row="2"
                          Grid.Column="2"
                          Height="36"
                          Width="308"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource ModernComboBox}">

                    <ComboBoxItem Content="Launcher"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="Site Dashboard"/>

                    <ComboBoxItem Content="Field Technician"/>

                    <ComboBoxItem Content="Dispatcher"/>

                    <ComboBoxItem Content="Administration"/>

                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Short title -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Text="Short title"
                           Margin="4,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBox x:Name="RequestTitleTextBox"
                         Grid.Row="6"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Height="36"
                         MaxLength="120"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="{DynamicResource CardBorder}"
                         Background="{DynamicResource SurfaceBg}"
                         Foreground="{DynamicResource TextPrimary}"/>

                <!-- Details -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Text="Details"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Text="Describe what happened or what should change. For bugs, include steps to reproduce plus the expected and actual results."
                           TextWrapping="Wrap"                           
                           Foreground="{DynamicResource TextSecondary}"/>

                <TextBox x:Name="DetailsTextBox"
                         Grid.Row="12"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         MinHeight="240"
                         MaxLength="6000"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="10"
                         BorderBrush="{DynamicResource CardBorder}"
                         Background="{DynamicResource SurfaceBg}"
                         Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       MaxWidth="360"
                       VerticalAlignment="Center"
                       Text="The copied template includes your Windows username, local date/time, and application version."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>

            <Button Grid.Column="1"
                    Width="92"
                    Height="34"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>

            <Button Grid.Column="3"
                    Width="126"
                    Height="34"
                    Content="Copy Request"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CopyRequest_Click"/>
        </Grid>
    </Grid>
</Window>