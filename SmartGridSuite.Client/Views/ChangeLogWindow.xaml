<Window x:Class="SmartGridSuite.Client.Views.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Grid Suite Change Log"
        Width="650"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Change Log"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Recent updates and improvements to Smart Grid Suite."
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <Image Grid.Column="1"
                       Source="/Assets/Branding/SmartGridSuite_Logo.png"
                       Width="52"
                       Height="52"
                       Margin="16,0,0,0"
                       Stretch="Uniform"/>
            </Grid>
        </Border>

        <!-- Change-log content -->
        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- July 20 -->
                    <TextBlock Text="July 20, 2026"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,12"
                               Text="Launcher and support-window cleanup"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <StackPanel Margin="4,0,10,0">
                        <TextBlock Text="• About and Bug / Feature Request were moved into dedicated XAML windows."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• About was redesigned with company branding and a more compact layout."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Change Log was moved into its own dedicated window."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Bug / Feature Request now generates a structured clipboard template."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <Border Height="1"
                            Margin="0,20"
                            Background="{DynamicResource CardBorder}"/>

                    <!-- July 16 -->
                    <TextBlock Text="July 16, 2026"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,12"
                               Text="Dispatch, General Settings, and Site Dashboard updates"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <StackPanel Margin="4,0,10,0">
                        <TextBlock Text="• Communication Device Types can now be added, edited, deleted, and managed from General Settings."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Dispatch can copy selected Work Orders as a vertical list for Excel and time entry."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Work Order length protection was added across the UI, API, and database."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Dispatch can edit technician write-ups from the task details pane."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="• Site Dashboard write-up typing performance was improved."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4"
                Width="96"
                Height="34"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="Close_Click"/>
    </Grid>
</Window>