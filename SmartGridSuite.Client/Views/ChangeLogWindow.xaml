<Window x:Class="SmartGridSuite.Client.Views.ChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Grid Suite Change Log"
        Width="650"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Change Log"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Recent updates and improvements to Smart Grid Suite."
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <Image Grid.Column="1"
                       Source="/Assets/Branding/SmartGridSuite_Logo.png"
                       Width="52"
                       Height="52"
                       Margin="16,0,0,0"
                       Stretch="Uniform"/>
            </Grid>
        </Border>

        <!-- Change-log content -->
        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardBorder}"
                Background="{DynamicResource CardBackground}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="ChangeLogItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                               Text="{Binding Date}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                                    <Border Grid.Column="1"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="{DynamicResource AppBackground}">

                                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,4,0,12"
                           Text="{Binding Title}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"/>

                                <ItemsControl ItemsSource="{Binding Changes}"
                              Margin="4,0,10,0">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextPrimary}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1"
                        Margin="0,16,0,20"
                        Background="{DynamicResource CardBorder}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4"
                Width="96"
                Height="34"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="Close_Click"/>
    </Grid>
</Window>