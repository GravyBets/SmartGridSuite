<Fluent:RibbonWindow x:Class="SmartGridSuite.Client.Views.FieldTechnician.FieldTechnicianShellWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:Fluent="urn:fluent-ribbon"
                     Title="Smart Grid Suite - Field Technician"
                     WindowState="Maximized"
                     WindowStartupLocation="CenterScreen"
                     Background="{DynamicResource AppBackground}">

    <Grid x:Name="ShellRoot"
      Margin="10,0,10,22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent connection warning shown without interrupting field work. -->
        <Border x:Name="ConnectivityBanner"
            Grid.Row="0"
            Margin="0,8,0,8"
            Padding="12,8"
            CornerRadius="10"
            BorderBrush="#D69E00"
            BorderThickness="1"
            Background="#22D69E00"
            Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                     Width="9"
                     Height="9"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Fill="#D69E00"/>

                <TextBlock x:Name="ConnectivityMessageText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

                <Button x:Name="ConnectivityRetryButton"
                    Grid.Column="2"
                    Margin="14,0,0,0"
                    Height="30"
                    Padding="14,0"
                    Content="Retry"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RetryConnectivity_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="280"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nav header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Field Technician"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="Workspace"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <Button x:Name="NavHeaderBtn"
                                Grid.Column="1"
                                Style="{StaticResource NavRailToggleButtonStyle}"
                                Content="☰"
                                ToolTip="Collapse / Expand"
                                Click="ToggleNav_Click"/>
                    </Grid>

                    <TextBlock x:Name="NavSectionLabel"
                               Grid.Row="1"
                               Text="Navigation Panes"
                               Style="{StaticResource NavRailSectionTextStyle}"
                               Margin="4,0,0,8"/>

                    <!-- Expanded nav -->
                    <ListBox x:Name="NavListExpanded"
                             Grid.Row="2"
                             Style="{StaticResource NavRailListStyle}"
                             ItemContainerStyle="{StaticResource NavRailItemStyle}"
                             SelectionChanged="NavList_SelectionChanged">

                        <ListBoxItem Tag="Site Dashboard">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <TextBlock Text="S"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="Site Dashboard"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Lookup, diagnostics, write-ups"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="Tasks">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <TextBlock Text="T"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="Tasks"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Assigned work"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="History">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <TextBlock Text="H"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="History"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Closed work from the last 30 days"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Collapsed nav -->
                    <ListBox x:Name="NavListCollapsed"
                             Grid.Row="2"
                             Style="{StaticResource NavRailListStyle}"
                             ItemContainerStyle="{StaticResource NavRailCollapsedItemStyle}"
                             SelectionChanged="NavList_SelectionChanged"
                             Visibility="Collapsed">

                        <ListBoxItem Tag="Site Dashboard" ToolTip="Site Dashboard">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <TextBlock Text="S"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"/>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="Tasks" ToolTip="Tasks">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <TextBlock Text="T"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="History" ToolTip="History">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <TextBlock Text="H"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Home button -->
                    <StackPanel Grid.Row="3"
                                Margin="0,12,0,0">
                        <Border Height="1"
                                Margin="4,0,4,12"
                                Background="{DynamicResource CardBorder}"/>

                        <Button x:Name="HomeButtonExpanded"
                                Style="{StaticResource NavRailFooterButtonStyle}"
                                Click="HomeButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <TextBlock Text="⌂"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Home"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Back to start screen"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="HomeButtonCollapsed"
                                Style="{StaticResource NavRailCollapsedFooterButtonStyle}"
                                Click="HomeButton_Click"
                                ToolTip="Home"
                                Visibility="Collapsed">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <TextBlock Text="⌂"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="14"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True"/>

            <ContentControl x:Name="MainPaneHost"
                            Grid.Column="2"/>
        </Grid>
    </Grid>
</Fluent:RibbonWindow>