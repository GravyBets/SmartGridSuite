<UserControl x:Class="SmartGridSuite.Client.Views.FieldTechnician.Panes.FieldTechHistoryPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Matches the compact table styling used in Dispatch Tickets and Tasks. -->
        <!-- Compact copy glyph used beside Notification and Work Order values. -->
        <Style x:Key="CopyGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE8C8;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Temporary confirmation glyph shown after an individual value is copied. -->
        <Style x:Key="CheckGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Small transparent control containing the circled expand/collapse chevron. -->
        <Style x:Key="HistoryExpandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatCopyIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ToolTip" Value="Show or hide submitted write-up"/>
        </Style>

        <!-- Circled expand/collapse chevron with a write-up-present indicator. -->
        <DataTemplate x:Key="HistoryExpandRowCellTemplate">
            <Grid Width="28"
                  Height="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Button Style="{StaticResource HistoryExpandButtonStyle}"
                        Click="ToggleHistoryRowDetails_Click"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Grid Width="18"
                          Height="18">

                        <Ellipse x:Name="ChevronCircle"
                                 Width="18"
                                 Height="18"
                                 Fill="Transparent"
                                 Stroke="{DynamicResource TextPrimary}"
                                 StrokeThickness=".75"/>

                        <Path x:Name="ChevronPath"
                              Width="8"
                              Height="6"
                              Margin="0,0,0,-2"
                              Data="M 0,0 L 4,4 L 8,0"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RenderTransformOrigin=".45,.35">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>

                <!-- Blue dot indicates a submitted write-up is available. -->
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Background="{DynamicResource PrimaryBg}"
                        BorderBrush="{DynamicResource CardBackground}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-1,-1,0"
                        ToolTip="Submitted write-up available">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubmittedNarrative}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SubmittedNarrative}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DetailsVisibility,
                                      RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                     Value="Visible">
                    <Setter TargetName="ChevronPath"
                    Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Borderless expanded content for the submitted write-up. -->
        <DataTemplate x:Key="HistoryRowDetailsTemplate">
            <Grid Margin="76,4,10,12">
                <ScrollViewer MaxHeight="380"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Submitted Write-Up"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding SubmittedNarrative}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubmittedNarrative}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding SubmittedNarrative}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No submitted write-up text was found for this history row."
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubmittedNarrative}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding SubmittedNarrative}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <Style x:Key="HistoryTrimCellText"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Keeps current Work Orders prominent because they drive time entry. -->
        <Style x:Key="HistoryWorkOrderText"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource HistoryTrimCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Matches the compact Dispatch grid column-header style. -->
        <Style x:Key="HistoryGridColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ThemedDataGridColumnHeaderStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="HistoryFilterLabelText"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="HistoryCountCardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pane header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="My History"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Completed write-ups for time entry. Work Orders always reflect the ticket's latest valid Work Order."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <Button x:Name="RefreshHistoryButton"
                    Grid.Column="1"
                    Content="Refresh"
                    Height="34"
                    Padding="12,0"
                    Width="72"
                    VerticalAlignment="Top"
                    Click="Refresh_Click"/>
        </Grid>

        <!-- API-driven filters -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition x:Name="CustomFromColumn" Width="0"/>
                <ColumnDefinition x:Name="CustomDateSpacerColumn" Width="0"/>
                <ColumnDefinition x:Name="CustomToColumn" Width="0"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Search"
                       Style="{StaticResource HistoryFilterLabelText}"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="Completed Date Range"
                       Style="{StaticResource HistoryFilterLabelText}"/>

            <TextBlock x:Name="FromDateLabel"
                       Grid.Row="0"
                       Grid.Column="4"
                       Text="From"
                       Visibility="Collapsed"
                       Style="{StaticResource HistoryFilterLabelText}"/>

            <TextBlock x:Name="ToDateLabel"
                       Grid.Row="0"
                       Grid.Column="6"
                       Text="To"
                       Visibility="Collapsed"
                       Style="{StaticResource HistoryFilterLabelText}"/>

            <TextBox x:Name="SearchBox"
                     Grid.Row="2"
                     Grid.Column="0"
                     Style="{StaticResource ClearableSearchTextBox}"
                     Tag="Search site, notification, work order, status, problem, or write-up..."
                     Height="36"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="DateRangeFilter"
                      Grid.Row="2"
                      Grid.Column="2"
                      Height="36"
                      Width="Auto"
                      MinWidth="0"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="DisplayName"
                      TextSearch.TextPath="DisplayName"
                      SelectionChanged="DateRangeFilter_SelectionChanged"/>

            <DatePicker x:Name="FromDatePicker"
                        Grid.Row="2"
                        Grid.Column="4"
                        Style="{DynamicResource ModernDatePicker}"
                        Height="36"
                        Width="Auto"                        
                        Margin="0,0,8,0"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        SelectedDateChanged="CustomDate_SelectedDateChanged"/>

            <DatePicker x:Name="ToDatePicker"
                        Grid.Row="2"
                        Grid.Column="6"
                        Style="{DynamicResource ModernDatePicker}"
                        Height="36"
                        Width="Auto"
                        MinWidth="0"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"
                        SelectedDateChanged="CustomDate_SelectedDateChanged"/>

            <Button x:Name="ApplyHistoryFiltersButton"
                    Grid.Row="2"
                    Grid.Column="8"
                    Content="Apply"
                    Height="36"
                    Padding="12,0"
                    Width="72"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ApplyFilters_Click"/>
        </Grid>

        <!-- Summary counts supplied by the API -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource HistoryCountCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalCompletedCount}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Completed Write-Ups"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource HistoryCountCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding WithWorkOrderCount}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Work Orders Available"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource HistoryCountCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding WithoutWorkOrderCount}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Missing Current Work Order"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="5"
                       Text="{Binding AppliedDateRangeText}"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
        </Grid>

        <!-- History table -->
        <Border Grid.Row="6"
                Style="{StaticResource Card}"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           LastChildFill="True">

                    <Button x:Name="CopySelectedOrdersButton"
                            DockPanel.Dock="Right"
                            Content="Copy Selected Orders"
                            Height="30"
                            MinWidth="148"
                            Padding="12,0"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="CopySelectedOrders_Click"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Completed Work"
                                   Margin="2,0,0,0"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Based on write-up submission date"
                                   Margin="2,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="HistoryGrid"
                          Grid.Row="2"
                          Style="{StaticResource ThemedDataGridStyle}"
                          ItemsSource="{Binding HistoryItems}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          MinRowHeight="34"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource SurfaceBorder}"
                          ColumnHeaderStyle="{StaticResource HistoryGridColumnHeaderStyle}"
                          RowDetailsVisibilityMode="Collapsed"
                          RowDetailsTemplate="{StaticResource HistoryRowDetailsTemplate}"
                          LoadingRow="HistoryGrid_LoadingRow"
                          HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="HistoryGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="42"
                                                CanUserResize="False"
                                                CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="HistoryHeaderSelectAllCheckBox"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ToolTip="Select or clear all showing completed work"
                                          Click="HistoryHeaderSelectAllCheckBox_Click"/>
                            </DataGridTemplateColumn.Header>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              IsChecked="{Binding IsSelected,
                                                                  RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                                  Mode=OneWay}"
                                              PreviewMouseLeftButtonDown="HistoryRowCheckBox_PreviewMouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Notes"
                                                Width="66"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                CellTemplate="{StaticResource HistoryExpandRowCellTemplate}"/>

                        <DataGridTextColumn Header="Completed"
                                            Width="Auto"
                                            Binding="{Binding CompletedAt, StringFormat={}{0:ddd\, MM/dd/yy HH:mm}}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                        <DataGridTextColumn Header="Site"
                                            Width="80"
                                            Binding="{Binding Site}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                        <DataGridTextColumn Header="Notification Name"
                                            Width="2*"
                                            Binding="{Binding NotificationName}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                        <DataGridTextColumn Header="Problem / Issue"
                                            Width="2*"
                                            Binding="{Binding Problem}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                        <DataGridTemplateColumn Header="Notification"
                                                Width="138">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Notification}"
                                                   Style="{StaticResource HistoryTrimCellText}"/>

                                        <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                Tag="{Binding Notification}"
                                                ToolTip="Copy notification"
                                                Click="CopyGridValue_Click">

                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource FlatCopyIconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Notification}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Notification}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                            <TextBlock Style="{StaticResource CopyGlyph}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Work Order"
                                                Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CurrentWorkOrder}"
                                                   Style="{StaticResource HistoryWorkOrderText}"/>

                                        <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Margin="4,0,0,0"
                                                Tag="{Binding CurrentWorkOrder}"
                                                ToolTip="Copy current work order"
                                                Click="CopyGridValue_Click">

                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource FlatCopyIconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding CurrentWorkOrder}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                            <TextBlock Style="{StaticResource CopyGlyph}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="WO Type"
                                            Width="105"
                                            Binding="{Binding CurrentWorkOrderType}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                        <DataGridTextColumn Header="Current Status"
                                            Width="225"
                                            Binding="{Binding CurrentStatus}"
                                            ElementStyle="{StaticResource HistoryTrimCellText}"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="7"
                   Text="{Binding StatusMessage}"
                   Margin="4,10,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"/>

        <!-- Loading overlay -->
        <Border x:Name="BusyOverlay"
                Grid.Row="0"
                Grid.RowSpan="8"
                Panel.ZIndex="100"
                Background="#66000000"
                Visibility="Collapsed">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Padding="22"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Loading"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Margin="0,18,0,14"/>

                    <TextBlock x:Name="BusyOverlayMessageTextBlock"
                               Text="Loading completed write-up history..."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>