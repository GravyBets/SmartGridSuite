<UserControl x:Class="SmartGridSuite.Client.Views.FieldTechnician.Panes.FieldTechHistoryPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="0">
        <Border Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="My History"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Closed tickets completed by this technician. Default view: last 30 days."
                                   Margin="0,4,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Refresh"
                            Height="34"
                            Padding="16,0"
                            Click="Refresh_Click"/>
                </Grid>

                <!-- Body placeholder -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16"
                        Background="{DynamicResource CardBackground}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="History pane is ready."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Next we’ll bind this to closed tickets from the last 30 days."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>