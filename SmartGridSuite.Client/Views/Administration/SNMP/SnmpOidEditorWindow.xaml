<Window x:Class="SmartGridSuite.Client.Views.Administration.SNMP.SnmpOidEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNMP OID Editor"
        Width="1040"
        Height="780"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <StackPanel>
                <TextBlock x:Name="WindowTitleTextBlock"
                           Text="SNMP OID"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Configure the OID, display settings, and decoder values."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Main -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">

            <Grid>
                <Grid.RowDefinitions>
                <!-- OID Details -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="4"/>
                <!-- Decoder -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="4"/>
                <!-- Formula Decoder -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="4"/>
                <!-- Decode Values -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Basic OID fields -->
            <Border Grid.Row="0"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="OID Details"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Category"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  Grid.Column="2"
                                  Height="34"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Config"/>
                            <ComboBoxItem Content="Stats"/>
                        </ComboBox>

                        <TextBlock Grid.Column="4"
                                   Text="Label"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="LabelTextBox"
                                 Grid.Column="6"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="8"
                                   Text="OID"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="OidTextBox"
                                 Grid.Column="10"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Type"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="ValueTypeComboBox"
                                  Grid.Column="2"
                                  Height="34"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="String"/>
                            <ComboBoxItem Content="Integer"/>
                        </ComboBox>
                        

                        <TextBlock Grid.Column="4"
                                   Text="Sort"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="SortOrderTextBox"
                                 Grid.Column="6"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <CheckBox x:Name="WritableCheckBox"
                                  Grid.Column="8"
                                  Content="Writable"
                                  VerticalAlignment="Center"/>

                        <CheckBox x:Name="ShowInWorkspaceCheckBox"
                                  Grid.Column="10"
                                  Content="Show in Workspace"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Decoder settings -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Decoder"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Decode Mode"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="DecodeModeComboBox"
                                  Grid.Column="2"
                                  Height="34"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Raw"/>
                            <ComboBoxItem Content="ValueMap"/>
                            <ComboBoxItem Content="Formula"/>
                        </ComboBox>

                        <CheckBox x:Name="ShowRawAlongsideDecodedCheckBox"
                                  Grid.Column="4"
                                  Content="Show raw value alongside decoded"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Formula decoder settings -->
            <Border x:Name="FormulaDecodeBorder"
                    Grid.Row="4"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Formula Decoder"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Read Formula ="
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBox x:Name="ReadFormulaTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Raw radio value to displayed value. Example: x / 100000"/>

                        <TextBlock Grid.Column="4"
                                   Text="Write Formula ="
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBox x:Name="WriteFormulaTextBox"
                                 Grid.Column="6"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Displayed/user-entered value to raw radio SET value. Example: x * 100000"/>

                        <TextBlock Grid.Column="8"
                                   Text="Decimals"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBox x:Name="DecimalPlacesTextBox"
                                 Grid.Column="10"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 TextAlignment="Center"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="12"
                                   Text="Unit"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBox x:Name="UnitLabelTextBox"
                                 Grid.Column="14"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Text="Use x as the input value. Read Formula converts raw radio response to display. Write Formula converts user-entered display value back to the whole-number radio SET value."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <!-- Formula Preview -->
                    <Border Grid.Row="6"
                            Background="{DynamicResource TileFillHover}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Formula Preview"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <!-- Raw radio value preview -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Read Formula"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBox x:Name="RawFormulaPreviewTextBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernWatermarkTextBox}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Enter example raw value"
                                         ToolTip="Example raw value returned by the radio. Example: 75700125 or 12"/>

                                <TextBlock Grid.Column="4"
                                           Text="Display Preview"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBlock x:Name="ReadFormulaPreviewTextBlock"
                                           Grid.Column="6"
                                           Text="—"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- User/display value preview -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Write Formula"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBox x:Name="DisplayFormulaPreviewTextBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernWatermarkTextBox}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Tag="Enter expected value"
                                         ToolTip="Example value a user would type before SET. Example: 757.00125 or 1.2"/>

                                <TextBlock Grid.Column="4"
                                           Text="Raw SET Preview"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>

                                <TextBlock x:Name="WriteFormulaPreviewTextBlock"
                                           Grid.Column="6"
                                           Text="—"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Decode values -->
            <Border x:Name="DecodeValuesBorder"
                    Grid.Row="6"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Decode Values"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="AddDecodeRowButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Add Decode Row"
                                    Padding="14,0"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="RemoveDecodeRowButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Remove Selected"
                                    Padding="14,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Raw"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeRawValueTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 TextAlignment="Center"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="Display"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeDisplayTextBox"
                                 Grid.Column="6"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="8"
                                   Text="Sort"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeSortOrderTextBox"
                                 Grid.Column="10"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 TextAlignment="Center"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="ApplyDecodeRowButton"
                                Grid.Column="12"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="80"
                                Content="Apply"
                                Padding="14,8"/>
                    </Grid>

                        <DataGrid x:Name="DecodeValuesDataGrid"
                                  Grid.Row="4"
                                  MinHeight="170"
                                  MaxHeight="240"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raw Value"
                                                Width="140"
                                                Binding="{Binding RawValue}" />
                            <DataGridTextColumn Header="Display Text"
                                                Width="*"
                                                Binding="{Binding DisplayText}" />
                            <DataGridTextColumn Header="Sort"
                                                Width="70"
                                                Binding="{Binding SortOrder}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="CancelButtonEx"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Cancel"
                            Padding="16,0"
                            Margin="0,0,4,0"
                            Width="96"/>

                    <Button x:Name="SaveButtonEx"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Save OID"
                            Padding="16,0"
                            Width="96"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>