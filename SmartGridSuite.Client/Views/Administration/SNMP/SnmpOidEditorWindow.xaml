<Window x:Class="SmartGridSuite.Client.Views.Administration.SNMP.SnmpOidEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNMP OID Editor"
        Width="980"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <StackPanel>
                <TextBlock x:Name="WindowTitleTextBlock"
                           Text="SNMP OID"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Configure the OID, display settings, and decoder values."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Basic OID fields -->
            <Border Grid.Row="0"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="OID Details"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Category"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="CategoryTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="Label"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="LabelTextBox"
                                 Grid.Column="4"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="6"
                                   Text="OID"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="OidTextBox"
                                 Grid.Column="7"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Type"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="ValueTypeComboBox"
                                  Grid.Column="1"
                                  Height="34"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="String"/>
                            <ComboBoxItem Content="Integer"/>
                            <ComboBoxItem Content="Gauge"/>
                            <ComboBoxItem Content="Counter"/>
                            <ComboBoxItem Content="IpAddress"/>
                        </ComboBox>

                        <TextBlock Grid.Column="3"
                                   Text="Sort"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="SortOrderTextBox"
                                 Grid.Column="4"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <CheckBox x:Name="WritableCheckBox"
                                  Grid.Column="6"
                                  Content="Writable"
                                  VerticalAlignment="Center"/>

                        <CheckBox x:Name="ShowInWorkspaceCheckBox"
                                  Grid.Column="8"
                                  Content="Show in Workspace"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Decoder settings -->
            <Border Grid.Row="2"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Decoder"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Decode Mode"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="DecodeModeComboBox"
                                  Grid.Column="1"
                                  Height="34"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Raw"/>
                            <ComboBoxItem Content="ValueMap"/>
                        </ComboBox>

                        <CheckBox x:Name="ShowRawAlongsideDecodedCheckBox"
                                  Grid.Column="3"
                                  Content="Show raw value alongside decoded"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Decode values -->
            <Border Grid.Row="4"
                    Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Decode Values"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="AddDecodeRowButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Add Decode Row"
                                    Padding="14,8"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="RemoveDecodeRowButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Remove Selected"
                                    Padding="14,8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Raw"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeRawValueTextBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="3"
                                   Text="Display"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeDisplayTextBox"
                                 Grid.Column="4"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="6"
                                   Text="Sort"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DecodeSortOrderTextBox"
                                 Grid.Column="7"
                                 Style="{StaticResource ModernWatermarkTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="ApplyDecodeRowButton"
                                Grid.Column="9"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Apply"
                                Padding="14,8"/>
                    </Grid>

                    <DataGrid x:Name="DecodeValuesDataGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Raw Value"
                                                Width="140"
                                                Binding="{Binding RawValue}" />
                            <DataGridTextColumn Header="Display Text"
                                                Width="*"
                                                Binding="{Binding DisplayText}" />
                            <DataGridTextColumn Header="Sort"
                                                Width="70"
                                                Binding="{Binding SortOrder}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="CancelButtonEx"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Cancel"
                            Padding="16,8"
                            Margin="0,0,8,0"/>

                    <Button x:Name="SaveButtonEx"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Save OID"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>