<UserControl x:Class="SmartGridSuite.Client.Views.Administration.SNMP.SnmpAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SNMP Configuration"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Manage admin-configurable SNMP profiles and OIDs for supported radio families."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshProfilesButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Refresh"
                            Padding="16,8"
                            Margin="0,0,8,0"/>

                    <Button x:Name="NewProfileButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="New Profile"
                            Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Profiles -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Profiles"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBox x:Name="ProfileSearchTextBox"
                             Grid.Row="2"
                             Style="{StaticResource ModernWatermarkTextBox}"
                             Height="34"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text=""
                             ToolTip="Search profiles"/>

                    <DataGrid x:Name="ProfilesDataGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Width="*"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Family"
                                                Width="110"
                                                Binding="{Binding DeviceFamily}" />
                            <DataGridCheckBoxColumn Header="Active"
                                                    Width="70"
                                                    Binding="{Binding IsActive}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Editor -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile basics -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Profile Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Profile Name"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="ProfileNameTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Device Family"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <ComboBox x:Name="DeviceFamilyComboBox"
                                      Grid.Column="4"
                                      Height="34"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="RF700"/>
                            </ComboBox>

                            <CheckBox x:Name="ProfileIsActiveCheckBox"
                                      Grid.Column="6"
                                      Content="Active"
                                      VerticalAlignment="Center"/>

                            <CheckBox x:Name="ProfileIsDefaultCheckBox"
                                      Grid.Column="8"
                                      Content="Default for Family"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Timeout (ms)"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="TimeoutMsTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Retries"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="RetriesTextBox"
                                     Grid.Column="4"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="6"
                                       Text="Profile ID"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock x:Name="ProfileIdTextBlock"
                                       Grid.Column="7"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="(new)"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SNMP connection settings -->
                <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>                            
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Connection Settings"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Grid.Column="2"
                                   Text="Version"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <ComboBox x:Name="SnmpVersionComboBox"
                                  Grid.Column="4"
                                  Height="34"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="v2c"/>
                            <ComboBoxItem Content="v3"/>
                        </ComboBox>

                        <!-- Communities / context -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Read Community"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="ReadCommunityTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Write Community"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="WriteCommunityTextBox"
                                     Grid.Column="4"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="6"
                                       Text="Context Name"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="ContextNameTextBox"
                                     Grid.Column="7"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- v3 identity -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="USM User"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="UsmUserTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="Auth Protocol"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="AuthProtocolComboBox"
                                      Grid.Column="4"
                                      Height="34"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="MD5"/>
                                <ComboBoxItem Content="SHA-1"/>
                                <ComboBoxItem Content="SHA-256"/>
                                <ComboBoxItem Content="SHA-384"/>
                                <ComboBoxItem Content="SHA-512"/>
                            </ComboBox>

                            <TextBlock Grid.Column="6"
                                       Text="Privacy Protocol"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="PrivacyProtocolComboBox"
                                      Grid.Column="7"
                                      Height="34"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="DES"/>
                                <ComboBoxItem Content="AES"/>
                                <ComboBoxItem Content="AES-128"/>
                                <ComboBoxItem Content="AES-256"/>
                            </ComboBox>
                        </Grid>

                        <!-- keys -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Auth Key"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <PasswordBox x:Name="AuthKeyPasswordBox"
                                         Grid.Column="1"
                                         Height="34"
                                         Padding="10,7,0,0"/>

                            <TextBlock Grid.Column="3"
                                       Text="Privacy Key"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <PasswordBox x:Name="PrivacyKeyPasswordBox"
                                         Grid.Column="4"
                                         Height="34"
                                         Padding="10,7,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OIDs -->
                <Border Grid.Row="4"
        Style="{StaticResource Card}"
        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="OID Configuration"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

                            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                                <Button x:Name="AddOidButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Add OID"
                        Padding="14,8"
                        Margin="0,0,8,0"/>

                                <Button x:Name="EditOidButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Edit Selected"
                        Padding="14,8"
                        Margin="0,0,8,0"/>

                                <Button x:Name="RemoveOidButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Remove Selected"
                        Padding="14,8"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="OidConfigDataGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category"
                                    Width="110"
                                    Binding="{Binding Category}" />
                                <DataGridTextColumn Header="Label"
                                    Width="160"
                                    Binding="{Binding Label}" />
                                <DataGridTextColumn Header="OID"
                                    Width="*"
                                    Binding="{Binding Oid}" />
                                <DataGridTextColumn Header="Type"
                                    Width="85"
                                    Binding="{Binding ValueType}" />
                                <DataGridTextColumn Header="Decode"
                                    Width="90"
                                    Binding="{Binding DecodeMode}" />
                                <DataGridCheckBoxColumn Header="Writable"
                                        Width="80"
                                        Binding="{Binding IsWritable}" />
                                <DataGridCheckBoxColumn Header="Workspace"
                                        Width="90"
                                        Binding="{Binding ShowInWorkspace}" />
                                <DataGridTextColumn Header="Sort"
                                    Width="70"
                                    Binding="{Binding SortOrder}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="6"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SnmpStatusTextBlock"
                                   Text="Ready."
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="DeactivateProfileButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Deactivate"
                                    Padding="16,8"
                                    Margin="0,0,8,0"/>

                            <Button x:Name="SaveProfileButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Save Profile"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>