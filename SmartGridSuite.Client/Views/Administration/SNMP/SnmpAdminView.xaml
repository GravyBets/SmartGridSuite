<UserControl x:Class="SmartGridSuite.Client.Views.Administration.SNMP.SnmpAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SNMP Configuration"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Manage admin-configurable SNMP profiles and OIDs."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshProfilesButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="82"
                            Content="Refresh"
                            Padding="16,6"
                            Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Profiles -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Profiles"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <Button x:Name="NewProfileButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="New Profile"
                                Padding="14,8"
                                MinWidth="112"/>
                    </Grid>

                    <TextBox x:Name="ProfileSearchTextBox"
                             Grid.Row="2"
                             Style="{StaticResource ClearableSearchTextBox}"
                             Height="34"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Tag="Search Profiles"
                             Text=""
                             ToolTip="Search profiles"/>

                    <DataGrid x:Name="ProfilesDataGrid"
                              Grid.Row="4"
                              Style="{StaticResource ThemedDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="Transparent"
                              FontSize="18"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Width="*"
                                                Binding="{Binding Name}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Editor -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Profile basics -->
                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>                            
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Profile Details"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Profile Name"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="ProfileNameTextBox"
                                     Grid.Column="2"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                        Text="Timeout (ms)"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="TimeoutMsTextBox"
                                        Grid.Column="2"
                                        Style="{StaticResource ModernWatermarkTextBox}"
                                        Height="34"
                                        Padding="10,0"
                                        VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="4"
                                        Text="Retries"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"/>

                            <TextBox x:Name="RetriesTextBox"
                                        Grid.Column="6"
                                        Style="{StaticResource ModernWatermarkTextBox}"
                                        Height="34"
                                        Padding="2,0"
                                        TextAlignment="Center"
                                        VerticalContentAlignment="Center"/>

                            <CheckBox x:Name="ProfileIsActiveCheckBox"
                                      Grid.Column="8"
                                      Content="Active"
                                      VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="10"
                                       Text="Profile ID"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock x:Name="ProfileIdTextBlock"
                                       Grid.Column="12"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="(new)"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SNMP connection settings -->
                <Border Grid.Row="2"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>                                
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Connection Settings"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>

                        <!--Version-->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Version"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>

                            <ComboBox x:Name="SnmpVersionComboBox"
                                      Grid.Column="2"
                                      Height="34"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="v2c"/>
                                <ComboBoxItem Content="v3"/>
                            </ComboBox>
                        </Grid>

                        <!-- Communities / context -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Read Community"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="ReadCommunityTextBox"
                                     Grid.Column="2"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Column="4"
                                       Text="Write Community"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="WriteCommunityTextBox"
                                     Grid.Column="6"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>                            
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Context Name"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="ContextNameTextBox"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernWatermarkTextBox}"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="4"
                                       Text="USM User"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox x:Name="UsmUserTextBox"
                                     Grid.Column="6"
                                     Style="{StaticResource ModernWatermarkTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- v3 identity -->
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>                                
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Auth Key"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <PasswordBox x:Name="AuthKeyPasswordBox"
                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                         Grid.Column="2"
                                         Height="34"
                                         Padding="4,0,0,0"/>

                            <TextBlock Grid.Column="4"
                                        Text="Auth Protocol"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="AuthProtocolComboBox"
                                        Grid.Column="6"                                        
                                        Height="34"
                                        SelectedIndex="0">
                                <ComboBoxItem Content="MD5"/>
                                <ComboBoxItem Content="SHA-1"/>
                                <ComboBoxItem Content="SHA-256"/>
                                <ComboBoxItem Content="SHA-384"/>
                                <ComboBoxItem Content="SHA-512"/>
                            </ComboBox>                                                        
                        </Grid>
                        
                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>                                
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Privacy Key"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <PasswordBox x:Name="PrivacyKeyPasswordBox"
                                         Style="{StaticResource ModernPasswordBoxStyle}"
                                         Grid.Column="2"
                                         Height="34"
                                         Padding="4,0,0,0"/>

                            <TextBlock Grid.Column="4"
                                       Text="Privacy Protocol"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox x:Name="PrivacyProtocolComboBox"
                                      Grid.Column="6"
                                      Height="34"
                                      SelectedIndex="6">
                                <ComboBoxItem Content="DES"/>
                                <ComboBoxItem Content="AES"/>
                                <ComboBoxItem Content="AES-128"/>
                                <ComboBoxItem Content="AES-256"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OIDs -->
                <Border Grid.Row="4"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="OID Configuration"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>                            
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBox x:Name="OidSearchTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ClearableSearchTextBox}"
                                     Height="34"
                                     Padding="10,0"
                                     Tag="Search OID label, category, OID, type, decode mode, formula, or unit"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Search OID label, category, OID, type, decode mode, formula, or unit"/>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal">
                                <Button x:Name="AddOidButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="96"
                                        Content="Add OID"
                                        Padding="14,8"
                                        Margin="0,0,4,0"/>

                                <Button x:Name="EditOidButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="96"
                                        Content="Edit OID"
                                        Padding="14,6"
                                        Margin="0,0,4,0"/>

                                <Button x:Name="RemoveOidButton"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Width="96"
                                        FontWeight="Bold"
                                        Content="Remove OID"
                                        Padding="14,6"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="OidConfigDataGrid"
                                  Grid.Row="4"
                                  Style="{StaticResource ThemedDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category"
                                                    Width="88"
                                                    Binding="{Binding Category}" />
                                <DataGridTextColumn Header="Label"
                                                    Width="2*"
                                                    Binding="{Binding Label}" />
                                <DataGridTextColumn Header="OID"
                                                    Width="2*"
                                                    Binding="{Binding Oid}" />
                                <DataGridTextColumn Header="Type"
                                                    Width="68"
                                                    Binding="{Binding ValueType}" />
                                <DataGridTemplateColumn Header="Decode"
                                                        Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding DecodeMode}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Text="{Binding ReadFormula}"
                                                           Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Writable"
                                                        Width="80"
                                                        Binding="{Binding IsWritable}" />
                                <DataGridCheckBoxColumn Header="Workspace"
                                                        Width="108"
                                                        Binding="{Binding ShowInWorkspace}" />
                                <DataGridTextColumn Header="Sort"
                                                    Width="70"
                                                    Binding="{Binding SortOrder}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="6"
                        Style="{StaticResource Card}"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SnmpStatusTextBlock"
                                   Text="Ready."
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="DeleteProfileButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    FontWeight="Bold"
                                    Content="Delete Profile"
                                    Padding="16,0"
                                    Margin="0,0,4,0"/>

                            <Button x:Name="DeactivateProfileButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="104"
                                    Content="Deactivate"
                                    Padding="16,0"
                                    Margin="0,0,4,0"/>

                            <Button x:Name="SaveProfileButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="104"
                                    Content="Save Profile"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Editor locked overlay -->
                <Border x:Name="ProfileEditorOverlay"
                        Grid.Row="0"
                        Grid.RowSpan="7"
                        Panel.ZIndex="50"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28"
                        Visibility="Visible">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="540">
                            <TextBlock Text="Select an SNMP profile"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="Choose a profile from the list on the left, or create a new profile to begin editing SNMP connection settings and OIDs."
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>