<Window x:Class="SmartGridSuite.Client.Views.Administration.AdministrationShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administration"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="10,0,10,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavCol" Width="58"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAV -->
        <Border x:Name="NavShellBorder"
                Grid.Column="0"
                Style="{StaticResource ShellNavCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nav header -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="NavHeaderTextPanel">
                        <TextBlock Text="Administration"
                                   Style="{StaticResource NavRailHeaderTitleTextStyle}"/>

                        <TextBlock Text="Setup and maintenance"
                                   Style="{StaticResource NavRailHeaderSubtitleTextStyle}"/>
                    </StackPanel>

                    <Button x:Name="NavHeaderBtn"
                            Grid.Column="1"
                            Style="{StaticResource NavRailToggleButtonStyle}"
                            ToolTip="Collapse / Expand"
                            Click="ToggleNav_Click">
                        <Viewbox Width="12"
                                 Height="12"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Path x:Name="NavHeaderArrowPath"
                                  Data="M 4 2 L 8 6 L 4 10"
                                  Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Section label -->
                <TextBlock x:Name="NavSectionLabel"
                           Grid.Row="1"
                           Text="Administration Panes"
                           Style="{StaticResource NavRailSectionTextStyle}"
                           Margin="4,0,0,8"/>

                <!-- Expanded nav -->
                <ListBox x:Name="NavListExpanded"
                         Grid.Row="2"
                         Style="{StaticResource NavRailListStyle}"
                         ItemContainerStyle="{StaticResource NavRailItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">

                    <ListBoxItem Tag="Technicians">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M12 12C14.2 12 16 10.2 16 8S14.2 4 12 4 8 5.8 8 8 9.8 12 12 12ZM12 14C8.7 14 6 16.1 6 18.7V20H18V18.7C18 16.1 15.3 14 12 14ZM19 12C20.7 12 22 10.7 22 9S20.7 6 19 6C18.6 6 18.2 6.1 17.9 6.2C18 6.8 18 7.4 18 8C18 9.3 17.6 10.5 16.9 11.4C17.5 11.8 18.2 12 19 12ZM5 12C5.8 12 6.5 11.8 7.1 11.4C6.4 10.5 6 9.3 6 8C6 7.4 6 6.8 6.1 6.2C5.8 6.1 5.4 6 5 6C3.3 6 2 7.3 2 9S3.3 12 5 12Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Technicians"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Roster, roles, and profiles"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Tickets">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M4 6C4 4.9 4.9 4 6 4H18C19.1 4 20 4.9 20 6V9C18.9 9 18 9.9 18 11S18.9 13 20 13V16C20 17.1 19.1 18 18 18H6C4.9 18 4 17.1 4 16V13C5.1 13 6 12.1 6 11S5.1 9 4 9V6ZM6 6V7.4C7.2 8.1 8 9.4 8 11S7.2 13.9 6 14.6V16H18V14.6C16.8 13.9 16 12.6 16 11S16.8 8.1 18 7.4V6H6ZM10 8H14V10H10V8ZM10 12H14V14H10V12Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Tickets"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Statuses, categories, and rules"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="Trucks">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Viewbox Width="24"
                                         Height="24"
                                         Stretch="Uniform">
                                    <Canvas Width="48"
                                            Height="48">

                                        <!-- truck body -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M6 33H28V24H35V33H43V39H6V33Z"/>

                                        <!-- cab -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M35 25H40L43 30V39H35V25Z"/>

                                        <!-- cab window -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M37 28H39.5L41 32H37V28Z"/>

                                        <!-- wheels -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M14 39
                                                    A4 4 0 1 0 14 47
                                                    A4 4 0 1 0 14 39"/>

                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M35 39
                                                    A4 4 0 1 0 35 47
                                                    A4 4 0 1 0 35 39"/>

                                        <!-- bucket -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M4 6H15V15H5L4 6Z"/>

                                        <!-- upper boom -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M15 8L36 16"/>

                                        <!-- lower boom -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M15 14L30 22"/>

                                        <!-- boom tip -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M36 16H40V21H31"/>

                                        <!-- lift post -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M14 33V25C14 22 16 20 19 20H26"/>

                                        <!-- knuckle -->
                                        <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                              Data="M26 24L22 26L24 30"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Trucks"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Fleet, styles, and service state"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="SNMP">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M12 4C8.7 4 5.8 5.3 3.6 7.4L5 8.8C6.8 7.1 9.2 6 12 6S17.2 7.1 19 8.8L20.4 7.4C18.2 5.3 15.3 4 12 4ZM12 8C9.8 8 7.8 8.9 6.4 10.3L7.8 11.7C8.9 10.6 10.3 10 12 10S15.1 10.6 16.2 11.7L17.6 10.3C16.2 8.9 14.2 8 12 8ZM12 12C10.9 12 9.9 12.4 9.2 13.2L12 16L14.8 13.2C14.1 12.4 13.1 12 12 12ZM11 18H13V20H11V18Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SNMP"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Profiles, OIDs, and polling"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="GeneralSettings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M19.4 13.5C19.5 13 19.5 12.5 19.5 12S19.5 11 19.4 10.5L21.5 8.9L19.5 5.5L17 6.5C16.2 5.9 15.4 5.4 14.5 5.1L14.1 2.5H9.9L9.5 5.1C8.6 5.4 7.8 5.9 7 6.5L4.5 5.5L2.5 8.9L4.6 10.5C4.5 11 4.5 11.5 4.5 12S4.5 13 4.6 13.5L2.5 15.1L4.5 18.5L7 17.5C7.8 18.1 8.6 18.6 9.5 18.9L9.9 21.5H14.1L14.5 18.9C15.4 18.6 16.2 18.1 17 17.5L19.5 18.5L21.5 15.1L19.4 13.5ZM12 15.5C10.1 15.5 8.5 13.9 8.5 12S10.1 8.5 12 8.5 15.5 10.1 15.5 12 13.9 15.5 12 15.5Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="General Settings"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Application-level configuration"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="DesignTest">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M4 4H20V8H4V4ZM4 10H13V20H4V10ZM15 10H20V14H15V10ZM15 16H20V20H15V16Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Design Test"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Experimental visual direction"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>

                <!-- Collapsed nav -->
                <ListBox x:Name="NavListCollapsed"
                         Grid.Row="2"
                         Style="{StaticResource NavRailListStyle}"
                         ItemContainerStyle="{StaticResource NavRailCollapsedItemStyle}"
                         SelectionChanged="NavList_SelectionChanged"
                         Visibility="Collapsed">

                    <ListBoxItem Tag="Technicians" ToolTip="Technicians">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M12 12C14.2 12 16 10.2 16 8S14.2 4 12 4 8 5.8 8 8 9.8 12 12 12ZM12 14C8.7 14 6 16.1 6 18.7V20H18V18.7C18 16.1 15.3 14 12 14ZM19 12C20.7 12 22 10.7 22 9S20.7 6 19 6C18.6 6 18.2 6.1 17.9 6.2C18 6.8 18 7.4 18 8C18 9.3 17.6 10.5 16.9 11.4C17.5 11.8 18.2 12 19 12ZM5 12C5.8 12 6.5 11.8 7.1 11.4C6.4 10.5 6 9.3 6 8C6 7.4 6 6.8 6.1 6.2C5.8 6.1 5.4 6 5 6C3.3 6 2 7.3 2 9S3.3 12 5 12Z"/>
                        </Border>
                    </ListBoxItem>

                    <ListBoxItem Tag="Tickets" ToolTip="Tickets">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M4 6C4 4.9 4.9 4 6 4H18C19.1 4 20 4.9 20 6V9C18.9 9 18 9.9 18 11S18.9 13 20 13V16C20 17.1 19.1 18 18 18H6C4.9 18 4 17.1 4 16V13C5.1 13 6 12.1 6 11S5.1 9 4 9V6ZM6 6V7.4C7.2 8.1 8 9.4 8 11S7.2 13.9 6 14.6V16H18V14.6C16.8 13.9 16 12.6 16 11S16.8 8.1 18 7.4V6H6ZM10 8H14V10H10V8ZM10 12H14V14H10V12Z"/>
                        </Border>
                    </ListBoxItem>

                    <ListBoxItem Tag="Trucks" ToolTip="Trucks">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Viewbox Width="24"
                                     Height="24"
                                     Stretch="Uniform">
                                <Canvas Width="48"
                                        Height="48">

                                    <!-- truck body -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M6 33H28V24H35V33H43V39H6V33Z"/>

                                    <!-- cab -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M35 25H40L43 30V39H35V25Z"/>

                                    <!-- cab window -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M37 28H39.5L41 32H37V28Z"/>

                                    <!-- wheels -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M14 39
                                                A4 4 0 1 0 14 47
                                                A4 4 0 1 0 14 39"/>

                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M35 39
                                                A4 4 0 1 0 35 47
                                                A4 4 0 1 0 35 39"/>

                                    <!-- bucket -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M4 6H15V15H5L4 6Z"/>

                                    <!-- upper boom -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M15 8L36 16"/>

                                    <!-- lower boom -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M15 14L30 22"/>

                                    <!-- boom tip -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M36 16H40V21H31"/>

                                    <!-- lift post -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M14 33V25C14 22 16 20 19 20H26"/>

                                    <!-- knuckle -->
                                    <Path Style="{StaticResource NavRailCanvasStrokeIconStyle}"
                                          Data="M26 24L22 26L24 30"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </ListBoxItem>

                    <ListBoxItem Tag="SNMP" ToolTip="SNMP">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M12 4C8.7 4 5.8 5.3 3.6 7.4L5 8.8C6.8 7.1 9.2 6 12 6S17.2 7.1 19 8.8L20.4 7.4C18.2 5.3 15.3 4 12 4ZM12 8C9.8 8 7.8 8.9 6.4 10.3L7.8 11.7C8.9 10.6 10.3 10 12 10S15.1 10.6 16.2 11.7L17.6 10.3C16.2 8.9 14.2 8 12 8ZM12 12C10.9 12 9.9 12.4 9.2 13.2L12 16L14.8 13.2C14.1 12.4 13.1 12 12 12ZM11 18H13V20H11V18Z"/>
                        </Border>
                    </ListBoxItem>

                    <ListBoxItem Tag="GeneralSettings" ToolTip="General Settings">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M19.4 13.5C19.5 13 19.5 12.5 19.5 12S19.5 11 19.4 10.5L21.5 8.9L19.5 5.5L17 6.5C16.2 5.9 15.4 5.4 14.5 5.1L14.1 2.5H9.9L9.5 5.1C8.6 5.4 7.8 5.9 7 6.5L4.5 5.5L2.5 8.9L4.6 10.5C4.5 11 4.5 11.5 4.5 12S4.5 13 4.6 13.5L2.5 15.1L4.5 18.5L7 17.5C7.8 18.1 8.6 18.6 9.5 18.9L9.9 21.5H14.1L14.5 18.9C15.4 18.6 16.2 18.1 17 17.5L19.5 18.5L21.5 15.1L19.4 13.5ZM12 15.5C10.1 15.5 8.5 13.9 8.5 12S10.1 8.5 12 8.5 15.5 10.1 15.5 12 13.9 15.5 12 15.5Z"/>
                        </Border>
                    </ListBoxItem>

                    <ListBoxItem Tag="DesignTest" ToolTip="Design Test">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M4 4H20V8H4V4ZM4 10H13V20H4V10ZM15 10H20V14H15V10ZM15 16H20V20H15V16Z"/>
                        </Border>
                    </ListBoxItem>
                </ListBox>

                <!-- Home button -->
                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0">
                    <Border Height="1"
                            Margin="4,0,4,12"
                            Background="{DynamicResource CardBorder}"/>

                    <Button x:Name="HomeButtonExpanded"
                            Style="{StaticResource NavRailFooterButtonStyle}"
                            Click="HomeButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M12 3L3 10.2V21H9V15H15V21H21V10.2L12 3ZM19 19H17V13H7V19H5V11.2L12 5.6L19 11.2V19Z"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Home"
                                           Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                <TextBlock Text="Back to start screen"
                                           Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="HomeButtonCollapsed"
                            Style="{StaticResource NavRailCollapsedFooterButtonStyle}"
                            Click="HomeButton_Click"
                            ToolTip="Home"
                            Visibility="Collapsed">
                        <Border Style="{StaticResource NavBadgeStyle}">
                            <Path Style="{StaticResource NavRailPathIconStyle}"
                                  Data="M12 3L3 10.2V21H9V15H15V21H21V10.2L12 3ZM19 19H17V13H7V19H5V11.2L12 5.6L19 11.2V19Z"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        

        <!-- Main content -->
        <ContentControl x:Name="AdminContentHost"
                        Grid.Column="2"/>
    </Grid>
</Window>