<Window x:Class="SmartGridSuite.Client.Views.Administration.AdministrationShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administration"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Margin="14,14,14,8">
                    <TextBlock Text="Administration"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Setup and maintenance"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         x:Name="NavigationListBox"
                         Margin="6,0,6,10"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItemCleanStyle}">

                    <ListBoxItem Tag="Technicians">
                        <TextBlock Text="Technicians"
                                   Padding="8,0,0,2"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Tickets">
                        <TextBlock Text="Tickets"
                                   Padding="8,0,0,2"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Trucks">
                        <TextBlock Text="Trucks"
                                   Padding="8,0,0,2"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </ListBoxItem>

                    
                </ListBox>
            </Grid>
        </Border>

        <!-- Right content -->
        <Border Grid.Column="2">
            <ContentControl x:Name="AdminContentHost"/>
        </Border>
    </Grid>
</Window>