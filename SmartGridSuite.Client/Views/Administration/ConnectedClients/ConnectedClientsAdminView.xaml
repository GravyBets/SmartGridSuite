<UserControl x:Class="SmartGridSuite.Client.Views.Administration.ConnectedClients.ConnectedClientsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Administration — Connected Clients"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="View Smart Grid Suite clients, active modules, computers, and application versions."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding LatestVersionText}"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Padding="12,5"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary -->
        <UniformGrid Grid.Row="2"
                     Columns="3">

            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,0,4,0">

                <StackPanel>
                    <TextBlock Text="Online Clients"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <TextBlock Text="{Binding OnlineClientCount}"
                               Margin="0,4,0,0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="2,0">

                <StackPanel>
                    <TextBlock Text="Outdated Clients"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <TextBlock Text="{Binding OutdatedClientCount}"
                               Margin="0,4,0,0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="4,0,0,0">

                <StackPanel>
                    <TextBlock Text="Versions In Use"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <TextBlock Text="{Binding VersionsInUseCount}"
                               Margin="0,4,0,0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- Filters -->
        <Border Grid.Row="4"
                Style="{StaticResource Card}"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Search"
                               Margin="2,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             TextChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Module"
                               Margin="2,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <ComboBox x:Name="ModuleFilterComboBox"
                              Height="32"
                              Width="Auto"
                              VerticalContentAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Version"
                               Margin="2,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <ComboBox x:Name="VersionFilterComboBox"
                              Height="32"
                              Width="Auto"
                              VerticalContentAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="State"
                               Margin="2,0,0,4"
                               Foreground="{DynamicResource TextSecondary}"/>

                    <ComboBox x:Name="StateFilterComboBox"
                              Height="32"
                              Width="Auto"
                              VerticalContentAlignment="Center"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Clients -->
        <Border Grid.Row="6"
                Style="{StaticResource Card}"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Known Clients"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <DataGrid x:Name="ClientsGrid"
                          Grid.Row="2"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          RowHeight="42"
                          FontSize="14">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="State"
                        Width="100">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border Padding="10,4"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="1">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <!-- Offline = neutral -->
                                                <Setter Property="Background"
                                Value="{DynamicResource StatusNeutralBg}"/>

                                                <Setter Property="BorderBrush"
                                Value="{DynamicResource StatusNeutralBorder}"/>

                                                <Style.Triggers>

                                                    <!-- Online = success -->
                                                    <DataTrigger Binding="{Binding IsOnline}"
                                         Value="True">

                                                        <Setter Property="Background"
                                        Value="{DynamicResource StatusSuccessBg}"/>

                                                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource StatusSuccessBorder}"/>

                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding StateText}"
                           FontWeight="SemiBold"
                           FontSize="13">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                    Value="{DynamicResource StatusNeutralText}"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsOnline}"
                                             Value="True">

                                                            <Setter Property="Foreground"
                                            Value="{DynamicResource StatusSuccessText}"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="User"
                                            Width="200"
                                            Binding="{Binding DisplayName}"/>

                        <DataGridTextColumn Header="Employee ID"
                                            Width="105"
                                            Binding="{Binding EmployeeId}"/>

                        <DataGridTextColumn Header="Module"
                                            Width="145"
                                            Binding="{Binding CurrentModule}"/>

                        <DataGridTextColumn Header="Computer"
                                            Width="145"
                                            Binding="{Binding MachineName}"/>

                        <DataGridTextColumn Header="Version"
                                            Width="100"
                                            Binding="{Binding ClientVersion}"/>

                        <DataGridTemplateColumn Header="Version State"
                        Width="125">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border Padding="10,4"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="1">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <!-- Current = success -->
                                                <Setter Property="Background"
                                Value="{DynamicResource StatusSuccessBg}"/>

                                                <Setter Property="BorderBrush"
                                Value="{DynamicResource StatusSuccessBorder}"/>

                                                <Style.Triggers>

                                                    <!-- Outdated = warning -->
                                                    <DataTrigger Binding="{Binding IsOutdated}"
                                         Value="True">

                                                        <Setter Property="Background"
                                        Value="{DynamicResource StatusWarningBg}"/>

                                                        <Setter Property="BorderBrush"
                                        Value="{DynamicResource StatusWarningBorder}"/>

                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding VersionStateText}"
                           FontWeight="SemiBold"
                           FontSize="13">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground"
                                    Value="{DynamicResource StatusSuccessText}"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsOutdated}"
                                             Value="True">

                                                            <Setter Property="Foreground"
                                            Value="{DynamicResource StatusWarningText}"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Windows User"
                                            Width="150"
                                            Binding="{Binding WindowsUser}"/>

                        <DataGridTextColumn Header="Last Seen"
                                            Width="*"
                                            Binding="{Binding LastSeenText}"/>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3"
                           Text="{Binding StatusMessage}"
                           Margin="2,8,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>