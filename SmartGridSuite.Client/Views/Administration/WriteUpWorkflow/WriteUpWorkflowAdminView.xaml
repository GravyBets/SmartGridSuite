<UserControl x:Class="SmartGridSuite.Client.Views.Administration.WriteUpWorkflow.WriteUpWorkflowAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <!-- Header -->
        <StackPanel Margin="4">
        <Border Style="{StaticResource Card}"
                Padding="12"
                Margin="0,0,0,4">
            <StackPanel Margin="0">
                <TextBlock Text="Write-Up Workflow"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Margin="0,4,0,4"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Configure technician flags, Refer To destinations, and the Dispatch closeout checklist."/>
            </StackPanel>
        </Border>
        <!-- Technician Write-Up Flags -->
            <Border Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Technician Write-Up Flags"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Margin="0,4,16,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Configure the flags technicians may select during write-up submission. Protected flags may be activated, deactivated, reordered, or hidden from technicians, but cannot be renamed or deleted."/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">

                            <Button x:Name="ReloadWriteUpFlagsButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Reload"
                                    MinWidth="82"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ReloadWriteUpFlagsButton_Click"/>

                            <Button x:Name="ToggleAddWriteUpFlagButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="+ New Flag"
                                    MinWidth="102"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ToggleAddWriteUpFlagButton_Click"/>

                            <Button x:Name="EditSelectedWriteUpFlagButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Edit Selected"
                                    MinWidth="108"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="EditSelectedWriteUpFlagButton_Click"/>

                            <Button x:Name="MoveWriteUpFlagUpButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Up"
                                    MinWidth="86"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveWriteUpFlagUpButton_Click"/>

                            <Button x:Name="MoveWriteUpFlagDownButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Down"
                                    MinWidth="92"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveWriteUpFlagDownButton_Click"/>

                            <Button x:Name="DeleteSelectedWriteUpFlagButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Delete Selected"
                                    MinWidth="116"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,0,6"
                                    IsEnabled="False"
                                    Click="DeleteSelectedWriteUpFlagButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Add/Edit Form -->
                    <Border x:Name="AddWriteUpFlagCard"
                            Grid.Row="2"
                            Style="{StaticResource Card}"
                            Padding="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="WriteUpFlagFormTitleTextBlock"
                                           Text="Add Technician Write-Up Flag"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock x:Name="WriteUpFlagFormHelpTextBlock"
                                           Text="Create a new selectable technician write-up flag."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Flag Name"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewWriteUpFlagNameTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             MaxLength="100"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Tag="Write-Up Flag Name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sort"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewWriteUpFlagSortOrderTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="100"/>
                                </StackPanel>

                                <CheckBox x:Name="NewWriteUpFlagActiveCheckBox"
                                          Grid.Column="4"
                                          Content="Active"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <CheckBox x:Name="NewWriteUpFlagTechnicianVisibleCheckBox"
                                          Grid.Column="6"
                                          Content="Technician Visible"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <Button x:Name="AddWriteUpFlagButton"
                                        Grid.Column="8"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Add"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="AddWriteUpFlagButton_Click"/>

                                <Button x:Name="CancelAddWriteUpFlagButton"
                                        Grid.Column="10"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Cancel"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="CancelAddWriteUpFlagButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Existing Flags -->
                    <Border Grid.Row="4"
                            Style="{StaticResource Card}"
                            Padding="8"
                            ClipToBounds="False">
                        <DataGrid x:Name="WriteUpFlagsDataGrid"
                                  Height="220"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="WriteUpFlagsDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource TabBgHover}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="Height"
                                            Value="32"/>
                                    <Setter Property="Padding"
                                            Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource DataGridHeaderBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="MinHeight"
                                            Value="34"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillPressed}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SurfaceBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                    <Setter Property="Padding"
                                            Value="12,6"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Setter Property="IsTabStop"
                                            Value="False"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="WriteUpFlagGridTextStyle"
                                       TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="TextTrimming"
                                            Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping"
                                            Value="NoWrap"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Width="55"
                                                    Binding="{Binding Id}"
                                                    ElementStyle="{StaticResource WriteUpFlagGridTextStyle}"/>

                                <DataGridTextColumn Header="Flag"
                                                    Width="*"
                                                    Binding="{Binding DisplayName}"
                                                    ElementStyle="{StaticResource WriteUpFlagGridTextStyle}"/>

                                <DataGridTextColumn Header="Sort"
                                                    Width="65"
                                                    Binding="{Binding SortOrder}"
                                                    ElementStyle="{StaticResource WriteUpFlagGridTextStyle}"/>

                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Active"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Tech Visible"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsTechnicianVisible}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="90">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Protected"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsSystem}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               x:Name="WriteUpFlagsStatusTextBlock"
                               Text="Ready."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>

            <!-- Refer To Options -->
            <Border Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Refer To Options"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Margin="0,4,16,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Configure the departments or work groups that may be selected beneath Refer To during technician write-up submission."/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">

                            <Button x:Name="ReloadReferToOptionsButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Reload"
                                    MinWidth="82"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ReloadReferToOptionsButton_Click"/>

                            <Button x:Name="ToggleAddReferToOptionButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="+ New Option"
                                    MinWidth="110"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ToggleAddReferToOptionButton_Click"/>

                            <Button x:Name="EditSelectedReferToOptionButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Edit Selected"
                                    MinWidth="108"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="EditSelectedReferToOptionButton_Click"/>

                            <Button x:Name="MoveReferToOptionUpButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Up"
                                    MinWidth="86"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveReferToOptionUpButton_Click"/>

                            <Button x:Name="MoveReferToOptionDownButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Down"
                                    MinWidth="92"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveReferToOptionDownButton_Click"/>

                            <Button x:Name="DeleteSelectedReferToOptionButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Delete Selected"
                                    MinWidth="116"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,0,6"
                                    IsEnabled="False"
                                    Click="DeleteSelectedReferToOptionButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Add/Edit Form -->
                    <Border x:Name="AddReferToOptionCard"
                            Grid.Row="2"
                            Style="{StaticResource Card}"
                            Padding="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="ReferToOptionFormTitleTextBlock"
                                           Text="Add Refer To Option"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock x:Name="ReferToOptionFormHelpTextBlock"
                                           Text="Create a new Refer To department or work group."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Destination Name"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewReferToOptionNameTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             MaxLength="100"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Tag="Refer To Destination"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sort"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewReferToOptionSortOrderTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="100"/>
                                </StackPanel>

                                <CheckBox x:Name="NewReferToOptionActiveCheckBox"
                                          Grid.Column="4"
                                          Content="Active"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <Button x:Name="AddReferToOptionButton"
                                        Grid.Column="6"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Add"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="AddReferToOptionButton_Click"/>

                                <Button x:Name="CancelAddReferToOptionButton"
                                        Grid.Column="8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Cancel"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="CancelAddReferToOptionButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Existing Options -->
                    <Border Grid.Row="4"
                            Style="{StaticResource Card}"
                            Padding="8"
                            ClipToBounds="False">
                        <DataGrid x:Name="ReferToOptionsDataGrid"
                                  Height="220"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="ReferToOptionsDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource TabBgHover}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="Height"
                                            Value="32"/>
                                    <Setter Property="Padding"
                                            Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource DataGridHeaderBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="MinHeight"
                                            Value="34"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillPressed}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SurfaceBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                    <Setter Property="Padding"
                                            Value="12,6"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Setter Property="IsTabStop"
                                            Value="False"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="ReferToOptionGridTextStyle"
                                       TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="TextTrimming"
                                            Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping"
                                            Value="NoWrap"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Width="55"
                                                    Binding="{Binding Id}"
                                                    ElementStyle="{StaticResource ReferToOptionGridTextStyle}"/>

                                <DataGridTextColumn Header="Destination"
                                                    Width="*"
                                                    Binding="{Binding DisplayName}"
                                                    ElementStyle="{StaticResource ReferToOptionGridTextStyle}"/>

                                <DataGridTextColumn Header="Sort"
                                                    Width="75"
                                                    Binding="{Binding SortOrder}"
                                                    ElementStyle="{StaticResource ReferToOptionGridTextStyle}"/>

                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Active"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               x:Name="ReferToOptionsStatusTextBlock"
                               Text="Ready."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>

            <!-- Dispatch Closeout Checklist -->
            <Border Style="{StaticResource Card}"
                    Padding="12"
                    Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dispatch Closeout Checklist"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Margin="0,4,16,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="Configure the shared checklist Dispatch must complete before a field-completed ticket can be closed."/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">

                            <Button x:Name="ReloadDispatchCloseoutChecklistButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Reload"
                                    MinWidth="82"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ReloadDispatchCloseoutChecklistButton_Click"/>

                            <Button x:Name="ToggleAddDispatchCloseoutChecklistButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="+ New Item"
                                    MinWidth="100"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    Click="ToggleAddDispatchCloseoutChecklistButton_Click"/>

                            <Button x:Name="EditSelectedDispatchCloseoutChecklistButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Edit Selected"
                                    MinWidth="108"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="EditSelectedDispatchCloseoutChecklistButton_Click"/>

                            <Button x:Name="MoveDispatchCloseoutChecklistUpButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Up"
                                    MinWidth="86"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveDispatchCloseoutChecklistUpButton_Click"/>

                            <Button x:Name="MoveDispatchCloseoutChecklistDownButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Move Down"
                                    MinWidth="92"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,6,6"
                                    IsEnabled="False"
                                    Click="MoveDispatchCloseoutChecklistDownButton_Click"/>

                            <Button x:Name="DeleteSelectedDispatchCloseoutChecklistButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Delete Selected"
                                    MinWidth="116"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,0,6"
                                    IsEnabled="False"
                                    Click="DeleteSelectedDispatchCloseoutChecklistButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <!-- Add/Edit Form -->
                    <Border x:Name="AddDispatchCloseoutChecklistCard"
                            Grid.Row="2"
                            Style="{StaticResource Card}"
                            Padding="12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="DispatchCloseoutChecklistFormTitleTextBlock"
                                           Text="Add Dispatch Closeout Checklist Item"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <TextBlock x:Name="DispatchCloseoutChecklistFormHelpTextBlock"
                                           Text="Create a checklist item that may be required before ticket closure."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Checklist Item"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewDispatchCloseoutChecklistNameTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             MaxLength="150"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Tag="Checklist Item"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sort"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewDispatchCloseoutChecklistSortOrderTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Condition"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <ComboBox x:Name="DispatchCloseoutConditionTypeComboBox"
                                              Height="32"
                                              SelectionChanged="DispatchCloseoutConditionTypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Trigger"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="8,0,0,3"/>

                                    <ComboBox x:Name="DispatchCloseoutWriteUpFlagComboBox"
                                              Height="32"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              IsEnabled="False"/>
                                </StackPanel>

                                <CheckBox x:Name="NewDispatchCloseoutChecklistActiveCheckBox"
                                          Grid.Column="8"
                                          Content="Active"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <CheckBox x:Name="NewDispatchCloseoutChecklistRequiredCheckBox"
                                          Grid.Column="10"
                                          Content="Required"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <Button x:Name="AddDispatchCloseoutChecklistButton"
                                        Grid.Column="12"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Add"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="AddDispatchCloseoutChecklistButton_Click"/>

                                <Button x:Name="CancelAddDispatchCloseoutChecklistButton"
                                        Grid.Column="14"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Cancel"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="CancelAddDispatchCloseoutChecklistButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Existing Definitions -->
                    <Border Grid.Row="4"
                            Style="{StaticResource Card}"
                            Padding="8"
                            ClipToBounds="False">
                        <DataGrid x:Name="DispatchCloseoutChecklistDataGrid"
                                  Height="220"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="DispatchCloseoutChecklistDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource TabBgHover}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="Height"
                                            Value="32"/>
                                    <Setter Property="Padding"
                                            Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource DataGridHeaderBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="MinHeight"
                                            Value="34"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillPressed}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SurfaceBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                    <Setter Property="Padding"
                                            Value="12,6"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Setter Property="IsTabStop"
                                            Value="False"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="DispatchCloseoutGridTextStyle"
                                       TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="TextTrimming"
                                            Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping"
                                            Value="NoWrap"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Width="55"
                                                    Binding="{Binding Id}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Checklist Item"
                                                    Width="*"
                                                    Binding="{Binding DisplayName}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Condition"
                                                    Width="130"
                                                    Binding="{Binding ConditionType}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Trigger"
                                                    Width="180"
                                                    Binding="{Binding TriggerName}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Sort"
                                                    Width="65"
                                                    Binding="{Binding SortOrder}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Required"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsRequired}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Active"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               x:Name="DispatchCloseoutChecklistStatusTextBlock"
                               Text="Ready."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
