<UserControl x:Class="SmartGridSuite.Client.Views.Administration.GeneralSettings.GeneralSettingsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">

            <!-- Header -->
            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="General Settings"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Application-wide settings, shared URLs, and selectable field values."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- IGSD Portal URL -->
            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="IGSD Portal URL"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="This URL is used by the IGSD Portal tab in Site Dashboard. Leave blank to disable the portal tab."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="IgsdPortalUrlTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="ReloadPortalUrlButton"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Reload"
                                Height="34"
                                Padding="14,0"
                                Click="ReloadPortalUrlButton_Click"/>

                        <Button x:Name="SavePortalUrlButton"
                                Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save URL"
                                Height="34"
                                Padding="14,0"
                                Click="SavePortalUrlButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="PortalUrlStatusTextBlock"
                               Grid.Row="4"
                               Text="Ready."
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>
            
            <!-- Range Extender Portal URL -->
            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Range Extender Link URL"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="This URL opens from the Range Extender tab in Site Dashboard. Leave blank to disable the button."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="RangeExtenderLinkUrlTextBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="ReloadRangeExtenderLinkButton"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Reload"
                                Height="34"
                                Padding="14,0"
                                Click="ReloadRangeExtenderLinkButton_Click"/>

                        <Button x:Name="SaveRangeExtenderLinkButton"
                                Grid.Column="4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Save URL"
                                Height="34"
                                Padding="14,0"
                                Click="SaveRangeExtenderLinkButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="RangeExtenderLinkStatusTextBlock"
                               Grid.Row="4"
                               Text="Ready."
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>

            <!-- Communication Device Types -->
            <Border Style="{StaticResource Card}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Communication Device Types"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBlock Text="These populate the Device Type picker when Primary or Secondary Communications are swapped in Site Dashboard."
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <Button x:Name="ReloadDeviceTypesButton"
                                Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Reload"
                                Height="34"
                                Padding="14,0"
                                VerticalAlignment="Top"
                                Click="ReloadDeviceTypesButton_Click"/>
                    </Grid>

                    <!-- Add New Type -->
                    <Border Grid.Row="2"
                            Padding="12"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource SurfaceBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource SurfaceBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="New Device Type"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,0,0,3"/>

                                <TextBox x:Name="NewDeviceTypeNameTextBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sort Order"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,0,0,3"/>

                                <TextBox x:Name="NewDeviceTypeSortOrderTextBox"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="32"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Text="40"/>
                            </StackPanel>

                            <CheckBox x:Name="NewDeviceTypeActiveCheckBox"
                                      Grid.Column="4"
                                      Content="Active"
                                      IsChecked="True"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,7"
                                      Foreground="{DynamicResource TextPrimary}"/>

                            <Button x:Name="AddDeviceTypeButton"
                                    Grid.Column="6"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Add"
                                    Height="32"
                                    Padding="16,0"
                                    VerticalAlignment="Bottom"
                                    Click="AddDeviceTypeButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Existing Types -->
                    <StackPanel x:Name="DeviceTypesPanel"
                                Grid.Row="4"/>

                    <TextBlock x:Name="DeviceTypesStatusTextBlock"
                               Grid.Row="6"
                               Text="Ready."
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>