<UserControl x:Class="SmartGridSuite.Client.Views.Administration.SystemHealth.SystemHealthAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="HealthCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
        </Style>

        <Style x:Key="HealthLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HealthValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HealthStatusBadgeStyle"
               TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Header -->
            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="System Health"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="API, databases, fallback data, backups, and server storage."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBlock x:Name="UpdatedTextBlock"
                                   Text="Not refreshed yet."
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>

                    <Button x:Name="RefreshButton"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Refresh"
                            Width="96"
                            Height="34"
                            Click="RefreshButton_Click"/>
                </Grid>
            </Border>

            <UniformGrid Columns="2">

                <!-- Application -->
                <Border Style="{StaticResource HealthCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Application"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <Border x:Name="ApplicationStatusBadge"
                                    Grid.Column="1"
                                    Style="{StaticResource HealthStatusBadgeStyle}">
                                <TextBlock x:Name="ApplicationStatusTextBlock"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="ApplicationMessageTextBlock"
                                   Margin="0,8,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="API version"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ApiVersionTextBlock"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="2"
                                       Text="API started"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ApiStartedTextBlock"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="4"
                                       Text="Uptime"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ApiUptimeTextBlock"
                                       Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="6"
                                       Text="Application DB"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ApplicationDatabaseTextBlock"
                                       Grid.Row="6"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="8"
                                       Text="DB response"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="DatabaseResponseTextBlock"
                                       Grid.Row="8"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Parent DB -->
                <Border Style="{StaticResource HealthCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Parent Database"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <Border x:Name="ParentDatabaseStatusBadge"
                                    Grid.Column="1"
                                    Style="{StaticResource HealthStatusBadgeStyle}">
                                <TextBlock x:Name="ParentDatabaseStatusTextBlock"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Live Parent DB connectivity used by Site Dashboard lookups."
                                   Margin="0,8,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Current source"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentDataSourceTextBlock"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="2"
                                       Text="Last live success"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentLastSuccessTextBlock"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="4"
                                       Text="Last failure"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentLastFailureTextBlock"
                                       Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="6"
                                       Text="Unavailable since"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentUnavailableSinceTextBlock"
                                       Grid.Row="6"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="8"
                                       Text="Failed operation"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentFailureOperationTextBlock"
                                       Grid.Row="8"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="10"
                                       Text="Failure details"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ParentFailureMessageTextBlock"
                                       Grid.Row="10"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cache snapshot -->
                <Border Style="{StaticResource HealthCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Parent DB Cache Snapshot"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <Border x:Name="CacheStatusBadge"
                                    Grid.Column="1"
                                    Style="{StaticResource HealthStatusBadgeStyle}">
                                <TextBlock x:Name="CacheStatusTextBlock"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Fallback Site Dashboard data. This is not an authoritative backup of the Parent DB."
                                   Margin="0,8,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <TextBlock x:Name="CacheMessageTextBlock"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Last refreshed"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="CacheLastRefreshedTextBlock"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="2"
                                       Text="Snapshot age"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="CacheAgeTextBlock"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="4"
                                       Text="Sync run"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="CacheSyncRunTextBlock"
                                       Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="6"
                                       Text="Cached records"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="CacheCountsTextBlock"
                                       Grid.Row="6"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backup and storage -->
                <Border Style="{StaticResource HealthCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Backup and Storage"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <Border x:Name="BackupStatusBadge"
                                    Grid.Column="1"
                                    Style="{StaticResource HealthStatusBadgeStyle}">
                                <TextBlock x:Name="BackupStatusTextBlock"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="BackupMessageTextBlock"
                                   Margin="0,8,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Backup USB"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="BackupMountedTextBlock"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="2"
                                       Text="Last attempt"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="BackupLastAttemptTextBlock"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="4"
                                       Text="Last success"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="BackupLastSuccessTextBlock"
                                       Grid.Row="4"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="6"
                                       Text="Backup age"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="BackupAgeTextBlock"
                                       Grid.Row="6"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="8"
                                       Text="Server drive"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="ServerStorageTextBlock"
                                       Grid.Row="8"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>

                            <TextBlock Grid.Row="10"
                                       Text="Backup drive"
                                       Style="{StaticResource HealthLabelStyle}"/>
                            <TextBlock x:Name="BackupStorageTextBlock"
                                       Grid.Row="10"
                                       Grid.Column="1"
                                       Style="{StaticResource HealthValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="RefreshStatusTextBlock"
                       Text="Ready."
                       Margin="4,4,4,8"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>