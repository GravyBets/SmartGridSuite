<Window x:Class="SmartGridSuite.Client.Views.Administration.SystemHealth.RestartApiPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restart API" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="22">
        <TextBlock Text="Restart SmartGridSuite API" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,12,0,16" TextWrapping="Wrap"
                   Text="This briefly interrupts service for everyone. Enter the shared administrator password to continue."/>
        <TextBlock Text="Administrator restart password" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput" MaxLength="256" Padding="8"
                     Background="{DynamicResource ControlInputBg}"
                     Foreground="{DynamicResource ControlInputText}"
                     BorderBrush="{DynamicResource ControlInputBorder}"/>
        <TextBlock x:Name="ValidationText" Margin="0,6,0,0"
                   Foreground="{DynamicResource DangerText}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Restart API" IsDefault="True" Padding="14,6" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
