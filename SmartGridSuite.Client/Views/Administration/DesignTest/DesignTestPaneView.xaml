<UserControl x:Class="SmartGridSuite.Client.Views.Administration.DesignTest.DesignTestPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Local-only design test colors. These do NOT touch the global app theme. -->

        <!-- Main app/pane colors: field-readable graphite -->
        <SolidColorBrush x:Key="OpsBackgroundBrush" Color="#252A31"/>
        <SolidColorBrush x:Key="OpsShellBrush" Color="#2D333C"/>
        <SolidColorBrush x:Key="OpsPanelBrush" Color="#39414D"/>
        <SolidColorBrush x:Key="OpsPanelAltBrush" Color="#46505E"/>

        <!-- Borders: visible, but not washed out -->
        <SolidColorBrush x:Key="OpsBorderBrush" Color="#7A8796"/>
        <SolidColorBrush x:Key="OpsBorderSoftBrush" Color="#5F6B79"/>

        <!-- Text: high contrast for sunlight -->
        <SolidColorBrush x:Key="OpsTextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OpsTextSecondaryBrush" Color="#E7ECF2"/>
        <SolidColorBrush x:Key="OpsTextMutedBrush" Color="#C5CED8"/>

        <!-- Actions / accent -->
        <SolidColorBrush x:Key="OpsAccentBrush" Color="#75C7F0"/>
        <SolidColorBrush x:Key="OpsAccentDarkBrush" Color="#246F9D"/>

        <!-- Status colors -->
        <SolidColorBrush x:Key="OpsGreenBrush" Color="#57D98B"/>
        <SolidColorBrush x:Key="OpsAmberBrush" Color="#F5C45D"/>
        <SolidColorBrush x:Key="OpsRedBrush" Color="#F47A72"/>

        <Style x:Key="OpsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OpsPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="OpsMetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OpsPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="OpsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpsTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="OpsValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpsTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="OpsMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpsTextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="OpsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource OpsTextPrimaryBrush}"/>
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource OpsAccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OpsButtonBase" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OpsTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource OpsPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpsPrimaryButton" TargetType="Button" BasedOn="{StaticResource OpsButtonBase}">
            <Setter Property="Background" Value="{StaticResource OpsAccentDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsAccentBrush}"/>
        </Style>

        <Style x:Key="OpsSecondaryButton" TargetType="Button" BasedOn="{StaticResource OpsButtonBase}">
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderBrush}"/>
        </Style>

        <Style x:Key="OpsDangerButton" TargetType="Button" BasedOn="{StaticResource OpsButtonBase}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsRedBrush}"/>
        </Style>

        <Style x:Key="OpsPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="OpsTableHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpsTextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="OpsTableCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OpsTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="OpsTableRow" TargetType="Border">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="BorderBrush" Value="{StaticResource OpsBorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource OpsBackgroundBrush}"
            Padding="24">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource OpsShellBrush}"
                        BorderBrush="{StaticResource OpsBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Smart Grid Operations Console"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OpsTextPrimaryBrush}"/>

                            <TextBlock Text="Design test pane — local styles only, no global theme changes"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource OpsTextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource OpsMetricCard}">
                        <StackPanel>
                            <TextBlock Text="OPEN TICKETS" Style="{StaticResource OpsLabel}"/>
                            <TextBlock Text="42" Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OpsTextPrimaryBrush}"/>
                            <TextBlock Text="7 high priority" Margin="0,4,0,0" Style="{StaticResource OpsMutedText}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource OpsMetricCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CREWS" Style="{StaticResource OpsLabel}"/>
                            <TextBlock Text="6" Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OpsTextPrimaryBrush}"/>
                            <TextBlock Text="2 modified routes" Margin="0,4,0,0" Style="{StaticResource OpsMutedText}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource OpsMetricCard}">
                        <StackPanel>
                            <TextBlock Text="WRITE-UPS TODAY" Style="{StaticResource OpsLabel}"/>
                            <TextBlock Text="18" Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OpsTextPrimaryBrush}"/>
                            <TextBlock Text="5 awaiting closure" Margin="0,4,0,0" Style="{StaticResource OpsMutedText}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource OpsMetricCard}"
                            Margin="0">
                        <StackPanel>
                            <TextBlock Text="LAST SYNC" Style="{StaticResource OpsLabel}"/>
                            <TextBlock Text="08:41" Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource OpsTextPrimaryBrush}"/>
                            <TextBlock Text="Database healthy" Margin="0,4,0,0" Style="{StaticResource OpsMutedText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main preview -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left command panel -->
                    <Border Grid.Column="0"
                            Style="{StaticResource OpsCard}">
                        <StackPanel>
                            <TextBlock Text="Command Filters"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OpsTextPrimaryBrush}"/>

                            <TextBlock Text="A tighter, flatter control layout."
                                       Margin="0,4,0,18"
                                       Foreground="{StaticResource OpsTextSecondaryBrush}"
                                       FontSize="12"/>

                            <TextBlock Text="Search"
                                       Style="{StaticResource OpsLabel}"/>
                            <TextBox Text="MR-1042"
                                     Style="{StaticResource OpsTextBox}"
                                     Margin="0,6,0,14"/>

                            <TextBlock Text="Status"
                                       Style="{StaticResource OpsLabel}"/>

                            <StackPanel Margin="0,8,0,18">
                                
                               
                            </StackPanel>

                            <Button Content="Apply Filters"
                                    Style="{StaticResource OpsPrimaryButton}"
                                    Margin="0,0,0,8"/>

                            <Button Content="Clear"
                                    Style="{StaticResource OpsSecondaryButton}"
                                    Margin="0,0,0,8"/>

                            <Button Content="Delete Preview"
                                    Style="{StaticResource OpsDangerButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Center queue -->
                    <Border Grid.Column="2"
                            Style="{StaticResource OpsCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Ticket Queue"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource OpsTextPrimaryBrush}"/>

                                    <TextBlock Text="Sample dense data layout with less visual noise."
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource OpsTextSecondaryBrush}"
                                               FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Open"
                                            Style="{StaticResource OpsSecondaryButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Publish"
                                            Style="{StaticResource OpsPrimaryButton}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Table header -->
                            <Border Grid.Row="1"
                                    Background="#0B1220"
                                    BorderBrush="{StaticResource OpsBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,9"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="SITE #" Style="{StaticResource OpsTableHeaderText}"/>
                                    <TextBlock Grid.Column="1" Text="TICKET NAME" Style="{StaticResource OpsTableHeaderText}"/>
                                    <TextBlock Grid.Column="2" Text="ISSUE" Style="{StaticResource OpsTableHeaderText}"/>
                                    <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource OpsTableHeaderText}"/>
                                    <TextBlock Grid.Column="4" Text="WORK ORDER" Style="{StaticResource OpsTableHeaderText}"/>
                                </Grid>
                            </Border>

                            <!-- Table rows -->
                            <StackPanel Grid.Row="2">

                                <Border Style="{StaticResource OpsTableRow}"
                                        BorderBrush="{StaticResource OpsAccentBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="MR-1042" Style="{StaticResource OpsTableCell}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Range Extender" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="2" Text="Low RSSI, check antenna and RX references" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="3" Text="Open" Style="{StaticResource OpsTableCell}" Foreground="{StaticResource OpsAccentBrush}"/>
                                        <TextBlock Grid.Column="4" Text="121456789" Style="{StaticResource OpsTableCell}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource OpsTableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="MR-1188" Style="{StaticResource OpsTableCell}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Switch Site" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="2" Text="Cellular modem offline after power event" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="3" Text="Waiting" Style="{StaticResource OpsTableCell}" Foreground="{StaticResource OpsAmberBrush}"/>
                                        <TextBlock Grid.Column="4" Text="121400112" Style="{StaticResource OpsTableCell}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource OpsTableRow}"
                                        Opacity="0.58">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="MR-1201" Style="{StaticResource OpsTableCell}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Collector" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="2" Text="Replaced radio and verified meter reads" Style="{StaticResource OpsTableCell}"/>
                                        <TextBlock Grid.Column="3" Text="Completed" Style="{StaticResource OpsTableCell}" Foreground="{StaticResource OpsGreenBrush}"/>
                                        <TextBlock Grid.Column="4" Text="121488901" Style="{StaticResource OpsTableCell}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right detail panel -->
                    <Border Grid.Column="4"
                            Style="{StaticResource OpsCard}">
                        <StackPanel>
                            <TextBlock Text="Selected Work"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OpsTextPrimaryBrush}"/>

                            <TextBlock Text="MR-1042"
                                       Margin="0,12,0,0"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource OpsTextPrimaryBrush}"/>

                            <TextBlock Text="Range Extender • Notification 140512345"
                                       Margin="0,2,0,18"
                                       Foreground="{StaticResource OpsTextSecondaryBrush}"
                                       FontSize="13"/>

                            <Border Background="#0B1220"
                                    BorderBrush="{StaticResource OpsBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Issue"
                                               Style="{StaticResource OpsLabel}"/>

                                    <TextBlock Text="Low RSSI reported overnight. Check antenna, coax, RX references, and confirm ping/SNMP after work is complete."
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource OpsTextPrimaryBrush}"
                                               FontSize="13"
                                               LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0B1220"
                                    BorderBrush="{StaticResource OpsBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Dispatch Notes"
                                               Style="{StaticResource OpsLabel}"/>

                                    <TextBlock Text="Gate code on site note. Customer requested call before arrival."
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource OpsTextPrimaryBrush}"
                                               FontSize="13"
                                               LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Open Site Dashboard"
                                    Style="{StaticResource OpsPrimaryButton}"
                                    Margin="0,8,0,8"/>

                            <Button Content="Copy Work Order"
                                    Style="{StaticResource OpsSecondaryButton}"
                                    Margin="0,0,0,8"/>

                            <Button Content="Mark Blocked"
                                    Style="{StaticResource OpsSecondaryButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>