<UserControl x:Class="SmartGridSuite.Client.Views.Administration.Tickets.TicketsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Tickets"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="Manage ticket statuses and dispatch task categories."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Statuses -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ticket Statuses"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Grid.Row="2"
               Text="These control available ticket statuses, filter visibility, and whether a status sends tickets into Dispatch Tasks."
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondary}"/>

                    <!-- Status actions -->
                    <StackPanel Grid.Row="4"
                Orientation="Horizontal">
                        <Button Content="Add Status"
                Width="110"
                Height="32"
                Margin="0,0,8,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="AddStatus_Click"/>

                        <Button x:Name="EditStatusButton"
                Content="Edit Selected"
                Width="110"
                Height="32"
                Margin="0,0,8,0"
                Click="EditStatus_Click"
                IsEnabled="False"/>

                        <Button x:Name="DeactivateStatusButton"
                Content="Deactivate"
                Width="110"
                Height="32"
                Click="DeactivateStatus_Click"
                IsEnabled="False"/>
                    </StackPanel>

                    <DataGrid Grid.Row="6"
              x:Name="StatusesGrid"
              Style="{StaticResource ThemedDataGridStyle}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              SelectionMode="Single"
              SelectionChanged="StatusesGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                Width="*"
                                Binding="{Binding Name}"/>

                            <DataGridTextColumn Header="Sort"
                                Width="70"
                                Binding="{Binding SortOrder}"/>

                            <DataGridCheckBoxColumn Header="Active"
                                    Width="80"
                                    Binding="{Binding IsActive}"/>

                            <DataGridCheckBoxColumn Header="Closed"
                                    Width="80"
                                    Binding="{Binding IsClosed}"/>

                            <DataGridCheckBoxColumn Header="Filter"
                                    Width="80"
                                    Binding="{Binding ShowInFilter}"/>

                            <DataGridCheckBoxColumn Header="Dispatch Tasks"
                                    Width="120"
                                    Binding="{Binding SendToDispatchTasks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Categories -->
            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Task Categories"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Grid.Row="2"
               Text="These define the available dispatch task categories and their default action-required text."
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextSecondary}"/>

                    <!-- Category actions -->
                    <StackPanel Grid.Row="4"
                Orientation="Horizontal">
                        <Button Content="Add Category"
                Width="120"
                Height="32"
                Margin="0,0,8,0"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="AddCategory_Click"/>

                        <Button x:Name="EditCategoryButton"
                Content="Edit Selected"
                Width="110"
                Height="32"
                Margin="0,0,8,0"
                Click="EditCategory_Click"
                IsEnabled="False"/>

                        <Button x:Name="DeactivateCategoryButton"
                Content="Deactivate"
                Width="110"
                Height="32"
                Click="DeactivateCategory_Click"
                IsEnabled="False"/>
                    </StackPanel>

                    <DataGrid Grid.Row="6"
              x:Name="CategoriesGrid"
              Style="{StaticResource ThemedDataGridStyle}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              SelectionMode="Single"
              SelectionChanged="CategoriesGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                Width="180"
                                Binding="{Binding Name}"/>

                            <DataGridTextColumn Header="Default Action Required"
                                Width="*"
                                Binding="{Binding DefaultActionRequired}"/>

                            <DataGridTextColumn Header="Sort"
                                Width="70"
                                Binding="{Binding SortOrder}"/>

                            <DataGridCheckBoxColumn Header="Active"
                                    Width="80"
                                    Binding="{Binding IsActive}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>