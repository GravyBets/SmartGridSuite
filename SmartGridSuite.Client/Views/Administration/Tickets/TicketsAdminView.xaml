<UserControl x:Class="SmartGridSuite.Client.Views.Administration.Tickets.TicketsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="DangerButtonStyle"
           TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991B1B"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Tickets"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="Manage ticket statuses, filters, summaries, Tasks visibility, and automated workflow transitions."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Statuses only -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ticket Statuses"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="2"
                           Text="Statuses control filters, summaries, Tasks visibility, field-complete behavior, submitted write-ups, published assignments, and unassignment transitions."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- Status actions -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button Content="Add Status"
                            Width="102"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddStatus_Click"/>

                    <Button x:Name="EditStatusButton"
                            Content="Edit"
                            Width="102"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="EditStatus_Click"
                            IsEnabled="False"/>

                    <Button x:Name="DeactivateStatusButton"
                            Content="Deactivate"
                            Width="102"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeactivateStatus_Click"
                            IsEnabled="False"/>

                    <Button x:Name="DeleteStatusButton"
                            Content="Delete"
                            Width="102"
                            Height="32"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DeleteStatus_Click"
                            IsEnabled="False"/>
                </StackPanel>

                <DataGrid Grid.Row="6"
                          x:Name="StatusesGrid"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionChanged="StatusesGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Width="*"
                                            Binding="{Binding Name}"/>

                        <DataGridCheckBoxColumn Header="Active"
                                                Width="80"
                                                Binding="{Binding IsActive}"/>

                        <DataGridCheckBoxColumn Header="Closed"
                                                Width="80"
                                                Binding="{Binding IsClosed}"/>

                        <DataGridCheckBoxColumn Header="Field Complete"
                                                Width="Auto"
                                                Binding="{Binding IsFieldComplete}"/>

                        <DataGridCheckBoxColumn Header="Filter"
                                                Width="80"
                                                Binding="{Binding ShowInFilter}"/>

                        <DataGridCheckBoxColumn Header="Summary"
                                                Width="Auto"
                                                Binding="{Binding IncludeInSummary}"/>

                        <DataGridCheckBoxColumn Header="Tasks Pane"
                                                Width="Auto"
                                                Binding="{Binding SendToDispatchTasks}"/>

                        <DataGridCheckBoxColumn Header="Write-Up Target"
                                                Width="130"
                                                Binding="{Binding IsWriteUpSubmitTarget}"/>

                        <DataGridCheckBoxColumn Header="Assignment Target"
                                                Width="Auto"
                                                Binding="{Binding IsAssignmentPublishTarget}"/>

                        <DataGridCheckBoxColumn Header="Unassignment Target"
                                                Width="*"
                                                Binding="{Binding IsUnassignmentTarget}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>