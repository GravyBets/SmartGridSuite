<UserControl x:Class="SmartGridSuite.Client.Views.Administration.Tickets.TicketsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Administration — Tickets"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Manage ticket statuses, filters, summaries, Tasks visibility, and workflow transitions."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Padding="10,4"
                            Margin="0,0,8,0"
                            Click="Refresh_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Statuses only -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ticket Statuses"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="2"
                           Text="Statuses control filters, summaries, Tasks visibility, field-complete behavior, submitted write-ups, published assignments, and unassignment transitions."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- Status actions -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button Content="Add Status"
                            Width="112"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddStatus_Click"/>

                    <Button x:Name="MoveStatusUpButton"
                            Content="Move Up"
                            Width="102"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="MoveStatusUp_Click"/>

                    <Button x:Name="MoveStatusDownButton"
                            Content="Move Down"
                            Width="112"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="MoveStatusDown_Click"/>

                    <Button x:Name="EditStatusButton"
                            Content="Edit"
                            Width="102"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="EditStatus_Click"/>

                    <Button x:Name="DeactivateStatusButton"
                            Content="Deactivate"
                            Width="112"
                            Height="32"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Click="DeactivateStatus_Click"/>

                    <Button x:Name="DeleteStatusButton"
                            Content="Delete"
                            Width="102"
                            Height="32"
                            Style="{StaticResource DangerButtonStyle}"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="DeleteStatus_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="6"
                          x:Name="StatusesGrid"
                          Style="{StaticResource ThemedDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionChanged="StatusesGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                        Width="70"
                        Binding="{Binding SortOrder}"/>

                        <DataGridTemplateColumn Header="Status"
                            Width="2.2*"
                            SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactive"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Lifecycle"
                            Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,4"
                           VerticalAlignment="Center">

                                        <Border Margin="0,0,6,4"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="{DynamicResource TileFillHover}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Closed"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>

                                        <Border Margin="0,0,6,4"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="{DynamicResource TileFillHover}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFieldComplete}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Field Complete"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Shows In"
                            Width="2.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,4"
                           VerticalAlignment="Center">

                                        <TextBlock Text="Filter"
                               Margin="0,0,10,4"
                               Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowInFilter}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Summary"
                               Margin="0,0,10,4"
                               Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IncludeInSummary}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="Tasks Pane"
                               Margin="0,0,10,4"
                               Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SendToDispatchTasks}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Workflow Targets"
                            Width="2.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,4"
                           VerticalAlignment="Center">

                                        <TextBlock Text="Write-Up Submit"
                               Margin="0,0,10,4"
                               Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWriteUpSubmitTarget}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>