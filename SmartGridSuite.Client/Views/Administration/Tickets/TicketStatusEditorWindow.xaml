<Window x:Class="SmartGridSuite.Client.Views.Administration.Tickets.TicketStatusEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket Status"
        Width="440"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Status Name"
                   FontWeight="SemiBold"/>
        <TextBox Grid.Row="2"
                 x:Name="NameTextBox"
                 Height="32"/>

        <TextBlock Grid.Row="4"
                   Text="Sort Order"
                   FontWeight="SemiBold"/>
        <TextBox Grid.Row="6"
                 x:Name="SortOrderTextBox"
                 Height="32"/>

        <CheckBox Grid.Row="8"
                  x:Name="IsActiveCheckBox"
                  Content="Active"
                  IsChecked="True"/>

        <CheckBox Grid.Row="10"
                  x:Name="IsClosedCheckBox"
                  Content="Closed status"/>

        <CheckBox Grid.Row="12"
                  x:Name="ShowInFilterCheckBox"
                  Content="Show in ticket filters"
                  IsChecked="True"/>

        <CheckBox Grid.Row="13"
                  x:Name="SendToDispatchTasksCheckBox"
                  Content="Send tickets in this status to Dispatch Tasks"
                  VerticalAlignment="Top"/>
        
        <TextBlock Grid.Row="13"
                   x:Name="SystemRequiredTextBlock"
                   Margin="0,28,0,0"
                   Text="System-required status. Name, Active, and Closed behavior are protected because SmartGridSuite depends on them."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   Visibility="Collapsed"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="14"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Save"
                    Width="90"
                    Height="32"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>