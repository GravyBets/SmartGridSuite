<Window x:Class="SmartGridSuite.Client.Views.Administration.Tickets.TicketStatusEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket Status"
        Width="560"
        Height="740"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="EditorSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="EditorHelpTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="EditorCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WorkflowHelpTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource EditorHelpTextStyle}">
            <Setter Property="Margin" Value="24,-6,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="14">
            <StackPanel>
                <TextBlock Text="Ticket Status"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Configure how this status appears and how it participates in ticket workflow."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Name -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Status Name"
                               Style="{StaticResource EditorLabelStyle}"/>

                    <TextBox x:Name="NameTextBox"
                             Height="32"
                             MaxLength="100"
                             VerticalContentAlignment="Center"
                             Padding="10,0"/>

                    <TextBlock Text="Status name is limited to 100 characters."
                               Style="{StaticResource EditorHelpTextStyle}"
                               Margin="2,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource SurfaceBorder}"/>

                <!-- Basic flags -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Status Behavior"
                               Style="{StaticResource EditorSectionTitleStyle}"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <Border Padding="8"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBg}">
                                <StackPanel>
                                    <CheckBox x:Name="IsActiveCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Active"
                                              IsChecked="True"/>

                                    <CheckBox x:Name="IsClosedCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Closed status"/>

                                    <CheckBox x:Name="IsFieldCompleteCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Field complete status"/>

                                    <CheckBox x:Name="ShowInFilterCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Show in ticket filters"
                                              IsChecked="True"/>

                                    <CheckBox x:Name="IncludeInSummaryCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Margin="0"
                                              Content="Include in ticket summary"
                                              IsChecked="True"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Workflow Behavior"
                                       Style="{StaticResource EditorSectionTitleStyle}"
                                       Margin="0,8,0,8"/>

                            <Border Padding="12"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource SurfaceBorder}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBg}">
                                <StackPanel>
                                    <CheckBox x:Name="SendToDispatchTasksCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Show tickets in this status on the Tasks pane"/>

                                    <CheckBox x:Name="IsWriteUpSubmitTargetCheckBox"
                                              Style="{StaticResource EditorCheckBoxStyle}"
                                              Content="Use this status after a tech submits a write-up"/>

                                    <TextBlock Text="Only one status can be the Write-Up Target. Selecting this option clears it from all other statuses."
                                               Style="{StaticResource WorkflowHelpTextStyle}"/>

                                    <TextBlock x:Name="SystemRequiredTextBlock"
                                               Margin="0,4,0,0"
                                               Text="System-required status. Name, Active, and Closed behavior are protected because SmartGridSuite depends on them."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="96"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    IsCancel="True"/>

            <Button Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="96"
                    Height="34"
                    Padding="16,0"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>