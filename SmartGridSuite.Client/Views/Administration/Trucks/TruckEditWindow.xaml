<Window x:Class="SmartGridSuite.Client.Views.Administration.TruckEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Truck"
        Width="460"
        Height="432"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Window.Resources>
        <Style x:Key="EditorSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="EditorHelpTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Truck Details"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="Add or edit truck information, style, and service status."
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Basic Information"
                           Style="{StaticResource EditorSectionTitleStyle}"/>

                <!-- Truck # -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Truck #"
                               Style="{StaticResource EditorLabelStyle}"
                               Margin="4,0,0,4"/>

                    <TextBox x:Name="TruckNumberTextBox"
                             Height="32"
                             MaxLength="20"
                             Padding="10,0"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="*Truck # is limited to 20 characters."
                               Style="{StaticResource EditorHelpTextStyle}"
                               Margin="4,5,0,0"/>
                </StackPanel>

                <!-- Style -->
                <StackPanel Grid.Row="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Style"
                                   Margin="4,0,0,0"
                                   Style="{StaticResource EditorLabelStyle}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="+ Add Style"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="28"
                                MinWidth="104"
                                Padding="12,0"
                                Margin="8,0,0,0"
                                Click="AddStyle_Click"/>
                    </Grid>

                    <ComboBox x:Name="TruckStyleComboBox"
                              Height="32"
                              Width="150"
                              HorizontalAlignment="Left"
                              SelectedValuePath="Id"
                              TextSearch.TextPath="Name">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- In Service -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="In Service"
                               Margin="4,4,4,4"
                               Style="{StaticResource EditorLabelStyle}"/>

                    <ComboBox x:Name="InServiceComboBox"
                              Height="32"
                              Width="150"
                              HorizontalAlignment="Left"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Yes"/>
                        <ComboBoxItem Content="No"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="96"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,4,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="96"
                    Height="34"
                    Padding="16,0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>