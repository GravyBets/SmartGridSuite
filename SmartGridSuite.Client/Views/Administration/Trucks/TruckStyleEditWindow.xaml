<Window x:Class="SmartGridSuite.Client.Views.Administration.TruckStyleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Truck Style"
        Width="420"
        Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="New Truck Style"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Style Name" Margin="0,0,0,4"/>
            <TextBox x:Name="StyleNameTextBox"
                     Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="100"
                    Height="34"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>