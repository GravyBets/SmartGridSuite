<UserControl x:Class="SmartGridSuite.Client.Views.Administration.TrucksAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Administration — Trucks"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Add/edit trucks, manage truck styles, and control service state."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Padding="10,4"
                            Width="90"
                            Margin="0,0,4,0"
                            Click="Refresh_Click"/>

                    <Button x:Name="EditSelectedButton"
                            Content="Edit"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Width="90"
                            Visibility="Collapsed"
                            Click="EditSelected_Click"/>

                    <Button x:Name="DeleteSelectedButton"
                            Content="Delete"
                            Style="{DynamicResource DangerButtonStyle}"
                            Margin="0,0,4,0"
                            FontWeight="Bold"
                            Width="90"
                            Visibility="Collapsed"
                            Click="DeleteSelected_Click"/>

                    <Button Content="Add Truck"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Width="90"
                            Padding="10,4"
                            Click="AddTruck_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DataGrid x:Name="TrucksGrid"
                      Style="{StaticResource ThemedDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      SelectionChanged="TrucksGrid_SelectionChanged">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource ThemedDataGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Truck number big, truck type small underneath -->
                    <DataGridTemplateColumn Header="Truck # / Type"
                                    Width="3.0*"
                                    SortMemberPath="TruckStyleName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding TruckNumber, StringFormat=Truck {0}}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding TruckStyleName}"
                                       Margin="0,2,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="In Service"
                                Width="1.1*"
                                SortMemberPath="IsActive">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Text" Value="No"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Text" Value="Yes"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{DynamicResource TextSecondary}"
                       Text=""/>
        </Border>
    </Grid>
</UserControl>