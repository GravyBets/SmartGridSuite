<Window x:Class="SmartGridSuite.Client.Views.Administration.TechnicianEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Technician"
        Width="760"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Technician Details"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <GroupBox Header="Basic Information" Margin="0,0,0,12">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="First Name"
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="FirstNameTextBox" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Last Name" 
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="LastNameTextBox" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Employee ID" 
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="EmployeeIdTextBox" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Home Truck" 
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="HomeTruckComboBox"
                                      Height="30"
                                      Width="330"
                                      HorizontalAlignment="Left"
                                      SelectedValuePath="Id"
                                      TextSearch.TextPath="DisplayText">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4" 
                                    Grid.Column="0">
                            <TextBlock Text="Title"
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="TitleComboBox"
                                      Width="160"
                                      Height="30"
                                      HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" 
                                    Grid.Column="2">
                            <TextBlock Text="Active Employee"
                                       Style="{DynamicResource FormLabelStyle}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="ActiveEmployeeComboBox"
                                      Width="160"
                                      Height="30"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Yes"/>
                                <ComboBoxItem Content="No"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Typical Weekly Schedule" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0"
                  x:Name="WorksMondayCheckBox"
                  Content="Monday"
                  IsChecked="True"/>

                        <CheckBox Grid.Row="0" Grid.Column="1"
                  x:Name="WorksTuesdayCheckBox"
                  Content="Tuesday"
                  IsChecked="True"/>

                        <CheckBox Grid.Row="0" Grid.Column="2"
                  x:Name="WorksWednesdayCheckBox"
                  Content="Wednesday"
                  IsChecked="True"/>

                        <CheckBox Grid.Row="0" Grid.Column="3"
                  x:Name="WorksThursdayCheckBox"
                  Content="Thursday"
                  IsChecked="True"/>

                        <CheckBox Grid.Row="2" Grid.Column="0"
                  x:Name="WorksFridayCheckBox"
                  Content="Friday"
                  IsChecked="True"/>

                        <CheckBox Grid.Row="2" Grid.Column="1"
                  x:Name="WorksSaturdayCheckBox"
                  Content="Saturday"/>

                        <CheckBox Grid.Row="2" Grid.Column="2"
                  x:Name="WorksSundayCheckBox"
                  Content="Sunday"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Roles">
                    <UniformGrid Columns="3" Margin="10">
                        <CheckBox x:Name="RoleTechnicianCheckBox" Content="Technician" Margin="0,4"/>
                        <CheckBox x:Name="RoleDispatchCheckBox" Content="Dispatch" Margin="0,4"/>
                        <CheckBox x:Name="RoleAdminCheckBox" Content="Admin" Margin="0,4"/>
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Width="100"
                    Height="34"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>