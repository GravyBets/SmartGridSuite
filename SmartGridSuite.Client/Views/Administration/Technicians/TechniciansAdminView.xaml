<UserControl x:Class="SmartGridSuite.Client.Views.Administration.TechniciansAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Administration — Technicians"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Add / edit technicians and manage title, email, schedule, roles, and home truck."
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Click="Refresh_Click"/>

                    <Button x:Name="EditSelectedButton"
                            Content="Edit Selected"
                            Padding="10,4"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="EditSelected_Click"/>

                    <Button x:Name="DeleteSelectedButton"
                            Content="Delete Selected"
                            Style="{DynamicResource DangerButtonStyle}"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="DeleteSelected_Click"/>

                    <Button Content="Add Tech"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Width="96"
                            Padding="10,4"
                            Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DataGrid x:Name="AdminTechGrid"
                      Style="{StaticResource ThemedDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      SelectionChanged="AdminTechGrid_SelectionChanged">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource ThemedDataGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Name + Title stacked like PartsPortal -->
                    <DataGridTemplateColumn Header="Name/Title"
                                            Width="0.5*"
                                            SortMemberPath="FirstName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding FullName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Title}"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Employee ID"
                                Binding="{Binding EmployeeId}"
                                Width="0.5*"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding EmailAddress}"
                                        Width="0.8*"/>

                    <DataGridTextColumn Header="Roles"
                                Binding="{Binding RolesSummary}"
                                Width="0.5*"/>

                    <DataGridTextColumn Header="Schedule"
                                Binding="{Binding ScheduleSummary}"
                                Width="0.6*"/>

                    <DataGridTextColumn Header="Home Truck"
                                Binding="{Binding HomeTruckSummary}"
                                Width="0.2*"/>

                    <DataGridTextColumn Header="Active Employee?"
                                Binding="{Binding ActiveEmployeeText}"
                                Width="0.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource TextSecondary}"
                       Text=""/>
        </Border>
    </Grid>
</UserControl>