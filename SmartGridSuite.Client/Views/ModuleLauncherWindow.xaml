<Window x:Class="SmartGridSuite.Client.Views.ModuleLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Grid Suite"
        Height="560"
        Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">
    
    
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title/Sub -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Smart Grid Suite"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Choose how you want to use Smart Grid Suite."
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- Theme slider toggle -->
                <ToggleButton Grid.Column="1"
                              x:Name="ThemeToggle"
                              Style="{StaticResource ThemeSliderToggleStyle}"
                              VerticalAlignment="Top"
                              Margin="12,9,0,0"
                              ToolTip="Toggle Light / Dark mode"
                              Checked="ThemeToggle_Checked"
                              Unchecked="ThemeToggle_Unchecked"/>
            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Section headers -->
                <TextBlock Grid.Column="0"
                           Text="Primary"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="2,0,0,10"/>

                <TextBlock Grid.Column="1"
                           Text="Other Modules"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="2,0,0,10"/>

                <!-- Tiles grid -->
                <Grid Grid.ColumnSpan="2" Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Primary: Field Technician (spans all 3 rows) -->
                    <Button Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Style="{StaticResource PrimaryTileButton}"
                            Click="Tech_Click"
                            Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="Field Technician"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Site Dashboard • Diagnostics • History"
                                       FontSize="14"
                                       Foreground="#DCE7FF"
                                       Margin="0,8,0,0"/>
                            
                        </StackPanel>
                    </Button>

                    <!-- Dispatcher -->
                    <Button x:Name="DispatchTile"
                            Grid.Column="1"
                            Grid.Row="0"
                            Style="{StaticResource TileButton}"
                            Click="Dispatch_Click"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Dispatcher"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tickets • Tasks • Routing"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- RMA Testing -->
                    <Button Grid.Column="1"
                            Grid.Row="1"
                            Style="{StaticResource TileButton}"
                            Margin="0,0,0,10"
                            Click="Rma_Click">
                        <StackPanel>
                            <TextBlock Text="RMA Testing"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Testing Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Administration -->
                    <Button x:Name="AdminTile"
                            Grid.Column="1"
                            Grid.Row="2"
                            Style="{StaticResource TileButton}"
                            Click="Admin_Click"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Administration"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Users • Settings • Configuration"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    
                </Grid>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Style="{StaticResource FooterButton}"
                    Content="About App"
                    Click="About_Click"
                    Margin="0,0,18,0"/>
            <Button Style="{StaticResource FooterButton}"
                    Content="Bug / Feature Request"
                    Click="BugFeature_Click"/>
        </StackPanel>
    </Grid>
</Window>