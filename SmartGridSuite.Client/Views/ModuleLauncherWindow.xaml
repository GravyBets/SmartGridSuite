<Window x:Class="SmartGridSuite.Client.Views.ModuleLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Grid Suite"
        Height="580"
        Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Branding/SmartGridSuite_Logo.png"
                           Width="68"
                           Height="68"
                           Stretch="Uniform"
                           Margin="0,0,8,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Smart Grid Suite"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <TextBlock Text="Choose how you want to use Smart Grid Suite."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Theme picker -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Top"
                            Margin="12,3,0,0">

                    <TextBlock Text="Theme"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="2,0,0,4"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="190"
                              Height="34"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="ThemeComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Non-modal connectivity status -->
        <Border x:Name="ConnectivityBanner"
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="12,8"
                CornerRadius="10"
                BorderBrush="#D69E00"
                BorderThickness="1"
                Background="#22D69E00"
                Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="9"
                         Height="9"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Fill="#D69E00"/>

                <TextBlock x:Name="ConnectivityMessageText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Button x:Name="ConnectivityRetryButton"
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        Height="30"
                        Padding="14,0"
                        Content="Retry"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RetryConnectivity_Click"/>
            </Grid>
        </Border>

        <!-- Module selection body -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,8,0,10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card label -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Workspaces"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Text="Open the module you need for today’s work."
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <!-- Centered vertical module stack -->
                <Grid Grid.Row="2"
                      Width="560"
                      HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="88"/>
                    </Grid.RowDefinitions>

                    <!-- Field Technician -->
                    <Button x:Name="TechTile"
                            Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Style="{StaticResource PrimaryTileButton}"
                            Click="Tech_Click">

                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Field Technician"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                                <TextBlock Text="Site Dashboard • My Tasks • History"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#DCE7FF"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Dispatcher -->
                    <Button x:Name="DispatchTile"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TileButton}"
                            Click="Dispatch_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dispatcher"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Tickets • Tasks • Daily Assignments"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Administration -->
                    <Button x:Name="AdminTile"
                            Grid.Row="4"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource TileButton}"
                            Click="Admin_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Administration"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Techs • Trucks • SNMP • Settings"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Style="{StaticResource FooterButton}"
                        Content="About App"
                        Click="About_Click"
                        Margin="0,0,18,0"/>

                <Button Style="{StaticResource FooterButton}"
                        Content="Bug / Feature Request"
                        Click="BugFeature_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>