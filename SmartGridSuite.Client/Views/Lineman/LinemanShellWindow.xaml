<Fluent:RibbonWindow x:Class="SmartGridSuite.Client.Views.Lineman.LinemanShellWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:Fluent="urn:fluent-ribbon"
                     Title="Smart Grid Suite - Lineman"
                     WindowState="Maximized"
                     WindowStartupLocation="CenterScreen"                     
                     Icon="/Assets/Branding/SmartGridSuite_Icon.ico"
                     Background="{DynamicResource AppBackground}">

    <Grid x:Name="ShellRoot"
      Margin="10,0,10,22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent connection warning shown without interrupting field work. -->
        <Border x:Name="ConnectivityBanner"
            Grid.Row="0"
            Margin="0,8,0,8"
            Padding="12,8"
            CornerRadius="10"
            BorderBrush="#D69E00"
            BorderThickness="1"
            Background="#22D69E00"
            Visibility="Collapsed">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                     Width="9"
                     Height="9"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Fill="#D69E00"/>

                <TextBlock x:Name="ConnectivityMessageText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

                <Button x:Name="ConnectivityRetryButton"
                    Grid.Column="2"
                    Margin="14,0,0,0"
                    Height="30"
                    Padding="14,0"
                    Content="Retry"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RetryConnectivity_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border x:Name="NavShellBorder"
                    Grid.Column="0"
                    Style="{StaticResource ShellNavCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nav header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="NavHeaderTextPanel">
                            <TextBlock Text="Lineman"
                                       Style="{StaticResource NavRailHeaderTitleTextStyle}"/>

                            <TextBlock Text="Workspace"
                                       Style="{StaticResource NavRailHeaderSubtitleTextStyle}"/>
                        </StackPanel>

                        <Button x:Name="NavHeaderBtn"
                                Grid.Column="1"
                                Style="{StaticResource NavRailToggleButtonStyle}"
                                ToolTip="Collapse / Expand"
                                Click="ToggleNav_Click">
                            <Viewbox Width="12"
                                     Height="12"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path x:Name="NavHeaderArrowPath"
                                      Data="M 4 2 L 8 6 L 4 10"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="NavSectionLabel"
                               Grid.Row="1"
                               Text="Navigation Panes"
                               Style="{StaticResource NavRailSectionTextStyle}"
                               Margin="4,0,0,8"/>

                    <!-- Expanded nav -->
                    <ListBox x:Name="NavListExpanded"
                             Grid.Row="2"
                             Style="{StaticResource NavRailListStyle}"
                             ItemContainerStyle="{StaticResource NavRailItemStyle}"
                             SelectionChanged="NavList_SelectionChanged">

                        <ListBoxItem Tag="Site Lookup">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <Path Style="{StaticResource NavRailPathIconStyle}"
                                          Data="M3 5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V5ZM5 5V10H11V5H5ZM13 5V10H19V5H13ZM5 12V19H11V12H5ZM13 12V19H19V12H13Z"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Site Lookup"
                                               Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                    <TextBlock Text="Site information and write-ups"
                                               Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="Tasks">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <Path Style="{StaticResource NavRailPathIconStyle}"
                                          Data="M9 6H20V8H9V6ZM9 11H20V13H9V11ZM9 16H20V18H9V16ZM4.8 8.2L2.8 6.2L4.2 4.8L4.8 5.4L6.8 3.4L8.2 4.8L4.8 8.2ZM4.8 13.2L2.8 11.2L4.2 9.8L4.8 10.4L6.8 8.4L8.2 9.8L4.8 13.2ZM4.8 18.2L2.8 16.2L4.2 14.8L4.8 15.4L6.8 13.4L8.2 14.8L4.8 18.2Z"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Tasks"
                                               Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                    <TextBlock Text="Assigned work"
                                               Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="History">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <Path Style="{StaticResource NavRailPathIconStyle}"
                                          Data="M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2ZM12 20C7.58 20 4 16.42 4 12S7.58 4 12 4 20 7.58 20 12 16.42 20 12 20ZM13 7H11V13L16 16L17 14.3L13 12V7Z"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="History"
                                               Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                    <TextBlock Text="Closed work from the last 30 days"
                                               Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Collapsed nav -->
                    <ListBox x:Name="NavListCollapsed"
                             Grid.Row="2"
                             Style="{StaticResource NavRailListStyle}"
                             ItemContainerStyle="{StaticResource NavRailCollapsedItemStyle}"
                             SelectionChanged="NavList_SelectionChanged"
                             Visibility="Collapsed">

                        <ListBoxItem Tag="Site Lookup" ToolTip="Site Lookup">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M3 5C3 3.9 3.9 3 5 3H19C20.1 3 21 3.9 21 5V19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V5ZM5 5V10H11V5H5ZM13 5V10H19V5H13ZM5 12V19H11V12H5ZM13 12V19H19V12H13Z"/>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="Tasks" ToolTip="Tasks">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M9 6H20V8H9V6ZM9 11H20V13H9V11ZM9 16H20V18H9V16ZM4.8 8.2L2.8 6.2L4.2 4.8L4.8 5.4L6.8 3.4L8.2 4.8L4.8 8.2ZM4.8 13.2L2.8 11.2L4.2 9.8L4.8 10.4L6.8 8.4L8.2 9.8L4.8 13.2ZM4.8 18.2L2.8 16.2L4.2 14.8L4.8 15.4L6.8 13.4L8.2 14.8L4.8 18.2Z"/>
                            </Border>
                        </ListBoxItem>

                        <ListBoxItem Tag="History" ToolTip="History">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2ZM12 20C7.58 20 4 16.42 4 12S7.58 4 12 4 20 7.58 20 12 16.42 20 12 20ZM13 7H11V13L16 16L17 14.3L13 12V7Z"/>
                            </Border>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Home button -->
                    <StackPanel Grid.Row="3"
                                Margin="0,12,0,0">
                        <Border Height="1"
                                Margin="4,0,4,12"
                                Background="{DynamicResource CardBorder}"/>

                        <Button x:Name="HomeButtonExpanded"
                                Style="{StaticResource NavRailFooterButtonStyle}"
                                Click="HomeButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <Path Style="{StaticResource NavRailPathIconStyle}"
                                          Data="M12 3L3 10.2V21H9V15H15V21H21V10.2L12 3ZM19 19H17V13H7V19H5V11.2L12 5.6L19 11.2V19Z"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Home"
                                               Style="{StaticResource NavRailItemTitleTextStyle}"/>
                                    <TextBlock Text="Back to start screen"
                                               Style="{StaticResource NavRailItemSubtitleTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="HomeButtonCollapsed"
                                Style="{StaticResource NavRailCollapsedFooterButtonStyle}"
                                Click="HomeButton_Click"
                                ToolTip="Home"
                                Visibility="Collapsed">
                            <Border Style="{StaticResource NavBadgeStyle}">
                                <Path Style="{StaticResource NavRailPathIconStyle}"
                                      Data="M12 3L3 10.2V21H9V15H15V21H21V10.2L12 3ZM19 19H17V13H7V19H5V11.2L12 5.6L19 11.2V19Z"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            

            <ContentControl x:Name="MainPaneHost"
                            Grid.Column="2"/>
        </Grid>
    </Grid>
</Fluent:RibbonWindow>