<UserControl x:Class="SmartGridSuite.Client.Views.Administration.WriteUpWorkflow.WriteUpWorkflowAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="16">

            <TextBlock Text="Write-Up Workflow"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Margin="0,4,0,16"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Text="Configure technician flags, Refer To destinations, and the Dispatch closeout checklist."/>

            <Border Style="{StaticResource Card}"
                    Padding="18">

                <StackPanel>
                    <TextBlock Text="Write-Up Workflow Configuration"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Technician Write-Up Flags, Refer To Options, and Dispatch Closeout Checklist settings will be moved into this pane."/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>