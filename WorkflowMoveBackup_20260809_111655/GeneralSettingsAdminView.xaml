                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Checklist Item"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewDispatchCloseoutChecklistNameTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             MaxLength="150"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Tag="Checklist Item"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sort"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <TextBox x:Name="NewDispatchCloseoutChecklistSortOrderTextBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="32"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="100"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Condition"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <ComboBox x:Name="DispatchCloseoutConditionTypeComboBox"
                                              Height="32"
                                              SelectionChanged="DispatchCloseoutConditionTypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Triggering Write-Up Flag"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,3"/>

                                    <ComboBox x:Name="DispatchCloseoutWriteUpFlagComboBox"
                                              Height="32"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              IsEnabled="False"/>
                                </StackPanel>

                                <CheckBox x:Name="NewDispatchCloseoutChecklistActiveCheckBox"
                                          Grid.Column="8"
                                          Content="Active"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <CheckBox x:Name="NewDispatchCloseoutChecklistRequiredCheckBox"
                                          Grid.Column="10"
                                          Content="Required"
                                          IsChecked="True"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,7"
                                          Foreground="{DynamicResource TextPrimary}"/>

                                <Button x:Name="AddDispatchCloseoutChecklistButton"
                                        Grid.Column="12"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Add"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="AddDispatchCloseoutChecklistButton_Click"/>

                                <Button x:Name="CancelAddDispatchCloseoutChecklistButton"
                                        Grid.Column="14"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Cancel"
                                        MinWidth="80"
                                        Height="32"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        Click="CancelAddDispatchCloseoutChecklistButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Existing Definitions -->
                    <Border Grid.Row="4"
                            Style="{StaticResource Card}"
                            Padding="8"
                            ClipToBounds="False">
                        <DataGrid x:Name="DispatchCloseoutChecklistDataGrid"
                                  Height="260"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBackground}"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="DispatchCloseoutChecklistDataGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource TabBgHover}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="Height"
                                            Value="32"/>
                                    <Setter Property="Padding"
                                            Value="12,0"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource DataGridHeaderBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>

                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="MinHeight"
                                            Value="34"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillHover}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource TileFillPressed}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource SurfaceBorder}"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                    <Setter Property="Padding"
                                            Value="12,6"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="FocusVisualStyle"
                                            Value="{x:Null}"/>
                                    <Setter Property="IsTabStop"
                                            Value="False"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextPrimary}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style x:Key="DispatchCloseoutGridTextStyle"
                                       TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontSize"
                                            Value="13"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="TextTrimming"
                                            Value="CharacterEllipsis"/>
                                    <Setter Property="TextWrapping"
                                            Value="NoWrap"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Width="55"
                                                    Binding="{Binding Id}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Checklist Item"
                                                    Width="*"
                                                    Binding="{Binding DisplayName}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Condition"
                                                    Width="130"
                                                    Binding="{Binding ConditionType}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Trigger Flag"
                                                    Width="180"
                                                    Binding="{Binding WriteUpFlagName}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTextColumn Header="Sort"
                                                    Width="65"
                                                    Binding="{Binding SortOrder}"
                                                    ElementStyle="{StaticResource DispatchCloseoutGridTextStyle}"/>

                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Required"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsRequired}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="Active"
                                                   HorizontalAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               x:Name="DispatchCloseoutChecklistStatusTextBlock"
                               Text="Ready."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>